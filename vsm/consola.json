==='Diferente').length;\n $('kVal').innerHTML=`${okN}<small>/ ${PROCS.length}</small>`;$('dVal').textContent=difN?`${difN} diferentes`:'Recorrido de embarque hacia atrás';\n}\n\nlet rparts=[];function setupParts(){rparts=[];svg.querySelectorAll('path.rw,path.ext').forEach(el=>{let L=0;try{L=el.getTotalLength();}catch(e){}const ex=el.classList.contains('ext'),n=Math.max(2,Math.round(L/(ex?80:45)));const g=svg.querySelector(ex?'#xparts':'#rparts');for(let k=0;k<n;k++){const c=document.createElementNS(NS,'circle');c.setAttribute('r',ex?'2.6':'2.8');c.setAttribute('fill',ex?el.dataset.c:C.crit);g&&g.appendChild(c);rparts.push({el:c,p:el,s:L*k/n,L});}});parts=[];edgeEls.forEach((el,i)=>{let L=0;try{L=el.getTotalLength();}catch(e){}const n=Math.max(2,Math.round(L/90));for(let k=0;k<n;k++)parts.push({e:i,s:L*k/n,L});});\n const g=svg.querySelector('#parts');g.innerHTML='';parts.forEach(p=>{const c=document.createElementNS(NS,'circle');c.setAttribute('r','2.6');c.setAttribute('fill',S.color);g.appendChild(c);p.el=c;});drawParts();}\nfunction speed(i){const a=EDGES[i][0];if(a==='mp'){const m=+PAR.mp;return 70/(1+(m>0?m:1)*1.2);}const dd=daysAfter(BY[a]);return 70/(1+(dd===null?.8:dd)*1.2);}\nfunction drawParts(){rparts.forEach(r=>{if(!r.L)return;const pt=r.p.getPointAtLength(r.s);r.el.setAttribute('cx',pt.x.toFixed(1));r.el.setAttribute('cy',pt.y.toFixed(1));});parts.forEach(p=>{if(!p.L)return;const pt=edgeEls[p.e].getPointAtLength(p.s);p.el.setAttribute('cx',pt.x.toFixed(1));p.el.setAttribute('cy',pt.y.toFixed(1));});}\nlet lastT=0;function frame(t){const dt=Math.min(.05,lastT?(t-lastT)/1000:0);lastT=t;\n if(playing&&parts.length&&tab==='mapa'){rparts.forEach(r=>{if(r.L)r.s=(r.s+38*dt)%r.L;});parts.forEach(p=>{if(p.L)p.s=(p.s+speed(p.e)*dt)%p.L;});drawParts();}requestAnimationFrame(frame);}\n\nconst tip=$('tip');\nsvg.addEventListener('mousemove',e=>{const t=e.target.closest('[data-tip]');if(!t){tip.hidden=true;return;}tip.textContent=t.getAttribute('data-tip');tip.hidden=f