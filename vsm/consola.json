)return `<tspan fill=\"${C.dim}\">—</tspan>`;let t=typeof x.v==='number'?fmt(x.v,f==='def'?1:0):String(x.v);if(t.length>13){t=t.split(' · ')[0];if(t.length>13)t=t.slice(0,12)+'…';else t+=' …';}return `<tspan fill=\"${x.s==='g'?C.fg:C.draft}\">${esc(t)}${unit}</tspan>`;}\n\nfunction render(){\n const T=takt(),rt=ROUTES[route].p,routeSet=new Set(rt),RIV=vs==='rivian';COLX=RIV?COLX_R:COLX_T;DX=RIV?460:0;W=2240+DX;svg.setAttribute('viewBox',`0 0 ${W} 1250`);\n const inRoute=(a,b)=>{const i=rt.indexOf(a),j=rt.indexOf(b);return (a==='mp'&&ROUTES[route].mp&&j===0)||(i>=0&&j===i+1);};\n let s=`<defs>\n <marker id=\"aI\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0 0 L10 5 L0 10z\" fill=\"${C.info}\"/></marker>\n <marker id=\"aM\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0 0 L10 5 L0 10z\" fill=\"${C.mat}\"/></marker>\n <marker id=\"aP1\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0 0 L10 5 L0 10z\" fill=\"#2dd4bf\"/></marker>\n <marker id=\"aP7\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0 0 L10 5 L0 10z\" fill=\"#fb923c\"/></marker>\n <marker id=\"aR\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0 0 L10 5 L0 10z\" fill=\"${C.crit}\"/></marker>\n <image id=\"dmLogo\" href=\"${LOGO}\" width=\"28\" height=\"24\" preserveAspectRatio=\"xMidYMid meet\"/><linearGradient id=\"boxg\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"${C.boxTop}\"/><stop offset=\"1\" stop-color=\"${C.panel}\"/></linearGradient>\n <filter id=\"glow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\"><feGaussianBlur stdDeviation=\"4\" result=\"b\"/><feMerge><feMergeNode in=\"b\"/><feMergeNod