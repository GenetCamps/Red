='';\n if(!rows.length){g.innerHTML='<p class=\"empty\" style=\"grid-column:1/-1\">Sin fotos en esta vista.</p>';return;}\n rows.forEach(f=>{const fig=document.createElement('figure');const b=document.createElement('button');b.className='ph';b.setAttribute('aria-label','Ver foto: '+(f.cap||''));\n  const im=document.createElement('img');im.loading='lazy';im.alt=f.cap||'Foto de piso';im.src='vsm/fotos/'+f.asset+'.jpg';im.onerror=()=>{b.textContent='Foto no disponible';b.style.cssText+=';display:grid;place-items:center;color:var(--dim);font-size:12px';};\n  b.appendChild(im);b.onclick=()=>{$('lbImg').src='vsm/fotos/'+f.asset+'.jpg';$('lbImg').alt=f.cap||'';$('lbCap').textContent=f.cap||'';$('lb').hidden=false;$('lbX').focus();};\n  const fc=document.createElement('figcaption');const ch=document.createElement('div');ch.className='meta';\n  const c1=document.createElement('span');c1.className='chip';c1.textContent=f.cat||'Otro';ch.appendChild(c1);\n  if(f.p&&BY[f.p]){const c2=document.createElement('span');c2.textContent=BY[f.p].n[0];ch.appendChild(c2);}\n  const c3=document.createElement('span');c3.textContent=(f.fecha||(f.at?new Date(f.at).toLocaleDateString('es-MX',{day:'2-digit',month:'short'}):''))+' · '+whoLabel(f.by);ch.appendChild(c3);\n  const t=document.createElement('div');t.textContent=f.cap||'';fc.appendChild(ch);fc.appendChild(t);fig.appendChild(b);fig.appendChild(fc);g.appendChild(fig);});}\n$('fChips').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.c==='__p'){fProcFilter=null;}else{fFilter=b.dataset.c;fProcFilter=null;}renderFotos();});\n$('lbX').onclick=()=>{$('lb').hidden=true;};$('lb').onclick=e=>{if(e.target.id==='lb')$('lb').hidden=true;};\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape'){if(!$('lb').hidden)$('lb').hidden=true;else if(drId)closeDrawer();}});\nfunction shrink(file){return new Promise(res=>{if(!/^image\\/(jpeg|png|webp)$/.test(file.type)){res(file);return;}const u=URL.createObjectURL(file),im=new Image();\n im.onload=()=>{const k=Math.min(1,1920/Math.max(im.width,im.height));if(k>=1&&file.size<2.5e6){URL.revokeObjectURL(u);res(file);return;}const c=document.createElement('canvas');c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext('2d').drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);c.toBlob(b=>res(b||file),'image/jpeg',.85);};\n im.onerror=()=>{URL.revokeObjectURL(u);res(file);};im.src=u;});}\n$('bFoto').onclick=async()=>{const files=[...$('fFile').files];if(!files.length){toast('Elige una foto primero');return;}if(!assets||!live){toast('Subir fotos necesita la página en vivo con permiso de edición.');return;}\n const btn=$('bFoto');btn.disabled=true;let ok=0;\n for(const f of files){$('fNote').textContent=`Subiendo ${ok+1} de ${files.length}…`;\n  try{const b=await shrink(f);const t=b.type&&/^image\\//.test(b.type)?b.type:'image/jpeg';const r=await assets.upload(b,{type:t});\n   await db.collection('fotos').add({vs,asset:r.id,cat:$('fCat').value,p:$('fProc').value||null,cap:$('fCap').value.trim().slice(0,400),by:me||'',at:Date.now()});ok++;}\n  catch(e){const c=e&&e.code;toast(c==='too_large'?'La foto es muy pesada.':c==='unsupported_type'?'Formato no soportado: usa JPG o PNG.':c==='quota_or_state'?'Se llenó el espacio de fotos.':'No se pudo subir una foto.');}}\n btn.disabled=false;$('fNote').textContent=ok?`${ok} foto(s) subida(s).`:'';$('fFile').value='';$('fCap').value='';};\nfunction setTab(t){tab=t;if(t==='ct'&&S)renderCT();if(t==='cue'&&S)renderCU();document.querySelectorAll('.tabs button').forEach(b=>b.setAttribute('aria-selected',String(b.dataset.tab===t)));\n document.querySelectorAll('[data-panel]').forEach(p=>{p.hidden=p.dataset.panel!==t;});}\ndocument.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>setTab(b.dataset.tab)));\n[['lyInfo','info','#gInfo'],['lyMov','mov','#gMov'],['lyKb','kb','#gKb'],['lyQ','q','#gQ'],['lyT','t','#gT']].forEach(([id,k,s])=>{$(id).addE