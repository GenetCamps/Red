h(e){}\n try{parent.postMessage({src:'emb',type:'theme',v:theme},'*');}catch(e){}\n if(rer)setStream(vs);}\n$('bTheme').onclick=()=>applyTheme(theme==='dark'?'light':'dark',true);\napplyTheme(theme,false);\n\n/* ===================== F2 · edición de cajas ===================== */\nconst ORIG={},EDITS={},EKEY='vsm-p4-edits-v1';\nObject.keys(STREAMS).forEach(k=>{ORIG[k]={procs:JSON.parse(JSON.stringify(STREAMS[k].procs)),edges:JSON.parse(JSON.stringify(STREAMS[k].edges))};EDITS[k]={procs:{},add:[],edges:[]};});\nconst edNorm=e=>({procs:(e&&e.procs)||{},add:(e&&e.add)||[],edges:(e&&e.edges)||[]});\nfunction applyEdits(k){const st=STREAMS[k],e=EDITS[k],ps=JSON.parse(JSON.stringify(ORIG[k].procs));\n e.add.forEach(a=>{if(ps.some(p=>p.id===a.id))return;const from=ps.find(p=>p.id===a.from);\n  ps.push({id:a.id,n:[a.n1||'Caja nueva',a.n2||''],pl:a.pl||'',k:(from&&from.k!=='ship'&&from.k!=='start')?from.k:'asy',c:+a.c||0,r:+a.r||0,after:'inv',d:{},res:'',user:true});});\n ps.forEach(p=>{const o=e.procs[p.id];if(!o)return;p.n=[o.n1!==undefined?o.n1:p.n[0],o.n2!==undefined?o.n2:(p.n[1]||'')];\n  ['pl','res','flag'].forEach(f=>{if(o[f]!==undefined)p[f]=o[f];});if(o.c!==undefined)p.c=+o.c;if(o.r!==undefined)p.r=+o.r;p.edited=true;});\n const has=id=>id==='mp'||ps.some(p=>p.id===id);\n st.procs=ps;st.edges=ORIG[k].edges.concat(e.edges.filter(x=>has(x[0])&&has(x[1])));}\nasync function saveEdits(k){applyEdits(k);\n if(live&&db){try{await db.doc('cfg/edit_'+k).set(JSON.parse(JSON.stringify(EDITS[k])));}catch(e){toast(e&&e.code==='solo-lectura'?'Tu usuario es de solo lectura.':'No se pudo guardar el cambio.');return false;}}\n else{try{localStorage.setItem(EKEY,JSON.stringify(EDITS));}catch(e){}}\n const keep=drId;setStream(vs);if(keep&&BY[keep]){drId=keep;renderDrawer();edFill(keep);}else closeDrawer();return true;}\nfunction loadEditsLocal(){try{const s=JSON.parse(localStorage.getItem(EKEY)||'null');if(s)Object.keys(STREAMS).forEach(k=>{EDITS[k]=edNorm(s[k]);applyEdits(k);});}catc