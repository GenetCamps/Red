rocs[drId];if(await saveEdits(vs))toast('Caja restaurada a su versión original');};\n$('edDel').onclick=async()=>{const id=drId;if(!id)return;EDITS[vs].add=EDITS[vs].add.filter(a=>a.id!==id);EDITS[vs].edges=EDITS[vs].edges.filter(x=>x[0]!==id&&x[1]!==id);delete EDITS[vs].procs[id];closeDrawer();if(await saveEdits(vs))toast('Caja eliminada');};\n$('adAdd').onclick=async()=>{const n1=$('adN1').value.trim();if(!n1){toast('Escribe el nombre de la caja nueva.');return;}\n const id='u'+Date.now().toString(36),from=$('adFrom').value,to=$('adTo').value;\n EDITS[vs].add.push({id,n1,n2:$('adN2').value.trim(),pl:$('adPl').value.trim(),c:+$('adC').value,r:+$('adR').value,from});\n if(from)EDITS[vs].edges.push([from,id]);if(to&&to!==from)EDITS[vs].edges.push([id,to]);\n drId=id;if(await saveEdits(vs))toast('Caja agregada al mapa');};\nlet v0='rivian';try{const x=localStorage.getItem('vsm-p4-vs');if(x&&STREAMS[x])v0=x;}catch(e){}\nsyncPlay();setTab('mapa');setStream(v0);requestAnimationFrame(frame);\n(async()=>{\n try{if(window.claude&&window.claude.use){const r=await Promise.all([window.claude.use('db'),window.claude.use('user')]);db=r[0];user=r[1];}}catch(e){db=null;}\n if(!db){loadLocal();loadEditsLocal();setLive(false);setStream(vs);return;}\n try{me=user?await user.id():null;}catch(e){me=null;}\n setLive(true);\n const fail=e=>{if(e&&(e.code==='revoked'||e.code==='not_granted'||e.code==='capability_disabled'))setLive(false);};\n Object.keys(STREAMS).forEach(k=>{const st=STREAMS[k];\n  db.collection(st.col).onSnapshot(sn=>{const n={};sn.docs.forEach(d=>{if(d.exists)n[d.id]=d.data();});CAPS[k]=n;if(k===vs){CAP=n;render();renderMeta();}},fail);\n  db.doc('cfg/'+st.par).onSnapshot(sn=>{PARS[k]=sn.exists?Object.assign({},sn.data()):{};if(k===vs){PAR=PARS[k];const a=document.activeElement;if(!a||!String(a.id).startsWith('p-'))fillParams();render();}},fail);});\n Object.keys(STREAMS).forEach(k=>db.doc('cfg/edit_'+k).onSnapshot(sn=>{EDITS[k]=edNorm(sn.exists?sn.data():null);applyEdits(k);if(k===vs){const keep=drId;setStream(vs);if(keep&&BY[keep]){drId=keep;renderDrawer();}}},fail));\n db.collection('tableros').onSnapshot(sn=>{TABS=sn.docs.map(d=>Object.assign({id:d.id},d.data()));renderTabs();},fail);\n db.collection('notas').orderBy('at','desc').limit(500).onSnapshot(sn=>{NOTES=sn.docs.map(d=>Object.assign({id:d.id},d.data()));renderNotes();},fail);\n db.collection('fotos').onSnapshot(sn=>{FOTOS=sn.docs.map(d=>Object.assign({id:d.id},d.data()));renderFotos();if(drId)renderDrawer();},fail);\n try{assets=await window.claude.use('assets');}catch(e){assets=null;}$('fotoUp').hidden=!assets;$('fNoUp').hidden=!!assets;\n})();\n})();\n</script>\n\n</body></html>"