"<!doctype html><html><head><meta charset=utf8><meta name=viewport content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>\n<title>VSM Planta 4</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap\">\n<style>\n/* Layout: consola de operaciones — selector de value stream (Rivian / Tesla) + pestañas; la vista principal es KPIs + mapa + captura; notas, revisión y guía en pestañas aparte */\n:root{\n  color-scheme: dark;\n  --bg:#070b10; --bg2:#0a1017; --panel:#0e161f; --panel2:#0b121a; --raise:#132030;\n  --line:#1c2a38; --line2:#2a3d50; --fg:#e6eef5; --muted:#8a9cae; --dim:#5a6d80;\n  --mat:#48c2ff; --info:#a48bff; --inv:#ffb321; --crit:#ff5a76; --ok:#3ddc97; --draft:#d9b26a; --tesla:#ff6b5a;\n  --display:\"Barlow Condensed\",\"Arial Narrow\",system-ui,sans-serif;\n  --body:\"IBM Plex Sans\",system-ui,-apple-system,\"Segoe UI\",sans-serif;\n  --mono:\"JetBrains Mono\",ui-monospace,Menlo,Consolas,monospace;\n}\n*{box-sizing:border-box}\nbody{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:14px;line-height:1.45}\n.wrap{max-width:1680px;margin:0 auto;padding-inline:16px;padding-block:14px 48px;display:flex;flex-direction:column;gap:14px}\n.top{display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center;justify-content:space-between}\n.dmlogo{height:62px;width:auto;flex:none;padding-right:16px;border-right:1px solid var(--line2)}\n@media (max-width:640px){.dmlogo{height:44px;padding-right:12px}}\n.brand{display:flex;align-items:center;gap:14px;min-width:0}\n.mark{width:40px;height:40px;border-radius:9px;border:1px solid var(--line2);display:grid;place-items:center;background:linear-gradient(160deg,#10202e,#0a121a);flex:none}\n.eyebrow{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}\n.eyebrow b{color:var(--mat);font-weight:500}\nh1{font-family:var(--display);font-weight:700;font-size:clamp(28px,3.6vw,40px);line-height:1;margin:2px 0 0;letter-spacing:.01em;text-wrap:balance}\n.controls{display:flex;gap:8px;flex-wrap:wrap;align-items:center}\n.pill{font-family:var(--mono);font-size:10.5px;letter-spacing:.05em;padding:5px 10px;border-radius:999px;border:1px solid var(--line2);color:var(--muted);white-space:nowrap;display:inline-flex;gap:6px;align-items:center}\n.pill i{width:7px;height:7px;border-radius:50%;background:var(--dim);display:inline-block}\n.pill.live{color:var(--ok);border-color:color-mix(in srgb,var(--ok) 50%,transparent)} .pill.live i{background:var(--ok);box-shadow:0 0 8px var(--ok)}\n.pill.loc{color:var(--inv);border-color:color-mix(in srgb,var(--inv) 50%,transparent)} .pill.loc i{background:var(--inv)}\n.btn{all:unset;cursor:pointer;font-family:var(--mono);font-size:11.5px;letter-spacing:.04em;padding:8px 12px;border:1px solid var(--line2);border-radius:8px;color:var(--fg);background:var(--panel2);display:inline-flex;gap:6px;align-items:center;white-space:nowrap}\n.btn:hover{border-color:var(--mat)}\n.btn.primary{background:var(--mat);color:#03121c;border-color:var(--mat);font-weight:600}\n.btn:focus-visible,.seg button:focus-visible,.tabs button:focus-visible,.vs button:focus-visible{outline:2px solid var(--mat);outline-offset:2px}\n.btn[disabled]{opacity:.5;cursor:default}\n.nav{display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}\n.vs{display:inline-flex;gap:6px;padding-bottom:10px;flex-wrap:wrap}\n.vs button{all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:9px;border:1px solid var(--line2);background:var(--panel2);font-family:var(--display);font-size:17px;font-weight:600;letter-spacing:.03em;color:var(--muted)}\n.vs button span{font-family:var(--mono);font-size:10px;font-weight:400;letter-spacing:.06em;color:var(--dim)}\n.vs button[aria-pressed=\"true\"]{color:var(--fg);border-color:var(--c);box-shadow:inset 0 0 0 1px var(--c);background:color-mix(in srgb,var(--c) 10%,var(--panel2))}\n.tabs{display:inline-flex;gap:2px;flex-wrap:wrap}\n.tabs button{all:unset;cursor:pointer;font-family:var(--mono);font-size:11.5px;letter-spacing:.05em;padding:10px 14px;color:var(--muted);border-bottom:2px solid transparent}\n.tabs button[aria-selected=\"true\"]{color:var(--fg);border-bottom-color:var(--mat)}\n.tabs button .ct{font-size:10px;color:var(--dim);margin-left:4px}\n.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden}\n.kpi{background:var(--panel);padding:12px 14px 11px;min-width:0;position:relative}\n.kpi .l{font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.kpi .v{font-family:var(--display);font-weight:600;font-size:30px;line-height:1.08;margin-top:5px;font-variant-numeric:tabular-nums;white-space:nowrap}\n.kpi .v small{font-size:14px;color:var(--muted);font-weight:500;margin-left:3px}\n.kpi .v.na{color:var(--dim)}\n.kpi .d{font-family:var(--mono);font-size:10.5px;color:var(--dim);margin-top:3px;min-height:15px}\n.kpi.alert::before{content:\"\";position:absolute;inset:0 auto 0 0;width:3px;background:var(--crit)}\n.kpi.alert .v{color:var(--crit)}\n.meter{height:4px;border-radius:2px;background:var(--panel2);margin-top:6px;overflow:hidden}\n.meter span{display:block;height:100%;background:linear-gradient(90deg,var(--inv),var(--ok));transition:width .6s ease}\n.mapshell{position:relative;background:radial-gradient(1400px 500px at 50% -10%,#0f2131 0%,var(--bg2) 62%);border:1px solid var(--line);border-radius:14px;overflow:hidden}\n.maptools{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--panel2) 80%,transparent)}\n.grp{display:flex;flex-wrap:wrap;gap:6px;align-items:center}\n.grp .lab{font-family:var(--mono);font-size:10.5px;color:var(--dim);letter-spacing:.08em;text-transform:uppercase;margin-right:2px}\n.tg{display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11px;color:var(--muted);padding:5px 9px;border:1px solid var(--line2);border-radius:999px;cursor:pointer;user-select:none}\n.tg input{appearance:none;width:8px;height:8px;border-radius:50%;margin:0;background:var(--dim);cursor:pointer}\n.tg input:checked{background:var(--c,var(--mat));box-shadow:0 0 8px var(--c,var(--mat))}\n.tg:has(input:checked){color:var(--fg)}\n.tg:focus-within{outline:2px solid var(--mat);outline-offset:2px}\n.seg{display:inline-flex;border:1px solid var(--line2);border-radius:8px;padding:2px;background:var(--panel2)}\n.seg button{all:unset;cursor:pointer;font-family:var(--mono);font-size:11px;padding:5px 10px;border-radius:6px;color:var(--muted)}\n.seg button[aria-pressed=\"true\"]{background:var(--raise);color:var(--fg);box-shadow:inset 0 0 0 1px var(--mat)}\n.zoom{display:inline-flex;border:1px solid var(--line2);border-radius:8px;overflow:hidden}\n.zoom button{all:unset;cursor:pointer;font-family:var(--mono);font-size:12px;padding:5px 10px;color:var(--fg)}\n.zoom button+button{border-left:1px solid var(--line2)}\n.zoom button:focus-visible{outline:2px solid var(--mat)}\n.mapscroll{overflow:auto}\n#map{display:block;width:100%;min-width:1320px;height:auto}\n#map text{font-family:var(--mono);fill:var(--fg)}\n#map .pn{font-family:var(--display);font-weight:600;font-size:17px;letter-spacing:.02em}\n#map .pn2{font-family:var(--display);font-weight:500;font-size:13.5px;fill:var(--muted)}\n#map .lbl{font-size:10.5px;fill:var(--muted)}\n#map .val{font-size:11.5px;text-anchor:end;font-weight:500}\n#map .op{font-size:9.5px;letter-spacing:.12em;fill:var(--dim)}\n#map .proc{cursor:pointer;outline:none}\n#map .proc:hover .frame,#map .proc:focus-visible .frame{stroke:var(--mat)}\n#map .flow{stroke-dasharray:7 6;animation:dash 1.1s linear infinite}\n#map .pulse{animation:pulse 1.6s ease-in-out infinite}\n@keyframes dash{to{stroke-dashoffset:-13}}\n@keyframes pulse{0%,100%{stroke-opacity:1}50%{stroke-opacity:.3}}\n.paused #map .flow,.paused #map .pulse{animation-play-state:paused}\n@media (prefers-reduced-motion:reduce){#map .flow,#map .pulse{animation:none}}\n.legend{display:flex;flex-wrap:wrap;gap:8px 18px;padding:9px 14px;border-top:1px solid var(--line);font-family:var(--mono);font-size:10.5px;color:var(--muted)}\n.legend i{display:inline-block;width:20px;height:8px;border-radius:2px;margin-right:6px;vertical-align:middle}\n.tip{position:fixed;z-index:20;pointer-events:none;background:#0b131bf2;border:1px solid var(--line2);border-radius:8px;padding:8px 10px;font-family:var(--mono);font-size:11px;line-height:1.55;color:var(--fg);white-space:pre-line;max-width:320px;box-shadow:0 10px 30px #0008}\n.grid2{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:14px}\n@media (max-width:980px){.grid2{grid-template-columns:minmax(0,1fr)}}\n[hidden]{display:none!important}\n.drawer{position:fixed;top:0;right:0;height:100%;width:min(460px,100%);background:var(--panel);border-left:1px solid var(--line2);box-shadow:-24px 0 48px rgba(0,0,0,.5);transform:translateX(105%);transition:transform .25s ease;z-index:60;display:flex;flex-direction:column}\n.drawer.open{transform:none}\n.drawer .dh{padding:18px 20px 14px;border-bottom:1px solid var(--line);display:flex;gap:12px;align-items:flex-start}\n.drawer .dh .t{flex:1;min-width:0}\n.drawer .dh .k{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;color:var(--muted);text-transform:uppercase}\n.drawer .dh h3{margin:4px 0 0;font-size:20px;line-height:1.2}\n.drawer .dh h3 small{display:block;font-size:13px;color:var(--muted);font-weight:500;margin-top:2px}\n.drawer .x{background:none;border:1px solid var(--line2);color:var(--fg);border-radius:8px;width:34px;height:34px;font-size:18px;cursor:pointer;flex:none}\n.drawer .db{padding:16px 20px 24px;overflow:auto;flex:1;display:flex;flex-direction:column;gap:14px}\n.drawer .res{font-size:13.5px;line-height:1.55;color:var(--fg);background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:12px 14px}\n.drawer .flg{font-size:13px;line-height:1.5;color:var(--inv);border-left:3px solid var(--inv);padding:4px 0 4px 10px}\n.drawer .sec{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;color:var(--muted);text-transform:uppercase;display:flex;justify-content:space-between;align-items:center}\n.drawer .sec button{font:inherit;letter-spacing:.06em;background:none;border:none;color:var(--mat);cursor:pointer;text-transform:none}\n.drawer textarea{width:100%;box-sizing:border-box}\n.scrim{position:fixed;inset:0;background:rgba(3,6,10,.45);z-index:59}\n.gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}\n.gal figure{margin:0;background:var(--panel2);border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column}\n.gal button.ph{all:unset;cursor:zoom-in;display:block;aspect-ratio:4/3;background:#0b1118}\n.gal img{width:100%;height:100%;object-fit:cover;display:block}\n.gal figcaption{padding:10px 12px 12px;display:flex;flex-direction:column;gap:6px;font-size:13px;line-height:1.45}\n.gal .meta{font-family:var(--mono);font-size:10.5px;color:var(--muted);display:flex;gap:8px;flex-wrap:wrap}\n.chip{display:inline-block;font-family:var(--mono);font-size:10.5px;padding:2px 8px;border-radius:999px;border:1px solid var(--line2);color:var(--fg)}\n.chips{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 14px}\n.chips button{font-family:var(--mono);font-size:11px;padding:5px 11px;border-radius:999px;border:1px solid var(--line2);background:none;color:var(--muted);cursor:pointer}\n.chips button[aria-pressed=\"true\"]{color:var(--bg);background:var(--mat);border-color:var(--mat)}\n.lb{position:fixed;inset:0;background:rgba(3,6,10,.92);z-index:70;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;gap:12px}\n.lb img{max-width:100%;max-height:82vh;border-radius:8px}\n.lb p{color:var(--fg);max-width:900px;text-align:center;font-size:14px;line-height:1.5;margin:0}\n.upf{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-bottom:16px}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px 18px;min-width:0}\n.card h2{font-family:var(--display);font-weight:600;font-size:22px;letter-spacing:.02em;margin:0 0 4px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n.card h3{font-family:var(--display);font-size:16px;font-weight:600;margin:18px 0 8px;color:var(--muted);letter-spacing:.04em}\n.cuSeg{display:flex;border:1px solid var(--line);border-radius:9px;overflow:hidden}.cuSeg button{background:transparent;border:0;color:var(--muted);font-family:var(--mono);font-size:11px;padding:8px 12px;cursor:pointer}.cuSeg button[aria-pressed=\"true\"]{background:#15283a;color:var(--fg)}\n.cuK{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-top:6px}.cuK>div{border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:var(--bg2)}.cuK b{display:block;font-family:var(--display);font-size:24px;font-weight:600;line-height:1.15}.cuK span{font-family:var(--mono);font-size:10px;letter-spacing:.06em;color:var(--muted);text-transform:uppercase}.cuK small{display:block;font-size:11.5px;color:var(--muted);margin-top:2px}\n#cuRoutes svg g[data-id],#cuRank svg g[data-id]{cursor:pointer}\n.card .kick{font-family:var(--mono);font-size:10.5px;color:var(--muted);margin:0 0 14px}\n.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}\n.form label{font-family:var(--mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);display:flex;flex-direction:column;gap:4px;min-width:0}\n.form input,.form select,#procSel,#noteTxt{width:100%;background:var(--panel2);border:1px solid var(--line2);border-radius:7px;color:var(--fg);font-family:var(--mono);font-size:13px;padding:8px 9px}\n.form input:focus,.form select:focus,#procSel:focus,#noteTxt:focus{outline:none;border-color:var(--mat)}\n.form input::placeholder{color:var(--draft);opacity:.75}\n#procSel{font-family:var(--display);font-size:18px;font-weight:600;padding:8px 10px;margin-bottom:12px}\ndetails.more{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}\ndetails.more summary{cursor:pointer;font-family:var(--mono);font-size:11px;color:var(--muted);margin-bottom:10px}\n.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:12px}\n.note{font-family:var(--mono);font-size:10.5px;color:var(--dim)}\n.flag{border:1px dashed color-mix(in srgb,var(--inv) 60%,transparent);background:color-mix(in srgb,var(--inv) 7%,transparent);border-radius:8px;padding:9px 12px;font-size:13px;margin:0 0 12px}\n.flag b{color:var(--inv);font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;margin-right:6px}\n.check{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}\n.check li{display:grid;grid-template-columns:18px 1fr;gap:8px;font-size:13px}\n.check li::before{content:\"\";width:12px;height:12px;border:1.5px solid var(--line2);border-radius:3px;margin-top:3px}\nul.ins{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:11px}\nul.ins li{display:grid;grid-template-columns:96px 1fr;gap:10px;align-items:start}\nul.ins .tag{font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;padding:3px 6px;border-radius:5px;border:1px solid var(--line2);color:var(--muted);text-align:center}\nul.ins .tag.r{color:var(--crit);border-color:color-mix(in srgb,var(--crit) 50%,transparent)}\nul.ins .tag.a{color:var(--inv);border-color:color-mix(in srgb,var(--inv) 50%,transparent)}\nul.ins .tag.b{color:var(--mat);border-color:color-mix(in srgb,var(--mat) 50%,transparent)}\nul.ins .tag.v{color:var(--info);border-color:color-mix(in srgb,var(--info) 50%,transparent)}\nul.ins .tag.h{color:var(--ok);border-color:color-mix(in srgb,var(--ok) 50%,transparent)}\n.notes{list-style:none;margin:12px 0 0;padding:0;display:flex;flex-direction:column;gap:8px}\n.notes li{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:8px 10px}\n.notes .m{font-family:var(--mono);font-size:10px;color:var(--muted);display:flex;gap:8px;flex-wrap:wrap}\n.notes .m b{color:var(--mat);font-weight:500}\n.notes p{margin:3px 0 0;font-size:13px;white-space:pre-wrap;overflow-wrap:anywhere}\n.empty{font-family:var(--mono);font-size:11px;color:var(--dim);padding:10px 0}\n.gl{width:100%;border-collapse:collapse;font-size:13px}\n.gl td,.gl th{padding:8px 6px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}\n.gl th{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:500}\n.gl td:first-child{font-family:var(--mono);color:var(--mat);white-space:nowrap}\n.need{font-family:var(--mono);font-size:10px;padding:2px 7px;border-radius:5px;border:1px solid;white-space:nowrap}\n.need.y{color:var(--ok)}.need.m{color:var(--inv)}.need.n{color:var(--dim)}\n.plan{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}\n.plan li{display:grid;grid-template-columns:62px 1fr;gap:10px}\n.plan b{font-family:var(--display);font-size:17px;color:var(--mat)}\n.cbar{height:6px;border-radius:3px;background:var(--panel2);min-width:90px;overflow:hidden;margin-top:4px}\n.cbar span{display:block;height:100%}\n#tabTbl td{font-variant-numeric:tabular-nums}\n#tabTbl td.num{font-family:var(--mono);text-align:right;white-space:nowrap}\n.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--raise);border:1px solid var(--line2);border-radius:10px;padding:10px 16px;font-family:var(--mono);font-size:12px;z-index:30;box-shadow:0 10px 30px #000a}\n#jsonOut{width:100%;min-height:110px;margin-top:10px;background:var(--panel2);color:var(--fg);border:1px solid var(--line2);border-radius:8px;font-family:var(--mono);font-size:11px;padding:10px}\nfooter{font-family:var(--mono);font-size:10.5px;color:var(--dim);display:flex;flex-wrap:wrap;gap:6px 18px;border-top:1px solid var(--line);padding-top:12px}\n</style>\n\n<div class=\"wrap\" id=\"app\">\n  <div class=\"top\">\n    <div class=\"brand\">\n      <img class=\"dmlogo\" src=\"data:image/png;base64,\" alt=\"DAIMAY\">\n      <div style=\"min-width:0\">\n        <div class=\"eyebrow\" id=\"eyebrow\"><b>DAIMAY · PLANTA 4</b></div>\n        <h1 id=\"h1\">VSM · Estado actual</h1>\n      </div>\n    </div>\n    <div class=\"controls\">\n      <span class=\"pill\" style=\"color:var(--fg)\">Autor: Genet Campos · Mejora Continua</span>\n      <span class=\"pill\" id=\"liveP\"><i></i>Conectando…</span>\n      <button class=\"btn\" id=\"bTheme\" aria-pressed=\"false\" title=\"Cambiar el fondo del VSM\"></button>\n      <button class=\"btn\" id=\"bPlay\" aria-pressed=\"true\">❚❚ Pausar</button>\n    </div>\n  </div>\n\n  <div class=\"nav\">\n    <div class=\"vs\" role=\"group\" aria-label=\"Value stream\">\n      <button data-vs=\"rivian\" aria-pressed=\"true\" style=\"--c:var(--mat)\">Rivian <span>door panel · inserts</span></button>\n      <button data-vs=\"tesla\" aria-pressed=\"false\" style=\"--c:var(--tesla)\">Toldos <span>headliner · Rivian + Tesla</span></button>\n    </div>\n    <div class=\"tabs\" role=\"tablist\" aria-label=\"Secciones\">\n      <button role=\"tab\" data-tab=\"mapa\" aria-selected=\"true\">Mapa</button>\n      <button role=\"tab\" data-tab=\"cue\" aria-selected=\"false\">Cuellos</button>\n      <button role=\"tab\" data-tab=\"notas\" aria-selected=\"false\">Notas de gemba<span class=\"ct\" id=\"nCount\"></span></button>\n      <button role=\"tab\" data-tab=\"tab\" aria-selected=\"false\">Tableros<span class=\"ct\" id=\"tCount\"></span></button>\n      <button role=\"tab\" data-tab=\"ct\" aria-selected=\"false\">Tiempos</button>\n      <button role=\"tab\" data-tab=\"fotos\" aria-selected=\"false\">Fotos<span class=\"ct\" id=\"fCount\"></span></button>\n      <button role=\"tab\" data-tab=\"rev\" aria-selected=\"false\">Hallazgos</button>\n      <button role=\"tab\" data-tab=\"guia\" aria-selected=\"false\">Guía</button>\n    </div>\n  </div>\n\n  <div data-panel=\"mapa\" style=\"display:flex;flex-direction:column;gap:14px\">\n  <section class=\"kpis\" aria-label=\"Indicadores\">\n    <div class=\"kpi\"><div class=\"l\">Avance · vista general</div><div class=\"v\"><span id=\"kAv\">0</span><small>%</small></div><div class=\"meter\"><span id=\"kAvM\" style=\"width:0\"></span></div><div class=\"d\" id=\"dAv\"></div></div>\n    <div class=\"kpi\"><div class=\"l\">Demanda</div><div class=\"v\" id=\"kDem\">—</div><div class=\"d\" id=\"dDem\"></div></div>\n    <div class=\"kpi\"><div class=\"l\">Takt</div><div class=\"v\" id=\"kTakt\">—</div><div class=\"d\" id=\"dTakt\"></div></div>\n    <div class=\"kpi\"><div class=\"l\">Lead time · ruta</div><div class=\"v\" id=\"kLT\">—</div><div class=\"d\" id=\"dLT\"></div></div>\n    <div class=\"kpi\"><div class=\"l\">C/T acumulado · ruta</div><div class=\"v\" id=\"kVA\">—</div><div class=\"d\" id=\"dVA\"></div></div>\n    <div class=\"kpi alert\" id=\"kpiDQ\"><div class=\"l\">Defecto inspección final</div><div class=\"v\" id=\"kDQ\">—</div><div class=\"d\" id=\"dDQ\"></div></div>\n    <div class=\"kpi\"><div class=\"l\">Estructura validada</div><div class=\"v\" id=\"kVal\">—</div><div class=\"d\" id=\"dVal\"></div></div>\n  </section>\n\n  <section class=\"mapshell\">\n    <div class=\"maptools\">\n      <div class=\"grp\" role=\"group\" aria-label=\"Ruta resaltada\"><span class=\"lab\">Ruta</span><div class=\"seg\" id=\"routeSeg\"></div></div>\n      <div class=\"grp\" role=\"group\" aria-label=\"Capas\">\n        <label class=\"tg\" style=\"--c:var(--info)\"><input type=\"checkbox\" id=\"lyInfo\" checked>Información</label>\n        <label class=\"tg\" style=\"--c:var(--mat)\"><input type=\"checkbox\" id=\"lyMov\" checked>Traslado</label>\n        <label class=\"tg\" style=\"--c:#5aa0ff\"><input type=\"checkbox\" id=\"lyKb\" checked>Kanban</label>\n        <label class=\"tg\" style=\"--c:var(--crit)\"><input type=\"checkbox\" id=\"lyQ\" checked>Calidad</label>\n        <label class=\"tg\" style=\"--c:var(--inv)\"><input type=\"checkbox\" id=\"lyT\" checked>Línea de tiempo</label>\n        <div class=\"zoom\" role=\"group\" aria-label=\"Zoom\"><button id=\"zOut\" aria-label=\"Alejar\">−</button><button id=\"zFit\">Ajustar</button><button id=\"zIn\" aria-label=\"Acercar\">+</button></div>\n      </div>\n    </div>\n    <div class=\"mapscroll\"><svg id=\"map\" viewBox=\"0 0 2240 1250\" role=\"img\" aria-label=\"Mapa de flujo de valor\"></svg></div>\n    <div class=\"legend\">\n      <span><i style=\"background:repeating-linear-gradient(115deg,#48c2ff 0 4px,transparent 4px 8px)\"></i>Material · línea gruesa = ruta seleccionada</span>\n      <span><svg width=\"22\" height=\"12\" viewBox=\"0 0 26 16\" style=\"vertical-align:middle;margin-right:6px\"><path d=\"M2 2 L6 11 H22\" fill=\"none\" stroke=\"#48c2ff\" stroke-width=\"1.6\"/><rect x=\"8\" y=\"5\" width=\"13\" height=\"5\" rx=\"1\" fill=\"#48c2ff\"/><circle cx=\"8\" cy=\"13\" r=\"2\" fill=\"#48c2ff\"/><circle cx=\"20\" cy=\"13\" r=\"2\" fill=\"#48c2ff\"/></svg>Traslado · patín, carro, montacargas…</span>\n      <span><i style=\"background:repeating-linear-gradient(90deg,#a48bff 0 6px,transparent 6px 12px)\"></i>Información</span>\n      <span><i style=\"background:#ffb321;width:10px;height:10px;clip-path:polygon(50% 0,100% 100%,0 100%)\"></i>Inventario</span>\n      <span><i style=\"background:#ff5a76;height:3px\"></i>Retrabajo / reversa</span><span><i style=\"background:#2dd4bf;height:3px\"></i>Planta 1 → P4</span><span><i style=\"background:#fb923c;height:3px\"></i>Loop P7 · foam armrest</span><span style=\"color:#e6eef5\">Blanco = gemba</span><span style=\"color:#d9b26a\">Dorado = draft</span><span>— = falta</span>\n      <span>✓ ≠ ? = estructura confirmada, diferente o pendiente</span><span>! = supuesto por confirmar</span>\n    </div>\n  </section>\n\n  <section class=\"grid2\">\n    <div class=\"card\" id=\"capCard\">\n      <h2>Captura en gemba</h2>\n      <p class=\"kick\">La lista va en orden de recorrido: de embarque hacia atrás. Lo que guardes aparece en el mapa para todo el equipo.</p>\n      <select id=\"procSel\" aria-label=\"Proceso a capturar\"></select>\n      <div id=\"procFlag\"></div>\n      <div class=\"form\">\n        <label for=\"f-val\">¿Existe así en piso?<select id=\"f-val\"><option value=\"\">Pendiente</option><option>Confirmado</option><option>Diferente</option></select></label>\n        <label for=\"f-ct\">C/T s<input id=\"f-ct\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"any\"></label>\n        <label for=\"f-src\">Fuente del C/T<select id=\"f-src\"><option value=\"\">—</option><option>Estándar</option><option>Cronometrado</option><option>Estimado</option></select></label>\n        <label for=\"f-ops\">Operadores<input id=\"f-ops\" type=\"number\" inputmode=\"numeric\" min=\"0\" step=\"1\"></label>\n        <label for=\"f-wip\">WIP después · pz<input id=\"f-wip\" type=\"number\" inputmode=\"numeric\" min=\"0\" step=\"1\"></label>\n        <label for=\"f-mov\">Traslado al siguiente<select id=\"f-mov\"><option value=\"\">—</option><option>Manual</option><option>Patín</option><option>Carro</option><option>Rack</option><option>Montacargas</option><option>Tugger</option><option>Banda</option></select></label>\n      </div>\n      <details class=\"more\"><summary>Datos adicionales (opcional en vista general)</summary>\n      <div class=\"form\">\n        <label for=\"f-freq\">Embarques o viajes/día<input id=\"f-freq\" type=\"text\" placeholder=\"ej. 12–16\"></label>\n        <label for=\"f-lote\">Lote · pz por viaje<input id=\"f-lote\" type=\"text\" placeholder=\"ej. 260–280\"></label>\n        <label for=\"f-co\">C/O min<input id=\"f-co\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"any\"></label>\n        <label for=\"f-up\">Uptime %<input id=\"f-up\" type=\"number\" inputmode=\"decimal\" min=\"0\" max=\"100\" step=\"any\"></label>\n        <label for=\"f-def\">Defecto %<input id=\"f-def\" type=\"number\" inputmode=\"decimal\" min=\"0\" max=\"100\" step=\"any\"></label>\n        <label for=\"f-kb\">¿Kanban/FIFO opera?<select id=\"f-kb\"><option value=\"\">—</option><option>Sí</option><option>Parcial</option><option>No</option><option>No aplica</option></select></label>\n      </div></details>\n      <div class=\"row\"><button class=\"btn primary\" id=\"bSave\">Guardar proceso</button><span class=\"note\" id=\"capMeta\"></span></div>\n    </div>\n    <div class=\"card\">\n      <h2>Qué medir aquí</h2>\n      <p class=\"kick\" id=\"chkKick\"></p>\n      <ul class=\"check\" id=\"checkList\"></ul>\n      <h3>Parámetros del flujo · <span id=\"parName\"></span></h3>\n      <div class=\"form\">\n        <label for=\"p-dem\">Piezas/día<input id=\"p-dem\" type=\"number\" inputmode=\"numeric\" min=\"0\" step=\"1\"></label>\n        <label for=\"p-tur\">Turnos<input id=\"p-tur\" type=\"number\" inputmode=\"numeric\" min=\"0\" step=\"1\"></label>\n        <label for=\"p-hrs\">Horas netas/turno<input id=\"p-hrs\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"any\"></label>\n        <label for=\"p-mp\">MP en días<input id=\"p-mp\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"any\"></label>\n      </div>\n      <div class=\"row\"><button class=\"btn\" id=\"bSaveP\">Guardar parámetros</button><span class=\"note\">El takt y los días de inventario salen de aquí.</span></div>\n    </div>\n  </section>\n  </div>\n\n  <div data-panel=\"notas\" hidden>\n    <div class=\"card\">\n      <h2>Notas de gemba · <span id=\"notesVs\"></span></h2>\n      <p class=\"kick\">Hallazgos, fotos pendientes, dudas. Se ligan al proceso elegido en la captura.</p>\n      <textarea id=\"noteTxt\" rows=\"3\" placeholder=\"Ej. 3 racks esperando spray desde el viernes\" aria-label=\"Nueva nota\"></textarea>\n      <div class=\"row\"><button class=\"btn\" id=\"bNote\">Agregar nota a <span id=\"noteP\"></span></button></div>\n      <ul class=\"notes\" id=\"notes\"></ul>\n    </div>\n  </div>\n\n  <div data-panel=\"tab\" hidden>\n    <div class=\"card\">\n      <h2>Tableros hora por hora · <span id=\"tabVs\"></span></h2>\n      <p class=\"kick\">Meta acumulada vs real al corte de cada tablero, tomado de fotos de piso. Ordenado de peor a mejor cumplimiento.</p>\n      <div class=\"kpis\" id=\"tabSum\" style=\"margin-bottom:14px\"></div>\n      <div style=\"overflow-x:auto\"><table class=\"gl\" id=\"tabTbl\"></table></div>\n    </div>\n  </div>\n\n  <div data-panel=\"fotos\" hidden>\n    <div class=\"card\">\n      <h2>Evidencia fotográfica · <span id=\"fotosVs\"></span></h2>\n      <p class=\"kick\">Desorden, mezcla de material, WIP, falta de estandarización y tableros, tal como se vieron en piso. Cada foto puede ligarse a una caja del mapa.</p>\n      <div id=\"fotoUp\" hidden>\n        <div class=\"form\">\n          <label for=\"fFile\">Foto(s)<input id=\"fFile\" type=\"file\" accept=\"image/*\" multiple></label>\n          <label for=\"fCat\">Categoría<select id=\"fCat\"><option>Desorden / 5S</option><option>Mezcla de material</option><option>WIP / inventario</option><option>Falta de estandarización</option><option>Calidad / retrabajo</option><option>Tablero</option><option>Equipo</option><option>Otro</option></select></label>\n          <label for=\"fProc\">Caja del mapa<select id=\"fProc\"></select></label>\n          <label for=\"fCap\">Qué se ve<input id=\"fCap\" type=\"text\" maxlength=\"400\" placeholder=\"Ej. spacer spreado amontonado antes de upper, 11:30\"></label>\n        </div>\n        <div class=\"row\"><button class=\"btn primary\" id=\"bFoto\">Subir foto</button><span class=\"note\" id=\"fNote\"></span></div>\n      </div>\n      <p class=\"note\" id=\"fNoUp\" hidden>Solo quien puede editar la página sube fotos. Aquí se ven todas.</p>\n      <div class=\"chips\" id=\"fChips\" style=\"margin-top:16px\"></div>\n      <div class=\"gal\" id=\"gal\"></div>\n    </div>\n  </div>\n\n  <div data-panel=\"cue\" hidden style=\"display:flex;flex-direction:column;gap:14px\">\n    <div class=\"card\">\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap\">\n        <div><h2>Cuellos de botella · <span id=\"cuVs\"></span></h2><p class=\"kick\" id=\"cuKick\"></p></div>\n        <div class=\"cuSeg\" role=\"group\" aria-label=\"Fuente del C/T\"><button data-src=\"mapa\" aria-pressed=\"true\">C/T del mapa</button><button data-src=\"est\" aria-pressed=\"false\">C/T del estudio</button></div>\n      </div>\n      <div class=\"cuK\" id=\"cuKpi\"></div>\n    </div>\n    <div class=\"card\"><h2 style=\"font-size:19px\">Capacidad por ruta</h2><p class=\"kick\">Cada barra = piezas por hora que saca el proceso con todas sus líneas. Línea roja = demanda. La barra más baja de cada ruta es su cuello. Clic en una barra abre la caja en el mapa.</p><div id=\"cuRoutes\"></div></div>\n    <div class=\"card\"><h2 style=\"font-size:19px\">Carga contra takt</h2><p class=\"kick\">C/T ÷ (takt × líneas). Arriba de 100% el proceso no alcanza la demanda; entre 85% y 100% no tiene margen para paros.</p><div id=\"cuRank\"></div></div>\n  </div>\n  <div data-panel=\"ct\" hidden style=\"display:flex;flex-direction:column;gap:14px\">\n    <div class=\"card\">\n      <h2>Estudio de tiempos · <span id=\"ctVs\"></span></h2>\n      <p class=\"kick\" id=\"ctKick\"></p>\n      <div id=\"ctWarn\"></div>\n      <h3>Cajas del VSM: C/T en el mapa vs estudio</h3><p class=\"kick\">Las cajas que no tenían C/T ya tomaron el valor del estudio. Donde había estándar se dejó y se marca ≠ si difiere más de 15%.</p>\n      <div style=\"overflow-x:auto\"><table class=\"gl\" id=\"ctTbl\"></table></div>\n    </div>\n    <div id=\"ctCharts\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,560px),1fr));gap:14px\"></div>\n  </div>\n  <div data-panel=\"rev\" hidden style=\"display:flex;flex-direction:column;gap:14px\">\n    <div class=\"card\" id=\"xCard\">\n      <h2>Conexiones entre plantas · <span id=\"xVs\"></span></h2>\n      <p class=\"kick\">Qué entra y sale de P4 hacia P1 y P7. En el mapa: línea turquesa = Planta 1, línea naranja = loop de foam en Planta 7.</p>\n      <div style=\"overflow-x:auto\"><table class=\"gl\" id=\"xTbl\"></table></div>\n    </div>\n    <div class=\"card\" id=\"rwCard\">\n      <h2>Zonas de retrabajo · <span id=\"rwVs\"></span></h2>\n      <p class=\"kick\">Dónde regresa el material y cuánto, según el recorrido. En el mapa: recuadros rojos ↺ debajo de cada caja (capa Calidad).</p>\n      <div style=\"overflow-x:auto\"><table class=\"gl\" id=\"rwTbl\"></table></div>\n    </div>\n    <div class=\"card\">\n      <h2>Hallazgos e hipótesis · <span id=\"revVs\"></span></h2>\n      <p class=\"kick\" id=\"revKick\"></p>\n      <ul class=\"ins\" id=\"review\"></ul>\n    </div>\n  </div>\n\n  <div data-panel=\"guia\" hidden style=\"display:flex;flex-direction:column;gap:14px\">\n  <section class=\"grid2\">\n    <div class=\"card\">\n      <h2>Qué significa cada dato</h2>\n      <p class=\"kick\">Para una vista general basta con lo marcado como necesario</p>\n      <div style=\"overflow-x:auto\"><table class=\"gl\"><thead><tr><th>Dato</th><th>Qué es</th><th>¿Se necesita?</th></tr></thead><tbody>\n      <tr><td>Takt</td><td>Cada cuántos segundos pide el cliente una pieza. Sale de demanda y horas, no se mide.</td><td><span class=\"need y\">Sí</span></td></tr>\n      <tr><td>C/T</td><td>Segundos entre una pieza y la siguiente al salir del proceso. Para la vista general sirve el estándar de ingeniería.</td><td><span class=\"need y\">Sí</span></td></tr>\n      <tr><td>Ops</td><td>Personas trabajando en ese proceso.</td><td><span class=\"need y\">Sí</span></td></tr>\n      <tr><td>WIP</td><td>Piezas esperando después del proceso, contadas una vez. Con esto sale el lead time.</td><td><span class=\"need y\">Sí</span></td></tr>\n      <tr><td>Defecto</td><td>% de piezas que no salen bien a la primera.</td><td><span class=\"need m\">Solo donde es grande</span></td></tr>\n      <tr><td>C/O</td><td>Minutos parados al cambiar de número de parte: de la última pieza buena a la primera buena.</td><td><span class=\"need m\">Solo en lotes</span></td></tr>\n      <tr><td>Uptime</td><td>% del tiempo que el equipo está disponible para producir.</td><td><span class=\"need n\">No por ahora</span></td></tr>\n      </tbody></table></div>\n    </div>\n    <div class=\"card\">\n      <h2>Plan para cerrarlo en una semana</h2>\n      <p class=\"kick\">Vista general: otras plantas como cajas negras, detalle solo en P4</p>\n      <ul class=\"plan\">\n        <li><b>Día 1</b><span>Recorrido en P4 de embarque hacia atrás, Rivian y Tesla. Marca cada caja como Confirmado o Diferente.</span></li>\n        <li><b>Día 2</b><span>Conteo de WIP en todos los triángulos en una sola vuelta, con hora. C/T y operadores de las hojas de balanceo.</span></li>\n        <li><b>Día 3</b><span>P1 y P7 por llamada o visita corta: inventario de piezas del cliente, frecuencia del shuttle y tránsito.</span></li>\n        <li><b>Día 4</b><span>Planeación: demanda diaria por cliente y días de MP. Calidad: defecto de inspección final.</span></li>\n        <li><b>Día 5</b><span>Revisión con el equipo. Marcar los 3–5 kaizen del estado futuro de cada cliente.</span></li>\n      </ul>\n    </div>\n  </section>\n  <div class=\"card\">\n    <h2>Exportar</h2>\n    <p class=\"kick\">Todo lo capturado de Rivian y Tesla (procesos, parámetros y notas) en JSON</p>\n    <div class=\"row\" style=\"margin-top:0\"><button class=\"btn\" id=\"bCopy\">Copiar JSON</button><span class=\"note\" id=\"cpNote\"></span></div>\n    <textarea id=\"jsonOut\" hidden readonly aria-label=\"JSON exportado\"></textarea>\n  </div>\n  </div>\n\n  <footer>\n    <span style=\"color:var(--muted)\">Autor: Genet Campos · Mejora Continua DAIMAY</span>\n    <span>Takt = turnos × horas netas × 3600 ÷ piezas/día</span>\n    <span>En procesos con varias líneas, cada línea se compara contra takt × líneas</span>\n    <span>Lead time de ruta = MP + Σ días de inventario</span>\n  </footer>\n</div>\n<div class=\"tip\" id=\"tip\" hidden></div>\n<div class=\"scrim\" id=\"scrim\" hidden></div>\n<style>\n/* --- tema claro: ajustes que no salen de las variables --- */\nhtml[data-theme=\"light\"] body{background:var(--bg)}\nhtml[data-theme=\"light\"] .drawer,html[data-theme=\"light\"] .lb{box-shadow:0 20px 60px rgba(15,23,42,.18)}\nhtml[data-theme=\"light\"] .btn.primary{color:#fff}\nhtml[data-theme=\"light\"] .chips button[aria-pressed=\"true\"]{color:#fff}\nhtml[data-theme=\"light\"] #map text{text-shadow:none}\nhtml[data-theme=\"light\"] .mapshell{background:radial-gradient(1400px 500px at 50% -10%,#ffffff 0%,var(--bg2) 62%)}\nhtml[data-theme=\"light\"] .mark{background:linear-gradient(160deg,#ffffff,#e8eef5)}\n/* --- edición de cajas --- */\n.edbox{border:1px solid var(--line2);border-radius:10px;padding:0 12px;margin-top:12px;background:var(--panel2)}\n.edbox summary{cursor:pointer;padding:10px 0;font-weight:600;color:var(--fg)}\n.edbox[open]{padding-bottom:12px}\n.edbox label{display:block;font-size:11.5px;color:var(--muted);margin:8px 0 3px}\n.edbox input,.edbox select,.edbox textarea{width:100%;box-sizing:border-box;background:var(--bg);color:var(--fg);border:1px solid var(--line2);border-radius:7px;padding:7px 8px;font:inherit;font-size:13px}\n.edbox textarea{resize:vertical}\n.edbox .g2{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.edbox .row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}\n.edbox .hint{font-size:11.5px;color:var(--dim);margin:8px 0 0}\n.edtag{display:inline-block;font-size:10px;font-weight:700;letter-spacing:.04em;color:var(--inv);border:1px solid var(--inv);border-radius:99px;padding:0 6px;margin-left:6px;vertical-align:2px}\n</style>\n<aside class=\"drawer\" id=\"drawer\" aria-hidden=\"true\" aria-labelledby=\"drT\" role=\"dialog\">\n  <div class=\"dh\"><div class=\"t\"><div class=\"k\" id=\"drK\"></div><h3 id=\"drT\"></h3></div><button class=\"x\" id=\"drX\" aria-label=\"Cerrar\">×</button></div>\n  <div class=\"db\">\n    <div class=\"res\" id=\"drRes\"></div>\n    <div class=\"flg\" id=\"drFlag\" hidden></div>\n    <div class=\"sec\"><span id=\"drNC\">Notas de gemba</span><button id=\"drFotos\" hidden></button></div>\n    <ul class=\"notes\" id=\"drNotes\" style=\"margin:0\"></ul>\n    <div class=\"sec\"><span>Agregar nota a esta caja</span></div>\n    <textarea id=\"drTxt\" rows=\"3\" placeholder=\"Qué viste, cuándo, cuánto\" aria-label=\"Nueva nota para esta caja\"></textarea>\n    <div class=\"row\"><button class=\"btn primary\" id=\"drAdd\">Guardar nota</button></div>\n    <details class=\"edbox\" id=\"drEd\"><summary>Editar esta caja <span class=\"edtag\" id=\"edTag\" hidden>EDITADA</span></summary>\n      <label for=\"edN1\">Nombre</label><input id=\"edN1\" maxlength=\"40\">\n      <label for=\"edN2\">Detalle (segunda línea)</label><input id=\"edN2\" maxlength=\"40\">\n      <label for=\"edPl\">Planta</label><input id=\"edPl\" maxlength=\"30\">\n      <div class=\"g2\"><div><label for=\"edC\">Columna</label><select id=\"edC\"></select></div><div><label for=\"edR\">Fila</label><select id=\"edR\"></select></div></div>\n      <label for=\"edRes\">Descripción</label><textarea id=\"edRes\" rows=\"6\"></textarea>\n      <label for=\"edFlag\">Alerta (deja vacío para quitarla)</label><input id=\"edFlag\" maxlength=\"160\">\n      <div class=\"row\"><button class=\"btn primary\" id=\"edSave\">Guardar cambios</button><button class=\"btn\" id=\"edReset\">Restaurar original</button><button class=\"btn\" id=\"edDel\" hidden>Eliminar caja</button></div>\n      <p class=\"hint\">C/T, operadores, WIP y defectos se capturan en la pestaña de captura, no aquí.</p>\n    </details>\n    <details class=\"edbox\" id=\"drAd\"><summary>Agregar caja nueva al mapa</summary>\n      <label for=\"adN1\">Nombre</label><input id=\"adN1\" maxlength=\"40\">\n      <label for=\"adN2\">Detalle (segunda línea)</label><input id=\"adN2\" maxlength=\"40\">\n      <label for=\"adPl\">Planta</label><input id=\"adPl\" maxlength=\"30\">\n      <div class=\"g2\"><div><label for=\"adC\">Columna</label><select id=\"adC\"></select></div><div><label for=\"adR\">Fila</label><select id=\"adR\"></select></div></div>\n      <div class=\"g2\"><div><label for=\"adFrom\">Viene de</label><select id=\"adFrom\"></select></div><div><label for=\"adTo\">Va hacia (opcional)</label><select id=\"adTo\"></select></div></div>\n      <div class=\"row\"><button class=\"btn primary\" id=\"adAdd\">Agregar caja</button></div>\n      <p class=\"hint\">Si la casilla ya está ocupada las cajas se enciman: elige otra columna o fila.</p>\n    </details>\n  </div>\n</aside>\n<div class=\"lb\" id=\"lb\" hidden role=\"dialog\" aria-label=\"Foto\"><img id=\"lbImg\" alt=\"\"><p id=\"lbCap\"></p><button class=\"btn\" id=\"lbX\">Cerrar</button></div>\n<div class=\"toast\" id=\"toast\" hidden role=\"sta