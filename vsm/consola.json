8, 73, 2], [\"BCK PNL UPR 70 closed\", 48, 62, 2], [\"BCK PNL UPR 80 inpection and closed\", 37, 41, 4], [\"BCK PNL UPR 90 Hot press\", 34, 36, 2], [\"BCK PNL UPR 100/110Ensamble de componentes\", 73, 86, 1], [\"BCK PNL UPR 120 Final Inspection\", 62, 64, 1]], \"sup\": \"-\"}, {\"t\": \"Back panel lower\", \"sh\": \"BP Lower\", \"box\": \"bp\", \"nt\": \"\", \"takt\": 72, \"day\": 1125, \"by\": \"Kevin Pananá\", \"date\": \"18 ago\", \"ops\": [[\"BCK PNL LWR 80Ultrasonic welder\", 68, 74, 1], [\"BCK PNL LWR 90 Assembly inner\", 54, 59, 1], [\"BCK PNL LWR 90 Assembly outter\", 57, 59, 1], [\"BCK PNL LWR 100 Assembly inner Assembly (Fixture)\", 63, 69, 1], [\"BCK PNL LWR 100 Assembly inner Assembly de chill pill\", 54, 56, 1], [\"BCK PNL LWR 110 Assembly inner Welder\", 58, 61, 1], [\"BCK PNL LWR 120 Assembly inner Assembly foams\", 43, 44, 1], [\"BCK PNL LWR 120 Assembly inner Final inspection\", 69, 71, 1]], \"sup\": \"-\"}, {\"t\": \"Cabina spray · Upper\", \"sh\": \"Cabina UPP\", \"box\": \"spr\", \"nt\": \"\", \"takt\": 129, \"day\": 300, \"by\": \"ERIK O.\", \"date\": \"2 sep\", \"ops\": [[\"Esprayeo sustraro\", 46, 50, 1], [\"Esprayeo cover\", 42, 45, 1], [\"Eprayeo spacer\", 25, 26, 1]], \"sup\": \"Antonio\"}, {\"t\": \"Cabina spray · Armrest\", \"sh\": \"Cabina AR\", \"box\": \"spr\", \"nt\": \"\", \"takt\": 202.5, \"day\": 200, \"by\": \"ERIK O.\", \"date\": \"2 sep\", \"ops\": [[\"Esprayeo sustraro\", 46, 50, 1], [\"Esprayeo cover\", 35, 36, 1]], \"sup\": \"Antonio\"}, {\"t\": \"Cabina spray · Insertos\", \"sh\": \"Cabina insertos\", \"box\": \"spr\", \"nt\": \"\", \"takt\": 270, \"day\": 300, \"by\": \"ERIK O.\", \"date\": \"2 sep\", \"ops\": [[\"Esprayeo sustraro\", 40, 43, 1], [\"Esprayeo cover\", 35, 36, 1], [\"Esprayeo spacer\", 25, 26, 1]], \"sup\": \"Antonio\"}, {\"t\": \"Cabina spray · Back panel\", \"sh\": \"Cabina Back panel\", \"box\": \"spr\", \"nt\": \"\", \"takt\": 270, \"day\": 300, \"by\": \"ERIK O.\", \"date\": \"2 sep\", \"ops\": [[\"Esprayeo sustrato\", 40, 43, 1], [\"Esprayeo cover\", 35, 36, 1]], \"sup\": \"Antonio\"}], \"tesla\": [{\"t\": \"Side rail · LH\", \"sh\": \"SIDE R LH\", \"box\": \"fSR\", \"nt\": \"\", \"takt\": 202.5, \"day\": 200, \"by\": \"KEVIN P.\", \"date\": \"16 abr\", \"ops\": [[\"Esprayeo sustrato\", 57, 60, 1], [\"Esprayeo tela\", 54, 62, 1], [\"Forrado manual\", 87, 90.5, 2], [\"Hot press\", 36, 36, 1], [\"Corte con laser\", 88, 92, 1], [\"Corte de excedentes\", 72, 79, 1], [\"Ensamble bezel\", 53, 59, 1], [\"Ensamble componentes\", 95, 107, 1], [\"Inspeccion\", 74, 82, 1]], \"sup\": \"-\"}, {\"t\": \"Side rail · RH\", \"sh\": \"SIDE R RH\", \"box\": \"fSR\", \"nt\": \"Hoja \\\"SIDE R RH (2)\\\" es copia\", \"takt\": 202.5, \"day\": 200, \"by\": \"KEVIN P.\", \"date\": \"16 abr\", \"ops\": [[\"Esprayeo sustrato\", 57, 60, 1], [\"Esprayeo tela\", 54, 62, 1], [\"Forrado manual\", 72, 75.5, 2], [\"Hot press\", 40, 40, 1], [\"Corte con laser\", 104, 107, 1], [\"Corte de excedentes\", 73, 79, 1], [\"Ensamble bezel\", 60, 64, 1], [\"Ensamble componentes\", 108, 150, 1], [\"Inspeccion\", 73, 85, 1]], \"sup\": \"-\"}, {\"t\": \"Front header\", \"sh\": \"FRONT H.\", \"box\": \"fFH\", \"nt\": \"REAR H. es idéntica: el rear header no tiene estudio propio (y usa roll coater, no spray)\", \"takt\": 202.5, \"day\": 200, \"by\": \"KEVIN P.\", \"date\": \"16 abr\", \"ops\": [[\"Esprayeo sustrato\", 57, 60, 1], [\"Esprayeo tela\", 54, 62, 1], [\"Forrado manual\", 169, 174.7, 3], [\"Horno\", 60, 60, 5], [\"Bonding\", 88, 94, 1], [\"Corte con laser\", 79, 86, 1], [\"Corte excedentes\", 59, 67, 1], [\"Ensamble OHC\", 64, 70, 1], [\"Ensamble componentes\", 58, 62, 1]], \"sup\": \"-\"}]};\nconst CMP={rivian:[['spr','25–52 s','Spacer upper 52 s en la hoja de puerta; 25 s en la hoja de cabina'],['spcU','211 s','Manual wrapping, 1 estación (door upper FR LH). Wrap closed 198 s'],['prU','63 s','Hot press'],['inU','20 s','Inspección'],\n ['alA','97 s','Forrado armrest, 2 estaciones (hoja de puerta). No hay estudio del alineado'],['prA','88 s','Edge wrapping'],['inA','110 s','Inspección'],['cmA','121 s','Subensamble de armrest'],\n ['spcI','153 s','Est. 60 aligned; est. 70 wrapping 134 s'],['wrI','122 s','Est. 90 hot press. El archivo dice 112 por una lectura de 16 s'],['iI','119 s','Est. 100 inspección'],['wcI','—','Sin estudio'],\n ['asy','124–131 s','Pre ensamble 131 (REAR LH) · clips A/B 123–130 · soldadora 87'],['dqmc','121 s','DQMC visión e inspección 200% · empaque 118'],['bp','73 / 69 s','Upper: est. 100/110 ensamble de componentes (máx. 86, arriba de takt 72). Lower: est. 120 inspección final'],\n ['deco','—','Sin estudio'],['dqI','—','Sin estudio'],['sew','—','Sin estudio'],['imm','—','Sin estudio'],['cut','—','Sin estudio']],\n tesla:[['spr','54–57 s','Esprayeo sustrato 57 · tela 54'],['fSR','72–87 s','Forrado manual, 2 estaciones (RH 72 · LH 87)'],['bSR','36–40 s','Hot press'],['lSR','88–104 s','Corte láser (excedente 72–73)'],['cSR','95–108 s','Ensamble de componentes (bezel 53–60)'],['iSR','73–74 s','Inspección'],\n ['fFH','169 s','Forrado manual, 3 estaciones (horno 60 s, 5 estaciones)'],['bFH','88 s','Bonding'],['lFH','79 s','Láser (excedente 59)'],['cFH','64 s','Ensamble OHC (componentes 58)'],['iFH','—','Sin estudio'],\n ['rc','—','Sin estudio: la hoja REAR H. dice spray, pero el rear header va por roll coater'],['fRH','169 s*','*Copia de front header'],['bRH','88 s*','*Copia de front header'],['lRH','79 s*','*Copia de front header'],['cRH','64 s*','*Copia de front header'],\n ['bCR','—','Sin estudio (cantrail Everest)'],['dqR','—','Sin estudio']]};\nconst CTWARN={rivian:['De 188 series de 10 lecturas, solo 79 son diferentes: el 58% se repite entre hojas.','Las 4 hojas de puerta completa son casi idénticas (cambian 3 lecturas). Las hojas de inserto FR LH, FR RH y RR LH son idénticas.','Las mismas 10 lecturas aparecen en operaciones distintas: wrap closed de inserto = ensamble bezel de side rail; plasma de back panel = esprayeo de sustrato de cabina; el spray de door upper = cabina de insertos.','Inserto RR RH es la hoja de door upper con renglones movidos (spray, hot press 63 e inspección 20 son los de door upper), y \"aligned\" = \"manual wrapping\".','Clips cara A y B (REAR LH): 10 lecturas de 130 s exactos. Una operación manual no da cero variación.','Hot press de inserto: una lectura de 16 s entre lecturas de ~120 s (dedo). Baja el promedio a 112.','Cada hoja usa otra demanda: 625/día (door upper), 300 (puerta completa), 1,125 (back panel). El VSM usa 2,400 puertas/día: 600 por línea, takt ~135 s por línea.'],\n tesla:['Estudios del 16 abr: 6 meses de antigüedad y antes de reorganizar toldos.','REAR H. es copia exacta de FRONT H.: el rear header no tiene estudio propio, y la hoja dice spray cuando el rear header va por roll coater.','\"SIDE R RH (2)\" es copia de \"SIDE R RH\".','Demanda en las hojas: 200/día, 6 días, 1 turno (takt 202.5 s). Falta confirmarla contra la demanda real de Rivian y Tesla.','Cantrail Everest, inspección de front/rear header y DQMC de toldos no tienen estudio.']};\nconst STREAMS={\n rivian:{name:'Rivian',prod:'Door Panel',unit:'door panels',color:C.mat,col:'proc',par:'params',sub:'door panels + inserts',\n  eyebrow:'<b>DAIMAY × RIVIAN</b> · Planta 4 · Door Panel · P1 · P4 · P7',\n  procs:[\n   {id:'imm',n:['Inyección','sustratos'],pl:'P1 · P4 · P7',k:'imm',c:1,r:0,after:'inv',d:{co:180},res:'Sustratos por planta. P1: back panel upper, tapa del lower, inserto, bracket de soldadura, cover map (tapa de puerta frontal). P4: sustrato de upper, otra parte del lower, armrest. El armrest se inyecta en P4, va a P7 por foam y regresa.'},\n   {id:'sew',n:['Costura','unión + decorativa'],pl:'P4',lines:20,k:'sew',c:1,r:1,after:'inv',d:{},res:'Células de costura de unión y decorativa: ~6 mesas de inserto, ~7 de armrest y ~7 de door upper (~20 mesas), con 2 estaciones de inspección para toda el área. Sin control de WIP y con desorden de 5S. Causa recurrente en tableros: contención de costura y costura abierta (H6).',flag:'Sin control de WIP ni 5S. Falta C/T y ops por célula.'},\n   {id:'cut',n:['Laminado + corte','spacers · vinil'],pl:'P4',k:'cut',c:1,r:2,after:'inv',d:{co:5},res:'Laminado en P4: alimenta a spray los spacers (piezas blancas) y los cortes de vinil'},\n   {id:'spr',below:1,n:['Spray adhesivo','12 cabinas · 1 op c/u'],pl:'P4',lines:12,k:'spray',c:2,r:1,after:'inv',d:{co:0},res:'12 cabinas dedicadas por componente: vinil upper, upper LH RH, spacer, spacer inserto ×2, inserto vinil, inserto vinil + sustrato, vinil + sustrato, door panel armrest, vinil (faltan 2). Meta 117/h por cabina. Banda con ventiladores para secar sustrato y armrest.',flag:'Secado ~30 min, gramaje y peso sin documentar. WIP de 20 a 60 pz según la pieza.'},\n   {id:'spcU',n:['Línea upper','est. 110–140 · 5 ops'],pl:'FR/RR · LH/RH',lines:4,k:'align',c:3,r:0,after:'inv',d:{},res:'4 líneas espejo (FR LH, FR RH, RR LH, RR RH) con estaciones 110, 110, 120, 140, 140: alineado + spacer y forrado (wrap 1–2). 5 ops por línea (FR RH 6). Meta 29/h. LH y RH son piezas distintas (carril izquierdo = piezas izquierdas)',flag:'Forrado/cerrado lento, igual que en inserto. Sin trabajo estándar.'},\n   {id:'prU',n:['Prensa bonding','upper'],pl:'FR/RR · LH/RH',lines:4,k:'press',c:4,r:0,after:'inv',d:{},res:'Prensa bonding (edge wrapping), una por posición. LH y RH son piezas distintas (carril izquierdo = piezas izquierdas)'},\n   {id:'inU',n:['Inspección 150','upper · + retrabajo'],pl:'FR · RR',lines:2,k:'press',c:5,r:0,after:'inv',d:{},res:'Estación 150: una mesa de inspección para los dos traseros y otra para los dos delanteros, con mesa de retrabajo al mismo nivel. Después: área de cages con carrier main door y piezas variadas.'},\n   {id:'alA',n:['Línea armrest','est. 110–140 · 5 ops'],pl:'FR/RR · LH/RH',lines:4,k:'align',c:3,r:1,after:'inv',d:{},res:'4 líneas espejo (FR LH, FR RH, RR LH, RR RH) con estaciones 110, 120, 130, 140: alineado, wrapping manual y cerrado. 5 ops por línea (RR RH 4). Meta 29/h. El process map marca el alineado como cuello y los tableros lo confirman (flujo lento en alineado). LH y RH son piezas distintas (carril izquierdo = piezas izquierdas)',flag:'Forrado/cerrado lento, igual que en inserto. Sin trabajo estándar.'},\n   {id:'prA',n:['Máquina de vacío','armrest · prensa'],pl:'FR · RR',lines:2,k:'press',c:4,r:1,after:'inv',d:{},res:'Máquina de vacío tipo prensa, una frontal y una trasera.'},\n   {id:'inA',n:['Inspección','armrest · + retrabajo'],pl:'FR/RR · LH/RH',lines:4,k:'press',c:5,r:1,after:'inv',d:{},res:'Inspección por mesa espejo. ~100 piezas por turno van a la mesa de retrabajo. Scrap ~10 por línea por turno (~40), sin dato confiable.'},\n   {id:'cmA',n:['Ens. componentes','armrest · + inspección'],pl:'FR · RR',lines:2,k:'asy',c:6,r:1,after:'inv',d:{},res:'Mesa de ensamble de componentes frontal y trasera; ahí mismo se inspecciona LH y RH. Después: área de canastillas y KDs con ~50 armrest y ~50 door opener, y otro WIP de ~50 más antes de ensamble.'},\n   {id:'spcI',n:['Línea inserto','est. 50–80 · 7 ops'],pl:'FR/RR · LH/RH',lines:4,k:'align',c:3,r:2,after:'inv',d:{},res:'4 líneas espejo con estaciones 50, 60, 60, 70, 70, 70, 80: 7 personas por línea (confirmado; el tablero dice 5). El inserto sale en cajas independientes, no va en la puerta. Alineado + spacer, wrapping y cerrado. Meta 30/h por línea. Est. 50 va muy rápido y acumula mucho spacer y sustrato; alineado 3–4 pz; la est. 70 (forrado/cerrado, 3 personas) es el cuello y la Blader 170 espera material. LH y RH son piezas distintas (carril izquierdo = piezas izquierdas)',flag:'Cuello en est. 70 (forrado/cerrado). Sin hojas de operación estándar.'},\n   {id:'wrI',n:['Blader 170','insert · bonding'],pl:'FR/RR · LH/RH',lines:4,k:'press',c:4,r:2,after:'inv',d:{},res:'Máquina Blader, estación 170: tipo bonding de spacer, entran dos pares de piezas por ciclo.'},\n   {id:'wcI',n:['Clip y felpa','insert'],pl:'FR/RR · LH/RH',lines:4,k:'asy',c:5,r:2,after:'inv',d:{},res:'Inserción de clip y felpa. Después: mucho WIP antes de la línea 100.'},\n   {id:'iI',n:['Línea inserto 100','insp. · ens. · etiqueta'],pl:'FR · RR · LH/RH',lines:4,k:'press',c:6,r:2,after:'inv',d:{},res:'Estación 100: inspección, ensamble y etiquetado, LH y RH, espejo frontal y trasero. Después: más WIP.'},\n   {id:'car',n:['Carriers',''],pl:'P1',k:'buy',c:1,r:3,after:'inv',d:{},res:'Producidos en P1 · viajan a P4'},\n   {id:'poc',n:['Pockets','crash pads, etc.'],pl:'P4',k:'buy',c:2,r:3,after:'inv',d:{},res:'Producidos en P4'},\n   {id:'deco',n:['Línea de deco','forrado · prensa · lámpara'],pl:'P4 · FR/RR · LH/RH',lines:4,k:'wrapm',c:3,r:3,after:'inv',d:{},res:'Est. 120–140: forrado manual (4 operaciones) → prensa (una FR, una RR, la ponen en spacer) → inspección (RR) → área grande de WIP de deco forrado → est. 145.5 RR / 170 FR: ensamble de lámpara LH/RH en una mesa, con rack de ~2 m de lámparas de varios modelos. 2 ops por línea, meta 24/h; el 15 oct las 4 líneas iban a meta o arriba. Junto a la prensa FR está la mesa de retrabajo de inserto.',flag:'Arreglo físico por confirmar con el layout de Genet.'},\n   {id:'ven',n:['Comprados','flashlight · luces · arneses'],pl:'Vendors',k:'buy',c:4,r:3,after:'inv',d:{},res:'Flashlight, luces, switches, latches, arneses, clips'},\n   {id:'bp',n:['Back panel','upper + lower'],pl:'P4',k:'asy',c:9,r:3,after:'inv',d:{},res:'Upper: 70 cerrado → 80 inspección de cerrado → 90 prensa (bonding) → 100 inspección de prensa → 110 ensamble de componentes → 120 inspección final. Lower: 110 soldadora → 120 inspección. Mesa de retrabajo informal para upper y lower que regresan de DQMC. Cabina de spray propia: est. 40 adhesivo a sustrato y est. 50 adhesivo a cover (BCK PNL UPR). Después: área de WIP.',flag:'Va a DQMC (confirmado). Falta el flujo exacto.'},\n   {id:'seq',n:['Rack secuencia','Fr LH · Fr RH · Rr LH · Rr RH'],pl:'P4',k:'rack',c:7,r:3,after:'none',d:{},res:'Secuencia por puerta (draft V1)'},\n   {id:'asy',n:['Ensamble','door panel · 4 líneas'],pl:'P4 · Fr/Rr LH/RH',lines:4,k:'asy',c:8,r:1,after:'inv',d:{co:0},res:'Una línea por posición: FR LH (carrusel), FR RH, RR LH, RR RH. Secuencia (espejo LH/RH): subensamble → soldadora (FR: est. 190) → componentes cara B → cara A (FR: est. 200) → inspección (FR: est. 210) → WIP de carritos (~20 puertas) → DQMC.'},\n   {id:'dqmc',n:['DQMC','+ empaque · 4 mesas'],pl:'P4 · Fr/Rr LH/RH',lines:4,k:'dqmc',c:9,r:1,after:'inv',d:{co:0,defLo:25,defHi:40},res:'Una mesa por posición con cámara de visión (~90 s), 3 ops por mesa, empaque en la misma mesa'},\n   {id:'sh',n:['Embarque','door panel'],pl:'P4',k:'ship',c:10,r:1,after:'none',d:{},res:'Etiquetas · SH number / ASN'},\n   {id:'dqI',n:['DQMC inserts','+ empaque · 2 mesas'],pl:'P4 · FRT y RR',lines:2,k:'dqmc',c:9,r:2,after:'inv',d:{},res:'Inserto FRT e inserto RR, 1 operador por mesa · 15 cajas por pallet'},\n   {id:'shI',n:['Embarque','inserts'],pl:'P4',k:'ship',c:10,r:2,after:'none',d:{},res:'Boxed inserts a Rivian · camión de 26 pallets'}],\n  edges:[['mp','imm'],['mp','sew'],['mp','cut'],['imm','spr'],['sew','spr'],['cut','spr'],['spr','spcU'],['spr','deco'],['spr','alA'],['spr','spcI'],\n   ['spcU','prU'],['prU','inU'],['alA','prA'],['prA','inA'],['inA','cmA'],['spcI','wrI'],['wrI','wcI'],\n   ['inU','asy'],['cmA','asy'],['wcI','iI'],['iI','dqI'],['car','seq','under'],['poc','seq','under'],['deco','seq','under'],['ven','seq'],['seq','asy'],\n   ['asy','dqmc'],['dqmc','sh'],['dqI','shI']],\n  routes:{U:{n:'Upper',p:['imm','spr','spcU','prU','inU','asy','dqmc','sh'],mp:1},A:{n:'Armrest',p:['imm','spr','alA','prA','inA','cmA','asy','dqmc','sh'],mp:1},\n   I:{n:'Insert',p:['imm','spr','spcI','wrI','wcI','iI','dqI','shI'],mp:1},B:{n:'Compradas',p:['car','seq','asy','dqmc','sh'],mp:0}},\n  walk:['sh','shI','dqmc','dqI','asy','seq','cmA','iI','bp','inA','inU','prA','wcI','ven','deco','poc','car','prU','wrI','spcU','alA','spcI','spr','sew','cut','imm'],\n  ext:[\n   {pl:'P1',pz:'Sustrato de inserto',dir:'P1 → P4',to:'Spray · cabina inserto vinil + sustrato → línea inserto',st:'Confirmado (P1 lo surte)',f:'Frecuencia, lote, tránsito'},\n   {pl:'P1',pz:'Sustrato back panel upper',dir:'P1 → P4',to:'Back panel upper · cabina propia est. 40',st:'Confirmado (P1 lo surte)',f:'Frecuencia, lote, tránsito'},\n   {pl:'P1',pz:'Tapa del lower',dir:'P1 → P4',to:'Back panel lower',st:'Destino por confirmar',f:'Punto de entrada, frecuencia, lote'},\n   {pl:'P1',pz:'Bracket de soldadura',dir:'P1 → P4',to:'Soldadora · ¿ensamble (est. 190) o back panel lower (110)?',st:'Destino por confirmar',f:'Destino, frecuencia, lote'},\n   {pl:'P1',pz:'Cover map (tapa puerta frontal)',dir:'P1 → P4',to:'Ensamble',st:'Destino por confirmar',f:'Frecuencia, lote, tránsito'},\n   {pl:'P1',pz:'Carriers',dir:'P1 → P4',to:'Rack de secuencia → ensamble',st:'Confirmado',f:'Frecuencia, lote, tránsito'},\n   {pl:'P7',pz:'Sustrato de armrest',dir:'P4 → P7',to:'Sale de inyección P4',st:'Confirmado',f:'Frecuencia, lote, tránsito'},\n   {pl:'P7',pz:'Armrest con foam',dir:'P7 → P4',to:'Spray · cabina door panel armrest → línea armrest',st:'Confirmado (regresa a P4)',f:'Frecuencia, lote, WIP en P7, tránsito'}],\n  rw:[\n   {at:'sew',n:'Inspección de costura',q:'sin registro',d:'2 estaciones de inspección para ~20 mesas. No se registra rechazo; la costura abierta llega a upper y armrest (H6).'},\n   {at:'inU',n:'Retrabajo door upper',q:'~50 pz en mesa',d:'Mesa de retrabajo en est. 150, FR y RR, LH y RH. Hundimiento, arruga y despegue regresan a la mesa y se reinspeccionan.'},\n   {at:'inA',n:'Retrabajo armrest',q:'~100 pz/turno',d:'Mesa de retrabajo después de inspección. ~10% de la producción, más ~40 de scrap por turno. Sin registro.'},\n   {at:'asy',n:'Retrabajo ensamble',q:'2 canastillas · sin etiqueta',d:'Canastillas desbordadas de carriers, map pockets, armrests y componentes sin estatus (rojo/amarillo/verde). Puertas en carros sin identificar.'},\n   {at:'dqmc',n:'Rechazo DQMC puertas',q:'40–50% · ~600/turno',d:'Cada mesa inspecciona ~300 puertas por turno y rechaza 40–50%. La puerta regresa a retrabajo y vuelve a pasar por DQMC.'},\n   {at:'dqI',n:'Retrabajo inserto',q:'140–200 pz/turno',d:'Mesa junto a la prensa de deco FR. Llega un carrito o carrito y medio por turno desde DQMC inserts. Sin hora por hora ni checklist.'},\n   {at:'bp',n:'Retrabajo back panel',q:'informal · sin registro',d:'Mesa no formalizada para upper y lower que regresan de DQMC.'}],\n  revKick:'Rojo y ámbar = hallazgos con datos de piso · verde H = hipótesis por probar · violeta = pendientes del draft V1 (D. Hardtmann)',\n  review:[\n   ['r','Rechazo DQMC','Cada mesa inspecciona ~300 puertas por turno y rechaza 40–50%. Hay horas completas de reinspección: la misma puerta pasa dos veces y se come la capacidad.'],\n   ['r','Ensamble espera','Las 4 líneas de ensamble llegaron a 217–231 de 286 a las 17:00 (76–81%) con scrap 0. Perdieron 124–197 min cada una (~10 h entre las 4) esperando upper, deco, flashlight, descansabrazos o carros y cajas. Ensamble no es el cuello: no le llega material.'],\n   ['r','Upper','El upper aparece en todos lados: falta y flujo lento en ensamble RR, \"upper mal liberado\" por calidad, y el hundimiento en door upper como defecto principal de DQMC.'],\n   ['a','Carros y empaque','Ensamble, back panel y DQMC reportan paros por falta de carros, cajas o bolsas. Es el quick win más barato del mapa.'],\n   ['a','Back panel','Upper (8 ops) y lower (4 ops), meta 50/h: 383 y 406 de 495 a las 17:00 (77–82%). Pierden ~135–140 min por turno por flujo lento de personal, retrabajo de adhesivo y falta de carros.'],\n   ['r','Inspecciones','El back panel upper pasa por 3 inspecciones (80, 100, 120), el lower por 1, y después por DQMC; aun así regresan piezas de DQMC a una mesa de retrabajo informal. Más inspección no está deteniendo el defecto: se detecta, no se previene. La mesa informal no tiene trazabilidad (control de producto no conforme).'],\n   ['a','Inserto 15 oct','A las 13:00: FR RH 351 de 374 (corre 2 salidas, meta 60/h), FR LH 161 de 187, RR RH 163 de 187; RR LH sin trabajar (\"No work\") porque FR RH corre doble por requerimiento. Causas: transporte tarde (alineador 35 min tarde), operador no titular, falta 1 cerrador. Las líneas tienen capacidad de sobra: el inserto no es la restricción.'],\n   ['r','Sobreproducción de inserto','El inserto sale en cajas independientes. Las 4 líneas tienen meta 30/h (~1,300 por turno con las 4 corriendo) y DQMC inserts procesa ~800 al día. Aunque hoy corren 3 líneas, se produce ~2–3× lo que se inspecciona y empaca: de ahí los 700–800 sustratos de inserto, el WIP antes y después de la línea 100, y que una línea quede en \"No work\". Hay que saber la demanda real de Rivian por número de parte.'],\n   ['a','Personal','En inserto, 2 de 3 líneas arrancaron tarde por transporte o con operador no titular, y a RR RH le faltó un cerrador toda la mañana. Son 7 personas por línea (confirmado) y el tablero dice 5: la productividad se calcula con 2 personas menos por línea.'],\n   ['a','Inserto','Meta 800/día, ~600 buenas y ~200 malas (25%), paros por empaque. Caja de 7 piezas por confirmar. Los 26 pallets son la capacidad del camión, no la producción.'],\n   ['b','Demanda y takt','4 posiciones × 300 puertas/turno × 2 = 2,400/día. Con 22.5 h netas el takt es ~34 s por puerta y ~135 s por línea. Ensamble planea 28/h (~129 s): va justo contra el takt, sin margen para paros.'],\n   ['h','H1','La restricción real del door panel está en la fabricación del upper, no en ensamble ni en DQMC: todo lo que viene después espera upper. Las 4 líneas de upper corren a meta 29/h (~326 por turno) contra 300 de demanda: no hay margen para reponer el rechazo de DQMC. El armrest tiene la misma meta y hoy va peor (76% contra 93%): la restricción son los dos componentes, no solo el upper.'],\n   ['r','Upper 15 oct','A las 13:00: FR LH 218 (+36, 5 ops), FR RH 151 (−31, 6 ops), RR LH 157 (−25), RR RH ~149 (−33): 675 de 728 (93%), scrap 15. Dos líneas espejo, una +36 y otra −31 con un operador más: el problema es método y balanceo, no máquina.'],\n   ['r','Armrest 15 oct','A las 13:00 (meta 182): FR LH 125 (−57), FR RH 142 (−40), RR LH 124 (−58), RR RH 161 (−21, con 4 ops): 552 de 728 (76%). Hoy el armrest va peor que el upper (93%). ~100 piezas por turno a retrabajo (~10%) y ~40 de scrap.'],\n   ['h','H6','Costura es una causa raíz escondida: contención de costura en upper FR RH y RR RH, y vinil con costura abierta en armrest RR LH toda la mañana. Nadie ha recorrido costura todavía.'],\n   ['a','Causas en armrest','Flujo lento en alineado (FR LH, RR RH), paro por falta de sustrato (FR RH, RR LH) y vinil con costura abierta (RR LH). El sustrato del armrest es el que va a P7 por foam y regresa: el loop externo es candidato al faltante.'],\n   ['a','Causas en upper','Las causas que llegan de antes: contención de costura (FR RH y RR RH), vinil con defecto y 20 min sin spreado. Las demás dicen \"ineficiencia de línea\" o \"falta de eficiencia de personal\": no son causas, son etiquetas. El tablero de RR RH además no cuadra la suma.'],\n   ['h','H2','El hundimiento en door upper alimenta un ciclo: rechazo en DQMC → reinspección → menos capacidad → más faltante de upper. Cerrar el DMAIC de hundimiento libera capacidad en dos lugares.'],\n   ['h','H3','La falta de carros, cajas y bolsas no es falta de compra: falta un sistema de surtido (kanban de contenedores y empaque).'],\n   ['h','H4','Se registra hora por hora pero no se suma: nadie ve que las 4 líneas de ensamble pierden ~10 h de capacidad por turno esperando material.'],\n   ['v','Rechazo vs ETL','El draft decía 25–40%; en piso es 40–50%. En el ETL de DQMC traemos 9.86% → 17.23% (mar–jul): reconciliar definiciones antes de presentar.'],\n   ['v','Estructura','Upper, armrest e insert se reorganizaron con el process map de Genet (15 oct): spray compartido → spacer/alineado → forrado/wrap → prensa/inspección. Armrest (confirmado por Genet): wrapping manual → cerrado → prensa → inspección → ensamble. Carril izquierdo = piezas LH, derecho = piezas RH.'],\n   ['r','Spray','12 cabinas, todas con meta 117/h sin importar la pieza. Las de upper van a meta (720–750 de 726 a las 13:00), pero la línea RR RH reportó 20 min de faltante de spreado el 15 oct: la capacidad alcanza, la asignación por cabina no. Las de spacer inserto quedan en 550–654. Scrap 0 en todas, pero el secado (~30 min) y el gramaje no se controlan.'],\n   ['h','H5','El hundimiento del upper y la burbuja/desprendimiento del inserto nacen en spray (gramaje y tiempo de secado) y se detectan 4–5 operaciones después, en DQMC. Medir peso antes/después y hora de spray por rack para correlacionar con el rechazo.'],\n   ['r','Meta de spray','Cada upper y cada inserto llevan 1 spacer. Upper: 1,200 por turno contra 1 cabina de spacer a 1,280, cuadra. Inserto (sale en cajas, no va en la puerta): DQMC inserts procesa ~800/día (~400 por turno) y las 2 cabinas de spacer inserto pueden dar 2,560 por turno: ~6× lo que se empaca. La meta de 117/h se copió igual a todas las cabinas y empuja a sobreproducir.'],\n   ['r','Inventario antes de spray','Estimado visual: ~300 cortes por tipo y color, ≥100 sustratos por tipo, ~500 deco trim y 700–800 sustratos de inserto. Inserto equivale a ~1 día de su demanda (800/día); el mapa lo divide entre 2,400, así que el lead time de la ruta Insert sale corto.'],\n   ['a','Cabinas','1 operador por cabina (12) y cada uno sprea lo que toque: spacer, vinil o plástico. 2 cabinas sin saber qué corren. No hay asignación fija ni programa por cabina.'],\n   ['a','Tableros','Varios tableros de spray tienen fecha vieja (8 oct, septiembre), uno suma vinil + sustrato y reporta 2× la meta, y otro dice \"No hay bono\". El tablero no se usa para gestionar.'],\n   ['h','H7','El cuello dentro de las 3 líneas de componente (upper, armrest e inserto) es el forrado/cerrado, no el alineado: en inserto la est. 50 sobreproduce, el alineado tiene 3–4 pz y la est. 70 frena todo. Ninguna estación tiene hoja de operación estándar. Validar con yamazumi; los tableros de armrest culpan al alineado.'],\n   ['r','Trabajo estándar','No hay hojas de operación estándar (HOE/ODS) en forrado/cerrado de upper, armrest e inserto. Sin estándar no hay balanceo posible: explica que líneas espejo den resultados opuestos con la misma gente.'],\n   ['r','Retrabajo de inserto','La mesa de retrabajo de inserto (junto a la prensa de deco FR) recibe 140–200 piezas por turno, un carrito o carrito y medio. No hay hora por hora, checklist ni registro: es el mismo ~25% de malas de DQMC inserts, retrabajado sin trazabilidad.'],\n   ['a','Deco no es el cuello','Las 4 líneas de deco iban a meta o arriba el 15 oct (175–180 de 174 a las 14:00, 2 ops cada una). Si ensamble paró por falta de deco el 14 oct, el problema es surtido o secuencia, no capacidad.'],\n   ['a','FIFO vencido','Cajas de componentes en piso con etiquetas FIFO de la semana 33 a la 42: material de hasta 9 semanas. Hay racks con letrero máx./mín. (armrest máx. 40, deco máx. 140), pero sin control de que se respete.'],\n   ['a','Cabina back panel','La cabina de spray de back panel upper (est. 40 y 50) tiene adhesivo acumulado en paredes, techo y mesa: sin limpieza ni mantenimiento. Riesgo de contaminación de pieza y de seguridad.'],\n   ['r','Conteo 16 oct','Conteo de WIP sin producción (viernes): ~1,120 piezas antes de spray, ~1,510 spreadas esperando sin hora (inserto ~920), ~600 en deco, ~640 componentes antes de ensamble, ~2,800 comprados en soldadoras y solo ~75 puertas al final. Montañas al inicio y casi nada al final: firma de un sistema push.'],\n   ['r','Secado sin control','El estándar FM-SOP-0031-DR dice 35 min de secado (−10). Las tarjetas en piso son de agosto, julio o están vacías; ~1,510 piezas con adhesivo sin hora. El control existe y está firmado, pero no se usa: hallazgo directo para IATF y para el DMAIC de hundimiento.'],\n   ['r','Producto no conforme','Puertas en carros sin estatus antes de DQMC, canastillas de retrabajo desbordadas sin etiqueta, retrabajo de inserto y back panel sin registro, cajas \"material libre\" mezcladas con cajas sin etiqueta y piezas master de calidad sucias. Contención inmediata: etiquetado rojo/amarillo/verde, jaula de retenido y hoja de registro en cada mesa de retrabajo.'],\n   ['a','Material mal identificado','~800 flashlight en soldadoras y ~400 armrest/upper antes de ensamble, pero ensamble paró por falta de ellos el 14 oct. El faltante es de identificación, surtido y secuencia, no de cantidad.'],\n   ['a','Alineación','El process map marca la alineación como cuello en los tres componentes: es una operación muy difícil y depende de identificar a los mejores operadores.'],\n   ['v','Fuera del mapa','Back panel mapeado el 15 oct; falta saber a dónde va. El heat staking del draft es la soldadora 190 dentro de ensamble (confirmado con fotos el 15 oct).'],\n   ['a','Soldadora 190','Entre 190, 200 y 210 solo hay 1–2 puertas: ensamble espera material, no lo acumula. Las soldadoras son propiedad de Rivian y la tarjeta viajera pegada en la máquina dice DRAFT: revisar que la ayuda visual y el plan de control estén liberados.'],\n   ['v','Draft V1','Confirmado: el armrest va a P7 para inyectarle foam (loop P4 → P7 → P4). Falta en qué punto de la secuencia sale y regresa, y si el kanban opera hoy.']]},\n tesla:{name:'Toldos',prod:'Headliner',unit:'toldos',cust:'Rivian · Tesla',color:C.tesla,col:'procT',par:'paramsT',sub:'Rivian + Everest',\n  eyebrow:'<b style=\"color:#ff6b5a\">DAIMAY × RIVIAN · TESLA</b> · Planta 4 · Toldos (headliner)',\n  procs:[\n   {id:'spr',n:['Spray adhesivo','manual + automática'],pl:'P4',k:'spray',c:1,r:1,after:'inv',d:{},res:'Cabinas de adhesivo manuales y máquina de spray automática, con hornos de secado. Al lado, racks de WIP de sustrato (front/rear header, cantrail) y WIP de tela por pieza, separada Rivian / Everest. El head frontal lleva primer.'},\n   {id:'rc',n:['Roll coater','rear header'],pl:'P4',k:'spray',c:1,r:2,after:'inv',d:{},res:'El rear header (trasero) recibe el adhesivo en roll coater, no en spray.'},\n   {id:'fSR',n:['Formado manual','side rail L / R'],pl:'P4 · LH/RH',lines:2,k:'form',c:2,r:0,after:'inv',d:{},res:'Formado (wrapping) manual de side rail, una estación LH y una RH.'},\n   {id:'bSR',n:['Bonding','side rail'],pl:'P4 · LH/RH',lines:2,k:'press',c:3,r:0,after:'inv',d:{},res:'Prensa bonding de side rail.'},\n   {id:'lSR',n:['Láser + excedente','side rail'],pl:'P4 · LH/RH',lines:2,k:'trim',c:4,r:0,after:'inv',d:{},res:'Corte láser y retiro de excedente.'},\n   {id:'cSR',n:['Bezel + componentes','side rail'],pl:'P4 · LH/RH',lines:2,k:'asy',c:5,r:0,after:'inv',d:{},res:'Colocación de bezel y componentes.'},\n   {id:'iSR',n:['Inspección','side rail'],pl:'P4 · LH/RH',lines:2,k:'press',c:6,r:0,after:'inv',d:{},res:'Inspección de side rail LH y RH antes de DQMC.'},\n   {id:'fFH',n:['Formado + horno','front header'],pl:'P4',k:'form',c:2,r:1,after:'inv',d:{},res:'Head frontal con primer: formado manual con horno (va y viene entre formado y horno).'},\n   {id:'bFH',n:['Bonding','front header'],pl:'P4',k:'press',c:3,r:1,after:'inv',d:{},res:'Prensa bonding de front header.'},\n   {id:'lFH',n:['Láser + excedente','front header'],pl:'P4',k:'trim',c:4,r:1,after:'inv',d:{},res:'Corte láser y retiro de excedente.'},\n   {id:'cFH',n:['Comp. + lámpara','front header'],pl:'P4',k:'asy',c:5,r:1,after:'inv',d:{},res:'Componentes y lámpara (map light). El DWG agrega clips y speaker grill con soldadura ultrasónica.'},\n   {id:'iFH',n:['Inspección','front header'],pl:'P4',k:'press',c:6,r:1,after:'inv',d:{},res:'Inspección de front header antes de DQMC.'},\n   {id:'fRH',n:['Formado manual','rear header'],pl:'P4',k:'form',c:2,r:2,after:'inv',d:{},res:'Formado manual de rear header (sale de roll coater).'},\n   {id:'bRH',n:['Bonding','rear header'],pl:'P4',k:'press',c:3,r:2,after:'inv',d:{},res:'Prensa bonding de rear header. El DWG muestra además un robot doghouse.'},\n   {id:'lRH',n:['Excedente + láser','rear header'],pl:'P4',k:'trim',c:4,r:2,after:'inv',d:{},res:'Retiro de excedente y corte láser.'},\n   {id:'cRH',n:['Bracket · NVH · clip','rear header'],pl:'P4',k:'asy',c:5,r:2,after:'inv',d:{},res:'Bracket, NVH / foam y clips.'},\n   {id:'iRH',n:['Inspección','rear header'],pl:'P4',k:'press',c:6,r:2,after:'inv',d:{},res:'Inspección de rear header antes de DQMC.'},\n   {id:'bCR',n:['Bladder','cantrail Everest'],pl:'P4 · LH/RH',lines:2,k:'press',c:2,r:3,after:'inv',d:{},res:'Bladder de cantrail LH/RH.',flag:'Del DWG Rev 10, no recorrido en piso.'},\n   {id:'cCR',n:['Coathook + felt','cantrail Everest'],pl:'P4 · LH/RH',lines:2,k:'asy',c:3,r:3,after:'inv',d:{},res:'Pre-ensamble y colocación de coathook, y felt.',flag:'Del DWG Rev 10, no recorrido en piso.'},\n   {id:'iCR',n:['Inspección','cantrail Everest'],pl:'P4 · LH/RH',lines:2,k:'press',c:4,r:3,after:'inv',d:{},res:'Inspección de cantrail. Máximo 48/h con material suficiente.',flag:'Del DWG Rev 10, no recorrido en piso.'},\n   {id:'dqR',n:['DQMC + empaque','toldos Rivian'],pl:'P4 · 4 mesas',lines:4,k:'dqmc',c:7,r:0,after:'inv',d:{},res:'Side rail LH, side rail RH, front header, rear header · 3 ops por mesa'},\n   {id:'dqmc',n:['DQMC + empaque','Tesla Everest'],pl:'P4 · 4 mesas',lines:4,k:'dqmc',c:7,r:2,after:'inv',d:{},res:'Front header, rear header, cantrail LH, cantrail RH · cantrail en cajas de 6'},\n   {id:'shR',n:['Embarque','toldos Rivian'],pl:'P4',k:'ship',c:8,r:0,after:'none',d:{},res:'Embarque a Rivian'},\n   {id:'sh',n:['Embarque','Tesla'],pl:'P4',k:'ship',c:8,r:2,after:'none',d:{},res:'4 camiones por día'}],\n  edges:[['mp','spr'],['mp','rc'],['spr','fSR'],['spr','fFH'],['spr','bCR'],['rc','fRH'],\n   ['fSR','bSR'],['bSR','lSR'],['lSR','cSR'],['cSR','iSR'],\n   ['fFH','bFH'],['bFH','lFH'],['lFH','cFH'],['cFH','iFH'],\n   ['fRH','bRH'],['bRH','lRH'],['lRH','cRH'],['cRH','iRH'],\n   ['bCR','cCR'],['cCR','iCR'],\n   ['iSR','dqR'],['iFH','dqR'],['iFH','dqmc'],['iRH','dqR'],['iRH','dqmc'],['iCR','dqmc'],['dqR','shR'],['dqmc','sh']],\n  routes:{R:{n:'Side rail Rivian',p:['spr','fSR','bSR','lSR','cSR','iSR','dqR','shR'],mp:1},F:{n:'Front header',p:['spr','fFH','bFH','lFH','cFH','iFH','dqR','shR'],mp:1},\n   H:{n:'Rear header',p:['rc','fRH','bRH','lRH','cRH','iRH','dqR','shR'],mp:1},T:{n:'Cantrail Everest',p:['spr','bCR','cCR','iCR','dqmc','sh'],mp:1}},\n  walk:['sh','shR','dqmc','dqR','iSR','iFH','iRH','iCR','cSR','cFH','cRH','cCR','lSR','lFH','lRH','bSR','bFH','bRH','bCR','fSR','fFH','fRH','spr','rc'],\n  revKick:'Tableros de DQMC de toldos (12–14 oct) · verde H = hipótesis por probar',\n  review:[\n   ['r','Material','Todos los tableros reportan \"sin material\" o \"poco material\" como causa principal. DQMC no es el cuello: no le llega producto. El cuello está antes (spray, formado o surtido).'],\n   ['r','Cumplimiento','Contra la meta acumulada al corte: front header 10%, rear EV 16%, front EV 26%, rear header 27%, side rails 43–45%.'],\n   ['r','Rechazo','Rear Everest: 154 de scrap contra 96 buenas (~62% de rechazo), por \"rechazo de material\" y tela. Side rail LH 18%, front EV 22%. Es calidad que viene de adhesivo, formado o tela, no de DQMC.'],\n   ['a','Cantrail','Cantrail Everest: máximo 48 pz/h (8 cajas de 6) con material suficiente, contra una meta de 65/h. Hoy 186 piezas con ~4 malas (~2%).'],\n   ['a','Meta vs demanda','Cada mesa tiene meta de 700/turno (65/h con 3 ops ≈ 55 s por pieza). Parece capacidad, no demanda. Falta la demanda diaria real de Rivian y de Tesla por pieza.'],\n   ['v','Estructura','Reorganizado el 15 oct con el mapa a mano de Genet y el DWG Rev 10: spray (y roll coater para rear header) → formado manual → bonding → láser y excedente → componentes → inspección → DQMC. Tres líneas por pieza: side rail L/R, front header (con primer y horno) y rear header. Cantrail Everest sale del DWG, falta recorrerlo.'],\n   ['a','Rivian y Everest','Front y rear header de Rivian y Everest comparten spray, formado y prensas (el WIP de tela está separado por cliente). Se separan hasta DQMC: cualquier faltante en el tramo compartido pega a los dos clientes.'],\n   ['a','Formado y horno','El front header va y viene entre formado manual y horno: es un retrabajo de proceso o un paso en dos tiempos. Medirlo, porque ese ir y venir suele ser el cuello.'],\n   ['b','Horario','Los tableros confirman 30 min de comida (11–12) y 15 de break (15–16).'],\n   ['h','H1','La restricción de toldos está antes de DQMC, en el tramo compartido de spray, formado manual y bonding: las 8 mesas pasan horas sin material.'],\n   ['h','H2','El rechazo por tela y manchas (rear Everest ~62%) viene del adhesivo (roll coater en el rear header), del formado manual o de la tela de proveedor; DQMC solo lo detecta.'],\n   ['h','H3','La meta de 700/turno por mesa es capacidad, no demanda. Con la demanda real el takt puede quedar sobrado o faltante.']]}\n};\nconst CHECK={\n imm:['Ciclo real por disparo y cavidades','C/O real (el draft dice 3 h) y cuántos moldes corre la prensa','Otros clientes en la prensa','Inventario de sustratos en P1, P4 y P7'],\n hs:['C/T por pieza y operadores','Cómo llega el upper reinforcement de P1','WIP antes y después'],\n spray:['C/T por rack o carga','Tiempo de flash/curado antes de wrap','¿El FIFO existe y tiene máximo?'],\n cut:['Tiempo por tendido y piezas por tendido','C/O real','WIP cortado esperando'],\n sew:['C/T por cover y operadoras','C/O real (el draft repite 3 h)','Covers en espera'],\n wrap:['C/T de la hoja de balanceo en cada una de las 4 líneas','Mezcla uppers/armrests/inserts por línea','¿Hay kanban funcionando?'],\n buy:['Cobertura en días y frecuencia de surtido','Viaje desde P1 (carriers): frecuencia y lote'],\n rack:['Cómo se secuencia Fr/Rr LH/RH','Piezas en rack'],\n asy:['C/T y operadores por línea','¿Cuántas líneas son?','Paros por faltante de componente','WIP antes de inspección'],\n dqmc:['Piezas inspeccionadas vs piezas buenas por turno','Top 3 defectos y dónde se originan','A dónde se va lo rechazado y cuántas vuelven a inspección'],\n pack:['Piezas por contenedor o caja','Producto esperando a empacarse'],\n ship:['Camiones por día y piezas por camión','PT esperando en andén (contar con hora)','¿A qué hora se manda el ASN?'],\n form:['¿Cómo se forma el sustrato? (prensa, molde, horno)','C/T por ciclo y piezas por ciclo','C/O y scrap de arranque'],\n lam:['¿Se lamina aquí o llega laminado?','C/T y operadores','Defectos (arrugas, despegue)'],\n trim:['¿Waterjet, prensa o manual?','C/T por pieza','Retrabajo de cortes'],\n align:['C/T por pieza en LH y en RH','¿Quién lo hace? Nivel de habilidad del operador','Piezas que regresan a alinear'],\n wrapm:['C/T de cada paso de wrapping, LH y RH','Retrabajo (bolsas, arrugas, despegue)','WIP entre forrado y prensa'],\n press:['C/T de prensa y de inspección','% que no pasa inspección','A dónde se va lo rechazado']};\nconst FIELDS=['val','ct','src','ops','wip','mov','freq','lote','co','up','def','kb'];\nconst NUMF={ct:1,co:1,up:1,ops:1,def:1,wip:1};\n\nlet vs='rivian',S=STREAMS.rivian,PROCS=S.procs,BY={},EDGES=S.edges,ROUTES=S.routes,WALK=S.walk,WN={};\nconst CAPS={rivian:{},tesla:{}},PARS={rivian:{},tesla:{}};let CAP=CAPS.rivian,PAR=PARS.rivian;\nlet TABS=[],NOTES=[],sel='sh',route='S',playing=!reduce,zoom=1,live=false,db=null,user=null,me=null,names={},tab='mapa';\nconst LY={info:true,kb:true,q:true,t:true,mov:true};\nconst LKEY='vsm-p4-local-v2';\nfunction loadLocal(){try{const s=JSON.parse(localStorage.getItem(LKEY)||'null');if(s){Object.assign(CAPS,s.caps||{});Object.assign(PARS,s.pars||{});NOTES=s.notes||[];CAP=CAPS[vs];PAR=PARS[vs];}}catch(e){}}\nfunction saveLocal(){try{localStorage.setItem(LKEY,JSON.stringify({caps:CAPS,pars:PARS,notes:NOTES}));}catch(e){}}\nfunction index(){BY={};PROCS.forEach(p=>BY[p.id]=p);WN={};WALK.forEach((id,i)=>WN[id]=i+1);}\nindex();\n\nfunction val(p,f){const c=CAP[p.id];if(c&&c[f]!==undefined&&c[f]!==null&&c[f]!=='')return {v:c[f],s:'g'};\n if(f==='def'&&p.d.defLo!==undefined)return {v:p.d.defLo+'–'+p.d.defHi,s:'d',lo:p.d.defLo,hi:p.d.defHi};\n if(p.d[f]!==undefined)return {v:p.d[f],s:'d'};return {v:null,s:null};}\nfunction demand(){return +PAR.dem>0?+PAR.dem:null;}\nfunction takt(){return (+PAR.dem>0&&+PAR.tur>0&&+PAR.hrs>0)?PAR.tur*PAR.hrs*3600/PAR.dem:null;}\nfunction daysAfter(p){if(p.after==='none')return 0;const w=val(p,'wip');const d=demand();return (w.v!==null&&!isNaN(+w.v)&&d)?w.v/d:null;}\nfunction req(p){if(p.k==='ship')return ['freq','lote'];const f=['ct','ops'];if(p.after!=='none')f.push('wip');return f;}\nfunction compl(p){const f=req(p);return f.filter(x=>val(p,x).v!==null).length/f.length;}\nfunction defRange(p){const x=val(p,'def');if(x.v===null)return null;if(x.lo!==undefined)return [x.lo,x.hi];return [+x.v,+x.v];}\n\nconst box=p=>({x:COLX[p.c],y:ROWY[p.r]});\nfunction outA(id){if(id==='mp')return [138,580];const b=box(BY[id]);return [b.x+BW,b.y+60];}\nfunction inA(id){const b=box(BY[id]);return [b.x,b.y+60];}\nfunction edgePath(e){const [a,b,t]=e;\n if(t==='under'){const s=box(BY[a]),d=box(BY[b]);return `M${s.x+BW/2} ${s.y+BH} V1078 H${d.x+BW/2} V${d.y+BH+4}`;}\n const [x1,y1]=outA(a),[x2,y2]=inA(b);\n if(Math.abs(y1-y2)<1)return `M${x1} ${y1} H${x2-4}`;\n const A=BY[a],B=BY[b];if(A&&B&&B.c-A.c>=2){const xm=COLX[B.c-1]+BW,d2=Math.max(30,(x2-xm)/2);return `M${x1} ${y1} H${xm} C${xm+d2} ${y1} ${x2-d2} ${y2} ${x2-4} ${y2}`;}\n const dx=Math.max(30,(x2-x1)/2);return `M${x1} ${y1} C${x1+dx} ${y1} ${x2-dx} ${y2} ${x2-4} ${y2}`;}\nfunction afterPos(p){const b=box(p);if(p.below)return [b.x+BW/2,b.y+BH-18];const nx=p.c<COLX.length-1?COLX[p.c+1]:b.x+BW+60;return [b.x+BW+(nx-b.x-BW)/2,b.y+60];}\n\nconst svg=$('map');let edgeEls=[],parts=[];\nfunction factory(x,y,w,t,s,tip,col){return `<g data-tip=\"${esc(tip)}\"><rect x=\"${x}\" y=\"${y}\" width=\"${w}\" height=\"76\" rx=\"10\" fill=\"${C.panel}\" stroke=\"${col||C.line2}\"/><path d=\"M${x+12} ${y+60} V${y+38} l11 -8 v8 l11 -8 v