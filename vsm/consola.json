ument.createElement('li');const m=document.createElement('div');m.className='m';\n const s1=document.createElement('b');s1.textContent=whoLabel(n.by);m.appendChild(s1);\n const s2=document.createElement('span');s2.textContent=n.at?new Date(n.at).toLocaleString('es-MX',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}):'';m.appendChild(s2);\n const pp=document.createElement('p');pp.textContent=n.t||'';li.appendChild(m);li.appendChild(pp);return li;}\nasync function renderDrawer(){if(!drId)return;const p=BY[drId];if(!p){closeDrawer();return;}\n $('drK').textContent=(p.pl||'')+(p.lines?' · ×'+p.lines:'');$('drT').innerHTML=esc(p.n[0])+'<small>'+esc(p.n[1]||'')+'</small>';\n {const c=CAP[p.id]||{},bits=[];if(c.win!==undefined)bits.push('WIP antes: ~'+fmt(c.win)+' pz'+(c.winr?' ('+c.winr+')':''));if(c.wip!==undefined)bits.push('WIP después: ~'+fmt(c.wip)+' pz'+(c.wipr?' ('+c.wipr+')':''));else if(c.wipr)bits.push('WIP: '+c.wipr);$('drRes').textContent=(p.res||'')+(bits.length?'\\n\\n'+bits.join('\\n'):'');$('drRes').style.whiteSpace='pre-line';}const fl=$('drFlag');fl.hidden=!p.flag;fl.textContent=p.flag?'! '+p.flag:'';\n const mine=NOTES.filter(n=>(n.vs||'rivian')===vs&&n.p===drId).sort((a,b)=>(b.at||0)-(a.at||0));\n await resolveNames([...new Set(mine.map(n=>n.by))]);\n $('drNC').textContent='Notas de gemba · '+mine.length;const ul=$('drNotes');ul.innerHTML='';\n if(!mine.length){const li=document.createElement('li');li.className='empty';li.style.cssText='background:none;border:none';li.textContent='Sin notas para esta caja todavía.';ul.appendChild(li);}\n mine.forEach(n=>ul.appendChild(noteLi(n)));\n const nf=FOTOS.filter(f=>(f.vs||'rivian')===vs&&f.p===drId).length,bf=$('drFotos');bf.hidden=!nf;bf.textContent=nf+(nf===1?' foto →':' fotos →');}\nfunction openDrawer(id){drId=id;$('tip').hidden=true;$('drawer').classList.add('open');$('drawer').setAttribute('aria-hidden','false');$('scrim').hidden=false;$('drTxt').value='';renderDrawer();edFill(id);setTimeou