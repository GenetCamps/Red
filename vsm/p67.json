[f]!==null&&c[f]!=='')return {v:c[f],s:'g'};\n if(f==='def'&&p.d.defLo!==undefined)return {v:p.d.defLo+'–'+p.d.defHi,s:'d',lo:p.d.defLo,hi:p.d.defHi};\n if(p.d[f]!==undefined)return {v:p.d[f],s:'d'};return {v:null,s:null};}\nfunction demand(){return +PAR.dem>0?+PAR.dem:null;}\nfunction takt(){return (+PAR.dem>0&&+PAR.tur>0&&+PAR.hrs>0)?PAR.tur*PAR.hrs*3600/PAR.dem:null;}\nfunction daysAfter(p){if(p.after==='none')return 0;const w=val(p,'wip');const d=demand();return (w.v!==null&&!isNaN(+w.v)&&d)?w.v/d:null;}\nfunction req(p){if(p.k==='ship')return ['freq','lote'];const f=['ct','ops'];if(p.after!=='none')f.push('wip');return f;}\nfunction compl(p){if(p.id==='costz'&&p.kids){const ks=p.kids.map(i=>ALLP[i]).filter(Boolean);return ks.length?ks.reduce((a,q)=>a+compl(q),0)/ks.length:0;}const f=req(p);return f.filter(x=>val(p,x).v!==null).length/f.length;}\nfunction defRange(p){const x=val(p,'def');if(x.v===null)return null;if(x.lo!==undefined)return [x.lo,x.hi];return [+x.v,+x.v];}\n\nconst box=p=>({x:(p.x!==undefined?p.x:COLX[p.c]),y:(p.y!==undefined?p.y:ROWY[p.r])});\nfunction outA(id){if(id==='mp')return [138,580];const b=box(BY[id]);if(BY[id].k==='jct')return [b.x,b.y+60];return [b.x+BW,b.y+60];}\nfunction inA(id){const b=box(BY[id]);return [b.x,b.y+60];}\nfunction edgePath(e){const [a,b,t]=e;{const cp=!t?edgeCustom(a,b):null;if(cp)return cp;}\n if(t==='under'){const s=box(BY[a]),d=box(BY[b]);return `M${s.x+BW/2} ${s.y+BH} V1078 H${d.x+BW/2} V${d.y+BH+4}`;}\n const [x1,y1]=outA(a),[x2,y2]=inA(b);\n if(Math.abs(y1-y2)<1)return `M${x1} ${y1} H${x2-4}`;\n const A=BY[a],B=BY[b];if(A&&B&&false){const xm=COLX[B.c-1]+BW,d2=Math.max(30,(x2-xm)/2);return `M${x1} ${y1} H${xm} C${xm+d2} ${y1} ${x2-d2} ${y2} ${x2-4} ${y2}`;}\n const dx=Math.max(30,(x2-x1)/2);return `M${x1} ${y1} C${x1+dx} ${y1} ${x2-dx} ${y2} ${x2-4} ${y2}`;}\nfunction afterPos(p){const b=box(p);if(p.below)return [b.x+BW/2,b.y+BH-18];return [p.ax!==undefined?p.ax:b.x+BW+40,b.y+60];}\n\nconst svg=$('map');let edge