ne';}const fl=$('drFlag');fl.hidden=!p.flag;fl.textContent=p.flag?'! '+p.flag:'';\n const mine=NOTES.filter(n=>PROCS.some(q=>q.id===n.p)&&n.p===drId).sort((a,b)=>(b.at||0)-(a.at||0));\n await resolveNames([...new Set(mine.map(n=>n.by))]);\n $('drNC').textContent='Notas de gemba · '+mine.length;const ul=$('drNotes');ul.innerHTML='';\n if(!mine.length){const li=document.createElement('li');li.className='empty';li.style.cssText='background:none;border:none';li.textContent='Sin notas para esta caja todavía.';ul.appendChild(li);}\n mine.forEach(n=>ul.appendChild(noteLi(n)));\n const nf=FOTOS.filter(f=>PROCS.some(q=>q.id===f.p)&&f.p===drId).length,bf=$('drFotos');bf.hidden=!nf;bf.textContent=nf+(nf===1?' foto →':' fotos →');}\nfunction openDrawer(id){drId=id;$('tip').hidden=true;$('drawer').classList.add('open');$('drawer').setAttribute('aria-hidden','false');$('scrim').hidden=false;$('drTxt').value='';renderDrawer();pedFill(id);setTimeout(()=>$('drX').focus(),50);}\nfunction closeDrawer(){drId=null;$('drawer').classList.remove('open');$('drawer').setAttribute('aria-hidden','true');$('scrim').hidden=true;}\n$('drX').onclick=closeDrawer;$('scrim').onclick=closeDrawer;\n$('drFotos').onclick=()=>{fProcFilter=drId;fFilter='Todas';closeDrawer();setTab('fotos');renderFotos();};\n$('drAdd').onclick=async()=>{const t=$('drTxt').value.trim();if(!t){toast('Escribe la nota primero');return;}\n const n={vs,p:drId,t:t.slice(0,2000),by:me||'',at:Date.now()};\n if(live){try{await db.collection('notas').add(n);$('drTxt').value='';toast('Nota agregada');}catch(e){toast('No se pudo guardar la nota.');}}\n else{NOTES.unshift(n);saveLocal();$('drTxt').value='';renderNotes();toast('Nota guardada en este dispositivo');}};\nconst FCATS=['Todas','Desorden / 5S','Mezcla de material','WIP / inventario','Falta de estandarización','Calidad / retrabajo','Tablero','Equipo','Otro'];\nfunction fillFotoProc(){$('fProc').innerHTML='<option value=\"\">General</option>'+PROCS.map(p=>`<option value=\"${p.id}\">${esc(p.n.join(' · '))}</option>`).join('');}\nasync function renderFotos(){const all=FOTOS.filter(f=>vs==='parras'||(f.vs||'parras')===vs);$('fCount').textContent=all.length?all.length:'';$('fotosVs').textContent=S.name;\n const present=FCATS.filter(c=>c==='Todas'||all.some(f=>f.cat===c));if(!present.includes(fFilter))fFilter='Todas';\n const procName=fProcFilter&&BY[fProcFilter]?BY[fProcFilter].n.join(' '):null;\n $('fChips').innerHTML=present.map(c=>`<button data-c=\"${esc(c)}\" aria-pressed=\"${c===fFilter&&!fProcFilter}\">${esc(c)} · ${c==='Todas'?all.length:all.filter(f=>f.cat===c).length}</button>`).join('')+(procName?`<button data-c=\"__p\" aria-pressed=\"true\">Caja: ${esc(procName)} ×</button>`:'');\n let rows=all.filter(f=>fFilter==='Todas'||f.cat===fFilter);if(fProcFilter)rows=rows.filter(f=>f.p===fProcFilter);\n rows.sort((a,b)=>(b.at||0)-(a.at||0));await resolveNames([...new Set(rows.map(f=>f.by))]);\n const g=$('gal');g.innerHTML='';\n if(!rows.length){g.innerHTML='<p class=\"empty\" style=\"grid-column:1/-1\">Sin fotos en esta vista.</p>';return;}\n rows.forEach(f=>{const fig=document.createElement('figure');const b=document.createElement('button');b.className='ph';b.setAttribute('aria-label','Ver foto: '+(f.cap||''));\n  const im=document.createElement('img');im.loading='lazy';im.alt=f.cap||'Foto de piso';im.src=fsrc(f);im.onerror=()=>{b.textContent='Foto no disponible';b.style.cssText+=';display:grid;place-items:center;color:var(--dim);font-size:12px';};\n  b.appendChild(im);b.onclick=()=>{$('lbImg').src=fsrc(f);$('lbImg').alt=f.cap||'';$('lbCap').textContent=f.cap||'';$('lb').hidden=false;$('lbX').focus();};\n  const fc=document.createElement('figcaption');const ch=document.createElement('div');ch.className='meta';\n  const c1=document.createElement('span');c1.className='chip';c1.textContent=f.cat||'Otro';ch.appendChild(c1);\n  if(f.p&&BY[f.p]){const c2=document.createElement('span');c2.textContent=BY[f.p].n[0];ch.appendChild(c2);}\n  const c3=