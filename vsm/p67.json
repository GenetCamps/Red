;r.el.setAttribute('cy',pt.y.toFixed(1));});parts.forEach(p=>{if(!p.L)return;const pt=edgeEls[p.e].getPointAtLength(p.s);p.el.setAttribute('cx',pt.x.toFixed(1));p.el.setAttribute('cy',pt.y.toFixed(1));});}\nlet lastT=0;function frame(t){const dt=Math.min(.05,lastT?(t-lastT)/1000:0);lastT=t;\n if(playing&&parts.length&&tab==='mapa'){rparts.forEach(r=>{if(r.L)r.s=(r.s+38*dt)%r.L;});parts.forEach(p=>{if(p.L)p.s=(p.s+speed(p.e)*dt)%p.L;});drawParts();}requestAnimationFrame(frame);}\n\nconst tip=$('tip');\nsvg.addEventListener('mousemove',e=>{const t=e.target.closest('[data-tip]');if(!t){tip.hidden=true;return;}tip.textContent=t.getAttribute('data-tip');tip.hidden=false;\n const w=tip.offsetWidth,h=tip.offsetHeight;let x=e.clientX+14,y=e.clientY+14;if(x+w>innerWidth-8)x=e.clientX-w-14;if(y+h>innerHeight-8)y=e.clientY-h-14;tip.style.left=x+'px';tip.style.top=y+'px';});\nsvg.addEventListener('mouseleave',()=>{tip.hidden=true;});\n\nfunction toast(m){const t=$('toast');t.textContent=m;t.hidden=false;clearTimeout(toast.t);toast.t=setTimeout(()=>{t.hidden=true;},2600);}\nfunction buildSel(){$('procSel').innerHTML=WALK.map(id=>{const p=BY[id];return `<option value=\"${p.id}\">${WN[id]} · ${esc(p.n.join(' · '))} — ${esc(p.pl)}</option>`;}).join('');$('procSel').value=sel;}\nfunction select(id,fromMap){sel=id;$('procSel').value=id;render();fillForm();if(fromMap&&innerWidth<980)$('capCard').scrollIntoView({behavior:reduce?'auto':'smooth',block:'start'});}\n$('procSel').addEventListener('change',e=>select(e.target.value,false));\nfunction fillForm(){const p=BY[sel],c=CAP[sel]||{};\n FIELDS.forEach(f=>{const el=$('f-'+f);el.value=c[f]??'';if(el.tagName==='INPUT'&&NUMF[f]){const d=p.d[f]!==undefined?p.d[f]:(f==='def'&&p.d.defLo!==undefined?p.d.defLo+'–'+p.d.defHi:null);el.placeholder=d!==null?'draft: '+d:'';}});\n $('procFlag').innerHTML=p.flag&&c.val!=='Confirmado'?`<p class=\"flag\"><b>Confirmar</b>${esc(p.flag)}</p>`:'';\n $('chkKick').textContent=`${WN[sel]} · ${p.n.join(' ')}`;\n $('checkList').innerHTML=(CHECK[p.k]||[]).concat(p.after!=='none'?['WIP después de este proceso, contado con hora']:[]).map(x=>`<li>${esc(x)}</li>`).join('');\n $('noteP').textContent=`${S.name} · ${p.n[0]} ${p.n[1]}`;\n renderMeta();}\nfunction whoLabel(id){if(!id)return 'alguien';if(String(id).startsWith('txt:'))return String(id).slice(4);return names[id]||(id===me?'tú':'Alguien');}\nasync function resolveNames(ids){ids=ids.filter(i=>i&&!String(i).startsWith('txt:')&&!names[i]);if(!ids.length||!user||!user.profiles)return;try{const ps=await user.profiles(ids);ids.forEach(i=>{names[i]=(ps&&ps[i]&&ps[i].name)||'Alguien';});}catch(e){}}\nasync function renderMeta(){const c=CAP[sel];if(!c||!c.at){$('capMeta').textContent='Sin captura todavía';return;}\n await resolveNames([c.by]);$('capMeta').textContent=`Última captura: ${whoLabel(c.by)} · ${new Date(c.at).toLocaleString('es-MX',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'})}`;}\nfunction fillParams(){$('p-dem').value=PAR.dem??'';$('p-tur').value=PAR.tur??'';$('p-hrs').value=PAR.hrs??'';$('p-mp').value=PAR.mp??'';$('parName').textContent=S.name;}\n$('bSave').onclick=async()=>{const body={};FIELDS.forEach(f=>{const v=$('f-'+f).value.trim();if(v!=='')body[f]=NUMF[f]?parseFloat(v):v;});\n if(body.def!==undefined&&(body.def<0||body.def>100)){toast('El defecto va de 0 a 100%');return;}\n if(body.up!==undefined&&(body.up<=0||body.up>100)){toast('El uptime va de 1 a 100%');return;}\n body.by=me||'';body.at=Date.now();const b=$('bSave');b.disabled=true;const v0=vs,id0=sel;\n if(live){try{await db.doc(STREAMS[v0].col+'/'+id0).set(body);CAPS[v0][id0]=body;toast(body.val==='Diferente'?'Guardado. Describe la diferencia en Notas.':'Guardado. Ya lo ve todo el equipo.');}catch(e){toast(e&&e.code==='invalid_argument'?'No tienes permiso de escritura. Pide acceso de Contributor.':'No se pudo guardar. Intenta otra vez.');}}\n else{CAPS[v0][id0]=body;saveLocal();toast('Guardado en este dispositivo');}\n b.disabled=false;render();renderMeta();};\n$('bSaveP').onclick=async()=>{const body=Object.assign({},PAR);[['dem','p-dem'],['tur','p-tur'],['hrs','p-hrs'],['mp','p-mp']].forEach(([k,id])=>{const v=$(id).value.trim();if(v!=='')body[k]=parseFloat(v);else delete body[k];});const v0=vs;\n if(live){try{await db.doc('cfg/'+STREAMS[v0].par).set(body);PARS[v0]=body;if(v0===vs)PAR=body;toast('Parámetros guardados');}catch(e){toast(e&&e.code==='invalid_argument'?'No tienes permiso de escritura.':'No se pudo guardar.');}}\n else{PARS[v0]=body;PAR=PARS[vs];saveLocal();toast('Parámetros guardados en este dispositivo');}render();};\n$('bNote').onclick=async()=>{const t=$('noteTxt').value.trim();if(!t){toast('Escribe la nota primero');return;}\n const n={vs,p:sel,t:t.slice(0,2000),by:me||'',at:Date.now()};\n if(live){try{await db.collection('notas').add(n);$('noteTxt').value='';toast('Nota agregada');}catch(e){toast('No se pudo guardar la nota.');}}\n else{NOTES.unshift(n);saveLocal();$('noteTxt').value='';renderNotes();toast('Nota guardada en este dispositivo');}};\nasync function renderNotes(){if(drId)renderDrawer();const mine=NOTES.filter(n=>PROCS.some(q=>q.id===n.p));$('nCount').textContent=mine.length?mine.length:'';$('notesVs').textContent=S.name;\n const ul=$('notes');if(!mine.length){ul.innerHTML=`<li class=\"empty\" style=\"background:none;border:none\">Sin notas de ${esc(S.name)} todavía.</li>`;return;}\n await resolveNames([...new Set(mine.map(n=>n.by))]);\n ul.innerHTML='';mine.forEach(n=>{const li=document.createElement('li');const p=PROCS.find(q=>q.id===n.p);\n  const m=document.createElement('div');m.className='m';const b=document.createElement('b');b.textContent=p?p.n.join(' '):'General';m.appendChild(b);\n  const s1=document.createElement('span');s1.textContent=whoLabel(n.by);m.appendChild(s1);\n  const s2=document.createElement('span');s2.textContent=n.at?new Date(n.at).toLocaleString('es-MX',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}):'';m.appendChild(s2);\n  const pp=document.createElement('p');pp.textContent=n.t||'';li.appendChild(m);li.appendChild(pp);noteTools(li,pp,n);ul.appendChild(li);});}\nfunction renderTabs(){const rows=TABS.filter(t=>vs==='parras'||(t.vs||'parras')===vs);$('tCount').textContent=rows.length?rows.length:'';$('tabVs').textContent=S.name+(S.cust?' · '+S.cust:'');\n const T=$('tabTbl'),sum=$('tabSum');\n if(!rows.length){T.innerHTML='<tr><td class=\"empty\">Sin tableros capturados para este value stream. Mándame la foto del tablero y lo cargo.</td></tr>';sum.innerHTML='';return;}\n const withMeta=rows.filter(r=>+r.meta>0&&r.real!==undefined&&r.real!==null);\n const sm=withMeta.reduce((a,r)=>a+ +r.meta,0),sr=withMeta.reduce((a,r)=>a+ +r.real,0),ss=rows.reduce((a,r)=>a+(+r.scrap||0),0),srAll=rows.reduce((a,r)=>a+(+r.real||0),0);\n sum.innerHTML=`<div class=\"kpi\"><div class=\"l\">Cumplimiento al corte</div><div class=\"v\">${sm?fmt(sr/sm*100,0):'—'}<small>%</small></div><div class=\"d\">${fmt(sr)} de ${fmt(sm)} pz meta</div></div><div class=\"kpi\"><div class=\"l\">Rechazo en DQMC</div><div class=\"v\">${srAll+ss?fmt(ss/(srAll+ss)*100,1):'—'}<small>%</small></div><div class=\"d\">${fmt(ss)} scrap · ${fmt(srAll)} buenas</div></div><div class=\"kpi\"><div class=\"l\">Causa más repetida</div><div class=\"v\" style=\"font-size:22px;line-height:1.45\">${esc(topCause(rows))}</div><div class=\"d\">en comentarios de tablero</div></div>`;\n const sorted=rows.slice().sort((a,b)=>((+a.meta>0?a.real/a.meta:9)-(+b.meta>0?b.real/b.meta:9)));\n T.innerHTML='<thead><tr><th>Programa</th><th>Cliente</th><th>Fecha · corte</th><th>Ops</th><th>Meta</th><th>Real</th><th>Cumplimiento</th><th>Scrap</th><th>Rechazo</th><th>Comentarios del tablero</th></tr></thead><tbody>'+sorted.map(r=>{\n  const c=+r.meta>0&&r.real!=null?r.real/r.meta:null,rj=(+r.real||0)+(+r.scrap||0)>0&&r.scrap!=null?r.scrap/((+r.real||0)+(+r.scrap||0)):null;\n  const col=c===null?C.dim:c<.5?C.crit:c<.85?C.inv:C.ok;\n  return `<tr><td><b>${esc(r.prog)}</b></td><td>${esc(r.cliente||'')}</td><td class=\"num\">${esc(r.fecha||'')}${r.corte?' · '+esc(r.corte):''}</td><td class=\"num\">${r.ops??'—'}</td><td class=\"num\">${r.meta!=null?fmt(r.meta):'—'}</td><td class=\"num\">${r.real!=null?fmt(r.real):'—'}</td><td class=\"num\">${c===null?'—':fmt(c*100,0)+'%'}<div class=\"cbar\"><span style=\"width:${c===null?0:Math.min(100,c*100)}%;background:${col}\"></span></div></td><td class=\"num\">${r.scrap!=null?fmt(r.scrap):'—'}</td><td class=\"num\" style=\"color:${rj!==null&&rj>=.15?C.crit:C.fg}\">${rj===null?'—':fmt(rj*100,1)+'%'}</td><td style=\"min-width:220px\">${esc(r.causas||'')}</td></tr>`;}).join('')+'</tbody>';}\nfunction topCause(rows){const k={'Falta de material':/material/i,'Rechazo / calidad':/rechazo|mancha|tela|burbuja/i,'Flujo lento':/flujo lento/i,'Paros / tiempo muerto':/paro|tiempo muerto|no work/i};let best='—',bn=0;Object.keys(k).forEach(n=>{const c=rows.filter(r=>k[n].test(r.causas||'')).length;if(c>bn){bn=c;best=n;}});return best;}\nfunction renderCT(){const st=STUDY[vs]||[],cm=CMP[vs]||[];if(!st.length){$('ctVs').textContent=S.name;$('ctKick').textContent='Sin estudios de tiempos todavía. Pendiente: C/T de 10–15 ciclos por carrusel y por línea.';$('ctWarn').innerHTML='';$('ctTbl').innerHTML='';$('ctCharts').innerHTML='';return;}$('ctVs').textContent=S.name;\n const who=[...new Set(st.map(g=>g.by.replace(/\\.$/,'').toLowerCase().replace(/(^|\\s)\\S/g,c=>c.toUpperCase())))].join(', '),dates=[...new Set(st.map(g=>g.date))].join(', ');\n $('ctKick').textContent=`Parras · ${st.length} estudios · ${dates} · elaboró ${who}. Barras = promedio de 10 lecturas, línea delgada = tiempo superior, punteada = takt de cada hoja.`;\n $('ctWarn').innerHTML=`<div style=\"border:1px solid ${C.crit};background:rgba(255,90,118,.07);border-radius:10px;padding:12px 14px;margin:6px 0 4px\"><div style=\"font-family:var(--mono);font-size:11px;letter-spacing:.08em;color:${C.crit};margin-bottom:6px\">CALIDAD DEL DATO · USAR COMO REFERENCIA, NO COMO ESTÁNDAR</div><ul style=\"margin:0;padding-left:18px;font-size:13px;line-height:1.55\">${(CTWARN[vs]||[]).map(x=>`<li>${esc(x)}</li>`).join('')}</ul></div>`;\n $('ctTbl').innerHTML='<thead><tr><th>Caja</th><th>Mapa hoy</th><th>Estudio</th><th>Cuello según estudio</th></tr></thead><tbody>'+cm.map(([id,v,t])=>{const p=BY[id];if(!p)return '';const c=val(p,'ct'),cv=c.v!==null?fmt(c.v)+' s':'—',n=parseFloat(v),diff=c.v!==null&&!isNaN(n)&&Math.abs(n-c.v)/c.v>.15;\n  return `<tr><td>${esc(p.n.join(' · '))}</td><td class=\"num\" style=\"color:${c.v!==null?C.fg:C.dim}\">${cv}</td><td class=\"num\" style=\"color:${v==='—'?C.dim:diff?C.crit:C.ok};font-weight:600\">${esc(v)}${diff?' ≠':''}</td><td style=\"min-width:240px;color:${C.muted}\">${esc(t)}</td></tr>`;}).join('')+'</tbody>';\n $('ctCharts').innerHTML=st.map(g=>{const rh=24,lw=210,W2=560,bw=W2-lw-70,mx=Math.max(g.takt,...g.ops.map(o=>o[2]))*1.08,sx=v=>lw+v/mx*bw,H=g.ops.length*rh+46;\n  let sv=`<svg viewBox=\"0 0 ${W2} ${H}\" style=\"width:100%;height:auto;display:block\" role=\"img\" aria-label=\"${esc(g.t)}\">`;\n  g.ops.forEach((o,i)=>{const y=14+i*rh,f=o[1]/g.takt,col=f>1?C.crit:f>.85?C.inv:C.mat;\n   sv+=`<text x=\"${lw-8}\" y=\"${y+13}\" text-anchor=\"end\" style=\"font-size:11px;fill:${C.muted}\">${esc(o[0].length>32?o[0].slice(0,31)+'…':o[0])}</text><rect x=\"${lw}\" y=\"${y+3}\" width=\"${Math.max(1,sx(o[1])-lw)}\" height=\"${rh-9}\" rx=\"3\" fill=\"${col}\" fill-opacity=\".85\"><title>${esc(o[0]+': '+o[1]+' s prom · '+o[2]+' s sup · '+o[3]+' est.')}</title></rect><line x1=\"${sx(o[2])}\" x2=\"${sx(o[2])}\" y1=\"${y+1}\" y2=\"${y+rh-4}\" stroke=\"${C.fg}\" stroke-opacity=\".55\" stroke-width=\"1.5\"/><text x=\"${sx(Math.max(o[1],o[2]))+6}\" y=\"${y+13}\" style=\"font-size:10.5px;fill:${C.fg}\">${fmt(o[1])}${o[3]>1?' ·'+o[3]+'e':''}</text>`;});\n  const tx=sx(g.takt);sv+=`<line x1=\"${tx}\" x2=\"${tx}\" y1=\"6\" y2=\"${H-24}\" stroke=\"${C.crit}\" stroke-dasharray=\"4 3\" stroke-width=\"1.4\"/><text x=\"${tx}\" y=\"${H-10}\" text-anchor=\"middle\" style=\"font-size:10.5px;fill:${C.crit}\">takt ${fmt(g.takt,1)} s · ${fmt(g.day)}/día</text></svg>`;\n  const ov=g.ops.filter(o=>o[1]>g.takt).length;\n  return `<div class=\"card\"><h2 style=\"font-size:18px\">${esc(g.t)}</h2><p class=\"kick\">${esc(g.sh)} · ${esc(g.date)} · ${esc(g.by)}${ov?` · <span style=\"color:${C.crit}\">${ov} op. arriba del takt</span>`:''}${g.nt?' · '+esc(g.nt):''}</p>${sv}</div>`;}).join('');}\nfunction renderReview(){{const x=S.ext||[];$('xCard').hidden=!x.length;$('xVs').textContent=S.name;$('xTbl').innerHTML='<thead><tr><th>Planta</th><th>Pieza</th><th>Sentido</th><th>Destino</th><th>Estado</th><th>Falta</th></tr></thead><tbody>'+x.map(r=>`<tr><td><b style=\"color:${r.pl==='P7'?'#fb923c':r.pl==='P6'?'#2dd4bf':'#a48bff'}\">${esc(r.pl)}</b></td><td>${esc(r.pz)}</td><td>${esc(r.dir)}</td><td>${esc(r.to)}</td><td style=\"color:${/onfirmado/.test(r.st)&&!/por/.test(r.st)?C.ok:C.draft}\">${esc(r.st)}</td><td style=\"color:${C.muted}\">${esc(r.f)}</td></tr>`).join('')+'</tbody>';}{const rw=S.rw||[];$('rwCard').hidden=!rw.length;$('rwVs').textContent=S.name;$('rwTbl').innerHTML='<thead><tr><th>Zona</th><th>Proceso</th><th>Cantidad</th><th>Qué pasa</th></tr></thead><tbody>'+rw.map(r=>`<tr><td><b style=\"color:${C.crit}\">↺ ${esc(r.n)}</b></td><td>${esc(BY[r.at]?BY[r.at].n.join(' · '):'')}</td><td class=\"num\" style=\"color:${C.crit};font-weight:600\">${esc(r.q)}</td><td style=\"min-width:260px\">${esc(r.d)}</td></tr>`).join('')+'</tbody>';}$('revVs').textContent=S.name;$('revKick').textContent=S.revKick;$('review').innerHTML=S.review.map(x=>`<li><span class=\"tag ${x[0]}\">${esc(x[1])}</span><span>${esc(x[2])}</span></li>`).join('');}\n$('bCopy').onclick=()=>{const txt=JSON.stringify({procesos:CAPS.parras,parametros:PARS,notas:NOTES},null,2),ta=$('jsonOut');\n const fb=()=>{ta.hidden=false;ta.value=txt;ta.focus();ta.select();$('cpNote').textContent='Selecciona y copia el JSON de abajo.';};\n try{navigator.clipboard.writeText(txt).then(()=>{$('cpNote').textContent='Copiado. Pégalo en el chat.';},fb);}catch(e){fb();}};\n\nfunction buildRoutes(){$('routeSeg').innerHTML=Object.keys(ROUTES).map(k=>`<button data-r=\"${k}\" aria-pressed=\"${k===route}\">${esc(ROUTES[k].n)}</button>`).join('');}\n$('routeSeg').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;route=b.dataset.r;buildRoutes();render();});\nfunction setStream(v){vs=v;S=STREAMS[v];loadView();index();CAP=CAPS[v];PAR=PARS[v];\n route=Object.keys(ROUTES)[0];sel=WALK[0];if(drId)closeDrawer();fProcFilter=null;fillFotoProc();renderFotos();\n document.querySelectorAll('.vs button').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.vs===v)));\n $('eyebrow').innerHTML=S.eyebrow;$('h1').textContent=`VSM ${S.name} ${S.prod} · Estado actual`;\n buildRoutes();buildSel();render();fillForm();fillParams();renderNotes();renderReview();renderCT();renderTabs();\n try{localStorage.setItem('vsm-p67-vs',v);}catch(e){}}\n\nfunction viewKey(){return (ST.cutz?'o':'c')+(ST.costz?'o':'c');}\nfunction loadView(){const V=VIEWS[viewKey()];\n PROCS=V.order.map(id=>Object.assign({},ALLP[id],V.pos[id]));\n EXTRA=V.extra.map(id=>Object.assign({},ALLP[id],{x:-9999,r:2,c:0}));\n Object.keys(V.jct).forEach(id=>EXTRA.push({id,k:'jct',n:['',''],pl:'',res:'',d:{},after:'none',x:V.jct[id].x,r:V.jct[id].r,c:0}));\n EDGES=V.edges;ROUTES=V.routes;WALK=V.walk;S.procs=PROCS;S.edges=EDGES;S.routes=ROUTES;S.walk=WALK;}\nconst zOpen=z=>PROCS.some(p=>p.z===z);\nconst zKids=z=>PROCS.filter(p=>p.z===z);\nfunction zBus(z,side){const ks=zKids(z);const xs=ks.map(p=>box(p).x);return side==='in'?Math.min(...xs)-40:Math.max(...xs)+BW+38;}\nfunction edgeCustom(a,b){const A=BY[a],B=BY[b];if(!A||!B)return null;\n const zA=A.z&&zOpen(A.z),zB=B.z&&zOpen(B.z);if(!zA&&!zB)return null;\n const [x1,y1]=outA(a),[x2,y2]=inA(b);\n if(zA){const bo=zBus(A.z,'out'),ar=B.k==='jct'?0:4;\n  if(A.sc==='a'){const gy=ROWY[A.r]+BH+22;return `M${x1} ${y1} H${x1+26} V${gy} H${bo} V${y2} H${x2-ar}`;}\n  return `M${x1} ${y1} H${bo} V${y2} H${x2-ar}`;}\n const bi=zBus(B.z,'in');\n if(B.sc==='b'){const gy=ROWY[B.r]-22,xv=box(B).x-36;return `M${x1} ${y1} H${bi} V${gy} H${xv} V${y2} H${x2-4}`;}\n return `M${x1} ${y1} H${bi} V${y2} H${x2-4}`;}\nwindow.__dbg=()=>({EDGES,PROCS,BY,ROWY,edgePath,box});\nconst ZLAB={cutz:'Carruseles P7 · 8',costz:'Líneas P6 · 16'};\nfunction zBtn(z,sign,cx,cy){return `<g class=\"zbtn\" data-z=\"${z}\" role=\"button\" tabindex=\"0\" aria-label=\"${sign==='+'?'Abrir':'Cerrar'} ${ZLAB[z]}\" style=\"cursor:pointer\"><circle cx=\"${cx}\" cy=\"${cy}\" r=\"15\" fill=\"${C.mat}\" stroke=\"${C.bg}\" stroke-width=\"2.5\"/><text x=\"${cx}\" y=\"${cy+6}\" text-anchor=\"middle\" style=\"font:700 20px system-ui,sans-serif;fill:#06141f;pointer-events:none\">${sign}</text></g>`;}\nfunction zoneOverlay(){let g='';['cutz','costz'].forEach(z=>{\n if(zOpen(z)){const ks=zKids(z);let x0=1e9,y0=1e9,x1=-1,y1=-1;ks.forEach(p=>{const b=box(p);x0=Math.min(x0,b.x);y0=Math.min(y0,b.y);x1=Math.max(x1,b.x+BW);y1=Math.max(y1,b.y+BH);});\n  g+=`<g class=\"zone\"><rect x=\"${x0-52}\" y=\"${y0-50}\" width=\"${x1-x0+104}\" height=\"${y1-y0+86}\" rx=\"18\" fill=\"rgba(90,160,255,.045)\" stroke=\"${C.mat}\" stroke-opacity=\".55\" stroke-width=\"1.5\" stroke-dasharray=\"8 6\" pointer-events=\"none\"/><text x=\"${x0-34}\" y=\"${y0-22}\" style=\"font:700 16px system-ui,sans-serif;fill:${C.fg}\" pointer-events=\"none\">${ZLAB[z]}</text>`+zBtn(z,'−',x1+28,y0-26)+'</g>';}\n else{const p=BY[z];if(!p)return;const b=box(p);g+=zBtn(z,'+',b.x+BW-4,b.y+BH-6);}\n});\nconst old=svg.querySelector('#zoneLayer');if(old)old.remove();svg.insertAdjacentHTML('beforeend','<g id=\"zoneLayer\">'+g+'</g>');}\nfunction applyProgram(){const hl=S.hl;svg.querySelectorAll('.proc').forEach(g=>{const id=g.dataset.id;const sub=/^(L\\d+|C\\d+)$/.test(id);g.style.opacity=(hl&&sub&&!hl.includes(id))?'.22':'';});}\nconst __render=render;render=function(){