"<!doctype html><html lang=\"es\"><head><meta charset=\"utf8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Centro de acciones · Red DAIMAY</title>\n<style>\n/* Red DAIMAY · Centro de acciones. Se abre dentro del hub (como el Centro OEE) y guarda en su base:\n   acc/r1/a/<id>  acciones de mejora (de un foco del VSM, de un análisis de turno, de un nodo del Centro OEE o a mano)\n   acc/r1/m/<id>  medición «después» que escribe el Centro OEE para las acciones ligadas a un nodo\n   Lee también oee/r1/rep/summary (OEE y scrap por planta) y rep/r1/ana/<planta> (último análisis de turno) para el reporte ejecutivo. */\n:root{color-scheme:dark;--bg:#070b10;--panel:#0e161f;--panel2:#0b121a;--raise:#132030;--line:#1c2a38;--line2:#2a3d50;--fg:#e6eef5;--muted:#8a9cae;--dim:#5a6d80;--mat:#48c2ff;--ok:#3ddc97;--warn:#ffb321;--crit:#ff5a76;--info:#a48bff}\nhtml[data-theme=\"light\"]{color-scheme:light;--bg:#f3f6fa;--panel:#ffffff;--panel2:#f7f9fc;--raise:#e8eef5;--line:#d3dce6;--line2:#aebccb;--fg:#16202c;--muted:#4a5a6b;--dim:#7b8a99;--mat:#0b6fc2;--ok:#0d8a55;--warn:#b06a00;--crit:#d22c4d;--info:#6a4fd6}\n*{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.45 system-ui,-apple-system,\"Segoe UI\",sans-serif}\nbutton,select,input,textarea{font:inherit;color:var(--fg)} [hidden]{display:none!important}\n.wrap{max-width:1500px;margin:0 auto;padding:12px 16px 40px;display:flex;flex-direction:column;gap:12px}\n.top{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center}\n.top h1{font-size:22px;margin:0 6px 0 0;font-weight:700}\n.b{background:var(--panel2);border:1px solid var(--line2);border-radius:8px;padding:6px 11px;cursor:pointer;min-height:34px}\n.b:hover{border-color:var(--mat)} .b.prim{background:var(--mat);border-color:var(--mat);color:#fff;font-weight:600} .b.del{border-color:var(--crit);color:var(--crit)}\n.b:focus-visible,select:focus-visible,input:focus-visible,textarea:focus-visible,.card:focus-visible{outline:2px solid var(--mat);outline-offset:2px}\nselect,input,textarea{background:var(--panel2);border:1px solid var(--line2);border-radius:8px;padding:6px 8px;min-width:0;width:100%}\ntextarea{min-height:70px;resize:vertical}\n.sp{flex:1}.muted{color:var(--muted)}.small{font-size:12px}\n.seg{display:inline-flex;border:1px solid var(--line2);border-radius:9px;padding:2px;background:var(--panel2);flex-wrap:wrap}\n.seg button{border:0;background:none;padding:6px 11px;border-radius:7px;cursor:pointer;color:var(--muted)} .seg button.on{background:var(--raise);color:var(--fg);box-shadow:inset 0 0 0 1px var(--mat)}\n.filters{display:flex;flex-wrap:wrap;gap:8px;align-items:center} .filters select,.filters input[type=search]{width:auto;max-width:220px} .filters label{display:flex;gap:5px;align-items:center;font-size:13px;color:var(--muted)}\n.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden}\n.kpi{background:var(--panel);padding:10px 12px;min-width:0} .kpi span{display:block;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}\n.kpi b{display:block;font-size:24px;font-weight:700;font-variant-numeric:tabular-nums;margin-top:3px} .kpi small{display:block;font-size:11.5px;color:var(--dim);min-height:15px}\n.board{display:grid;grid-template-columns:repeat(4,minmax(240px,1fr));gap:10px;overflow-x:auto;padding-bottom:4px}\n.col{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:8px;display:flex;flex-direction:column;gap:8px;min-width:0}\n.col h3{margin:2px 4px;font-size:13px;display:flex;gap:6px;align-items:center} .col h3 i{width:10px;height:10px;border-radius:50%;display:inline-block}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:9px 11px;min-width:0;text-align:left;width:100%;cursor:pointer;display:flex;flex-direction:column;gap:5px}\n.card:hover{border-color:var(--mat)} .card .t{font-size:14px;line-height:1.3}\n.row{display:flex;justify-content:space-between;gap:8px;align-items:center;flex-wrap:wrap}\n.tag{font-size:10.5px;padding:1px 7px;border-radius:99px;border:1px solid var(--line2);color:var(--muted);white-space:nowrap} .tag.src{border-color:var(--mat);color:var(--mat)}\n.late{color:var(--crit);font-weight:600} .okc{color:var(--ok);font-weight:600}\n.ba{display:flex;gap:6px;align-items:baseline;flex-wrap:wrap;font-size:12px;background:var(--panel2);border-radius:7px;padding:4px 7px} .ba span{color:var(--muted)} .ba em{font-style:normal;font-weight:700} .ba em.ok{color:var(--ok)} .ba em.bad{color:var(--crit)}\n.empty{color:var(--dim);font-size:12.5px;padding:6px 4px}\n#fRef{font-size:12.5px;padding:3px 4px 3px 10px;display:inline-flex;gap:6px;align-items:center} #fRef button{background:none;border:0;color:inherit;cursor:pointer;font-size:15px;line-height:1;padding:0 4px}\n.lnk{background:none;border:0;color:var(--mat);cursor:pointer;padding:0;font:inherit;font-weight:700}\ntable{width:100%;border-collapse:collapse;font-size:12.5px;font-variant-numeric:tabular-nums} th,td{padding:6px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top} th{color:var(--muted);font-weight:600} td.n,th.n{text-align:right}\ntr.click{cursor:pointer} tr.click:hover td{background:var(--panel2)}\n.box{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px;min-width:0} .box h3{margin:0 0 8px;font-size:15px}\n.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:12px}\nsvg{display:block;width:100%;height:auto}\ndialog{width:min(820px,calc(100vw - 16px));max-height:calc(100vh - 16px);border:1px solid var(--line2);border-radius:14px;background:var(--panel);color:var(--fg);padding:0}\ndialog::backdrop{background:rgba(0,0,0,.55)}\n.dh{display:flex;gap:8px;align-items:center;padding:12px 14px;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--panel);z-index:1}\n.dh input{font-size:17px;font-weight:600}\n.db{padding:12px 14px;display:flex;flex-direction:column;gap:12px}\n.df{display:flex;gap:8px;padding:10px 14px;border-top:1px solid var(--line);position:sticky;bottom:0;background:var(--panel);flex-wrap:wrap}\n.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px 12px} .form label,.lab{display:grid;gap:3px;font-size:12px;color:var(--muted)}\n.sec{border:1px solid var(--line);border-radius:10px;padding:10px 12px;display:flex;flex-direction:column;gap:8px} .sec h4{margin:0;font-size:13.5px}\n.gain{font-size:13px} .gain b{font-size:18px}\n.ph{display:grid;grid-template-columns:1fr 1fr;gap:10px} .ph figure{margin:0;display:flex;flex-direction:column;gap:5px} .ph img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:8px;border:1px solid var(--line);background:var(--panel2)}\n.ph .noimg{aspect-ratio:4/3;border:1px dashed var(--line2);border-radius:8px;display:grid;place-items:center;color:var(--dim);font-size:12px}\n.log{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:5px;max-height:180px;overflow:auto} .log li{font-size:12.5px;background:var(--panel2);border-radius:7px;padding:5px 8px} .log b{font-weight:600}\n#toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);background:var(--raise);border:1px solid var(--line2);border-radius:10px;padding:9px 14px;font-size:13px;z-index:50;max-width:calc(100vw - 30px)}\n.rephead{display:none}\n@media (max-width:700px){.board{grid-template-columns:1fr}.ph{grid-template-columns:1fr}}\n@media print{\n  :root,html[data-theme]{--bg:#fff;--panel:#fff;--panel2:#f5f7fa;--raise:#eef2f6;--line:#d3dce6;--line2:#aebccb;--fg:#16202c;--muted:#4a5a6b;--dim:#7b8a99;--mat:#0b6fc2;--ok:#0d8a55;--warn:#b06a00;--crit:#d22c4d;--info:#6a4fd6;color-scheme:light}\n  body{font-size:12px} .wrap{padding:0;max-width:none} .noprint,#toast,dialog{display:none!important}\n  .rephead{display:flex;gap:14px;align-items:center;margin-bottom:6px} .rephead img{height:44px} .rephead h1{font-size:20px;margin:0}\n  .box,.kpis,table,svg{break-inside:avoid} @page{margin:10mm}\n}\n</style></head><body>\n<div class=\"wrap\">\n  <div class=\"top noprint\">\n    <h1>Centro de acciones</h1>\n    <div class=\"seg\" id=\"tabs\" role=\"tablist\" aria-label=\"Vista\">\n      <button role=\"tab\" data-v=\"tab\" class=\"on\">Tablero</button><button role=\"tab\" data-v=\"lst\">Lista</button><button role=\"tab\" data-v=\"rep\">Reporte ejecutivo</button>\n    </div>\n    <span class=\"sp\"></span>\n    <button class=\"b\" id=\"bTheme\"></button>\n    <button class=\"b prim\" id=\"bNew\">+ Nueva acción</button>\n  </div>\n  <div class=\"filters noprint\" id=\"filters\">\n    <select id=\"fPl\" aria-label=\"Planta\"></select>\n    <select id=\"fPe\" aria-label=\"Pérdida\"></select>\n    <select id=\"fRe\" aria-label=\"Responsable\"></select>\n    <input type=\"search\" id=\"fQ\" placeholder=\"Buscar acción…\" aria-label=\"Buscar acción\">\n    <label><input type=\"checkbox\" id=\"fV\" style=\"width:auto\">Solo vencidas</label>\n    <span class=\"tag src\" id=\"fRef\" hidden></span><span class=\"sp\"></span><span class=\"muted small\" id=\"fInfo\"></span>\n  </div>\n  <section class=\"kpis\" id=\"kpis\" aria-label=\"Indicadores de las acciones\"></section>\n  <section id=\"vTab\"></section>\n  <section id=\"vLst\" hidden></section>\n  <section id=\"vRep\" hidden></section>\n</div>\n<dialog id=\"dlg\" aria-labelledby=\"dT\"></dialog>\n<datalist id=\"dlResp\"></datalist><datalist id=\"dlArea\"></datalist>\n<input type=\"file\" id=\"fFoto\" accept=\"image/*\" capture=\"environment\" hidden>\n<div id=\"toast\" hidden role=\"status\"></div>\n<script>\n(async()=>{\nconst $=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst fmt=(n,d=0)=>Number(n).toLocaleString('es-MX',{minimumFractionDigits:d,maximumFractionDigits:d}),money=v=>(v<0?'−':'')+'$'+fmt(Math.abs(v),0),pc=v=>v==null||!isFinite(v)?'—':fmt(v*100,1)+'%';\nconst nf=v=>v==null||v===''||!isFinite(+v)?'—':fmt(+v,+v%1&&Math.abs(+v)<1000?1:0);\nfunction toast(m,ms){const t=$('toast');t.textContent=m;t.hidden=false;clearTimeout(toast.t);toast.t=setTimeout(()=>t.hidden=true,ms||3500);}\nlet RO=false;try{RO=!!(parent&&parent.RD_RO);}catch(e){}\nconst INHUB=(()=>{try{return parent!==window&&!!parent.__rdKind;}catch(e){return false;}})();\nconst navTo=t=>{try{parent.postMessage({src:'emb',type:'nav',t},'*');}catch(e){}};\nlet ME='usuario';try{ME=(JSON.parse(sessionStorage.getItem('rd_user')||'null')||{}).nombre||ME;}catch(e){}\n/* ---------- base: la del hub o, abierta suelta, este navegador ---------- */\nlet db=null;try{if(window.claude&&window.claude.use)db=await window.claude.use('db');}catch(e){db=null;}\nconst LS='rd_acc_local_v1';let LOC={};try{LOC=JSON.parse(localStorage.getItem(LS)||'{}');}catch(e){}\nconst persist=()=>{try{localStorage.setItem(LS,JSON.stringify(LOC));}catch(e){toast('El navegador ya no tiene espacio. Usa fotos más pequeñas o publica tus datos.',8000);}};\n/* migración única: lo que se guardó en este navegador cuando el hub no daba la base (antes del 17-nov) pasa a la base del hub */\nif(db&&!RO){try{const MK=LS+'_migrado';if(!localStorage.getItem(MK)){const ks=Object.keys(LOC);let n=0;for(const k of ks){try{const s=await db.doc(k).get();if(!s.exists){await db.doc(k).set(LOC[k]);n++;}}catch(e){}}\n localStorage.setItem(MK,String(Date.now()));if(n)setTimeout(()=>toast(n+(n===1?' registro guardado antes en este navegador pasó':' registros guardados antes en este navegador pasaron')+' a la base de la Red.',7000),1500);}}catch(e){}}\nasync function dGet(p){if(db){const s=await db.doc(p).get();return s.exists?s.data():null;}return LOC[p]??null;}\nasync function dSet(p,v){if(RO)throw {code:'solo-lectura'};if(db)return db.doc(p).set(v);LOC[p]=v;persist();}\nasync function dDel(p){if(RO)throw {code:'solo-lectura'};if(db)return db.doc(p).delete();delete LOC[p];persist();}\nasync function dList(c){if(db){const q=await db.collection(c).get();return q.docs.map(d=>({id:d.id,...d.data()}));}return Object.keys(LOC).filter(k=>k.startsWith(c+'/')&&!k.slice(c.length+1).includes('/')).map(k=>({id:k.slice(c.length+1),...LOC[k]}));}\n\n/* ---------- catálogos ---------- */\nconst PL={p1:'Planta 1',p2:'Planta 2',p4:'Planta 4',p67:'Planta 6-7',p8:'Planta 8',parras:'Parras',red:'Red / corporativo'};\nconst PERD=['Disponibilidad (paros)','Rendimiento (ciclo y microparos)','Calidad (scrap y retrabajo)','Balanceo y personal','Flujo y material','5S y orden','Seguridad y ergonomía','Otro'];\nconst TIPO=['Quick win','Kaizen','Proyecto','A3 / 8D'];\nconst EST=[['abierta','Abierta','var(--info)'],['curso','En curso','var(--warn)'],['cerrada','Cerrada','var(--ok)'],['cancelada','Cancelada','var(--dim)']];\nconst ESTN=Object.fromEntries(EST.map(e=>[e[0],e[1]]));\nconst SRC={vsm:'Foco del VSM',ana:'Análisis de turno',oee:'Centro OEE',man:'Captura manual'};\nconst today=()=>new Date().toLocaleDateString('sv');\nconst fdate=s=>{if(!s)return '';const [y,m,d]=String(s).slice(0,10).split('-');return `${d}/${m}/${y.slice(2)}`;};\nconst isOpen=a=>a.est==='abierta'||a.est==='curso';\nconst overdue=a=>isOpen(a)&&a.fc&&a.fc<today();\nconst lateDays=a=>Math.round((new Date(today())-new Date(a.fc))/864e5);\nconst uid=()=>'a'+Date.now().toString(36)+Math.random().toString(36).slice(2,6);\n\n/* ---------- datos ---------- */\nlet A=[],M={},OS=null,AN={},view='tab',F={pl:'',pe:'',re:'',q:'',v:false,ref:''},REP='mes';\nasync function loadAll(){try{A=await dList('acc/r1/a');M={};(await dList('acc/r1/m')).forEach(m=>{M[m.id]=m;});OS=await dGet('oee/r1/rep/summary');AN={};(await dList('rep/r1/ana')).forEach(x=>{AN[x.id]=x;});}catch(e){toast('No se pudo leer la base: '+(e.message||e.code||e),8000);}}\n\n/* antes y después: lo capturado manda; si falta, se toma lo que midió el origen (Centro OEE o análisis de turno) */\nfunction ind(a){const i=Object.assign({n:'',u:'',a:null,d:null,m:'down'},a.ind||{}),m=M[a.id],em=v=>v===null||v===undefined||v==='';\n if(a.src?.k==='oee'&&a.base){if(em(i.a)&&a.base.o!=null){i.n=i.n||'OEE';i.u=i.u||'%';i.m='up';i.a=+(a.base.o*100).toFixed(1);i.autoA=true;}\n  if(em(i.d)&&m&&m.o!=null&&m.days>=3){i.d=+(m.o*100).toFixed(1);i.autoD=`medido por el Centro OEE con ${m.days} días desde ${fdate(m.from)}`;}}\n if(a.src?.k==='ana'&&a.base){if(em(i.a)){i.n=i.n||'Min perdidos por turno';i.u=i.u||'min';i.m='down';i.a=Math.round(a.base.lost);i.autoA=true;}\n  if(em(i.d)&&a.aft){i.d=Math.round(a.aft.lost);i.autoD=`análisis de turno del ${fdate(new Date(a.aft.at).toLocaleDateString('sv'))}`;}}\n i.hasA=!em(i.a);i.has=i.hasA&&!em(i.d);i.gain=i.has?(i.m==='down'?(+i.a-+i.d):(+i.d-+i.a)):null;i.pct=i.has&&+i.a?i.gain/Math.abs(+i.a):null;return i;}\nfunction ahorro(a){if(a.ah&&a.ah.mxn!==''&&a.ah.mxn!=null&&isFinite(+a.ah.mxn))return {v:+a.ah.mxn,src:'capturado'};\n if(a.src?.k==='ana'&&a.base&&a.aft&&a.base.cm>0){const t=+a.tm||44;return {v:(a.base.lost-a.aft.lost)*a.base.cm*t,src:`calculado: minutos perdidos ahorrados × costo por minuto × ${t} turnos al mes`};}\n const m=M[a.id];if(a.src?.k==='oee'&&a.base?.scd!=null&&m?.scd!=null&&m.days>=3)return {v:(a.base.scd-m.scd)*22,src:'calculado: scrap Plex por día (antes − después) × 22 días'};\n return null;}\n\n/* ---------- filtros ---------- */\nfunction fill(){const resp=[...new Set(A.map(a=>a.resp).filter(Boolean))].sort(),area=[...new Set(A.map(a=>a.area).filter(Boolean))].sort();\n let users=[];try{users=(parent.RD_USERS||[]).map(u=>u.nombre).filter(Boolean);}catch(e){}\n $('dlResp').innerHTML=[...new Set([...resp,...users])].map(r=>`<option value=\"${esc(r)}\">`).join('');$('dlArea').innerHTML=area.map(r=>`<option value=\"${esc(r)}\">`).join('');\n $('fPl').innerHTML='<option value=\"\">Todas las plantas</option>'+Object.entries(PL).map(([k,v])=>`<option value=\"${k}\"${F.pl===k?' selected':''}>${v}</option>`).join('');\n $('fPe').innerHTML='<option value=\"\">Toda pérdida</option>'+PERD.map(p=>`<option${F.pe===p?' selected':''}>${esc(p)}</option>`).join('');\n $('fRe').innerHTML='<option value=\"\">Todo responsable</option>'+resp.map(r=>`<option${F.re===r?' selected':''}>${esc(r)}</option>`).join('');}\nconst norm=s=>String(s||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'');\nfunction list(){const q=norm(F.q);return A.filter(a=>(!F.ref||a.src?.ref===F.ref)&&(!F.pl||a.pl===F.pl)&&(!F.pe||a.perd===F.pe)&&(!F.re||a.resp===F.re)&&(!F.v||overdue(a))&&(!q||norm([a.t,a.desc,a.area,a.resp,a.src?.lab].join(' ')).includes(q)))\n .sort((x,y)=>(overdue(y)-overdue(x))||String(x.fc||'9999').localeCompare(String(y.fc||'9999'))||(y.cr||0)-(x.cr||0));}\n\n/* ---------- vistas ---------- */\nfunction kpis(L){const op=L.filter(isOpen),od=L.filter(overdue),cl=L.filter(a=>a.est==='cerrada'),ahs=cl.map(ahorro).filter(Boolean),sum=ahs.reduce((s,x)=>s+x.v,0),ontime=cl.filter(a=>a.fc&&a.ce).filter(a=>new Date(a.ce).toLocaleDateString('sv')<=a.fc).length,withF=cl.filter(a=>a.fc&&a.ce).length,mes=today().slice(0,7);\n const k=[['Abiertas',fmt(L.filter(a=>a.est==='abierta').length),'por arrancar'],['En curso',fmt(L.filter(a=>a.est==='curso').length),'trabajándose'],['Vencidas',fmt(od.length),od.length?'pasaron su fecha compromiso':'ninguna',od.length?'var(--crit)':''],\n  ['Cerradas',fmt(cl.length),`${fmt(cl.filter(a=>a.ce&&new Date(a.ce).toLocaleDateString('sv').slice(0,7)===mes).length)} este mes`],['A tiempo',withF?pc(ontime/withF):'—',withF?`${ontime} de ${withF} cerradas con fecha`:'sin cerradas con fecha'],\n  ['Ahorro mensual',money(sum),`${ahs.length} cerradas con ahorro · ${money(sum*12)} al año`,sum>0?'var(--ok)':'']];\n $('kpis').innerHTML=k.map(([l,v,s,c])=>`<div class=\"kpi\"><span>${l}</span><b style=\"${c?'color:'+c:''}\">${v}</b><small>${esc(s)}</small></div>`).join('');}\nfunction card(a){const i=ind(a),od=overdue(a),ah=ahorro(a);\n return `<button class=\"card\" data-id=\"${esc