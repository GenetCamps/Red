abiertas por tipo de pérdida</h3>${bars(byPerd,0,v=>fmt(v),'var(--warn)')}</div></div>\n <div class=\"two\"><div class=\"box\"><h3>Las 5 de más ahorro · ${esc(lbl.toLowerCase())}</h3>${top.length?`<table><tbody>${top.map(({a,h})=>{const i=ind(a);return `<tr class=\"click\" data-id=\"${esc(a.id)}\"><td><b>${esc(a.t)}</b><br><span class=\"small muted\">${esc(PL[a.pl]||'')} · ${esc(a.resp||'')}${i.has?` · ${esc(i.n)} ${nf(i.a)} → ${nf(i.d)} ${esc(i.u)}`:''}</span></td><td class=\"n okc\">${money(h.v)}/mes</td></tr>`;}).join('')}</tbody></table>`:'<p class=\"muted small\">Aún no hay acciones cerradas con ahorro en el periodo.</p>'}</div>\n  <div class=\"box\"><h3>Vencidas</h3>${od.length?`<table><tbody>${od.slice(0,12).map(a=>`<tr class=\"click\" data-id=\"${esc(a.id)}\"><td><b>${esc(a.t)}</b><br><span class=\"small muted\">${esc(PL[a.pl]||'')} · ${esc(a.resp||'sin responsable')}</span></td><td class=\"n late\">${lateDays(a)} días</td></tr>`).join('')}</tbody></table>${od.length>12?`<p class=\"small muted\">y ${od.length-12} más.</p>`:''}`:'<p class=\"muted small\">Ninguna acción vencida.</p>'}</div></div>`;}\n\nfunction render(){fill();const L=list();$('fInfo').textContent=`${L.length} de ${A.length} acciones`;kpis(L);\n $('fRef').hidden=!F.ref;if(F.ref)$('fRef').innerHTML=`Origen: <b>${esc(F.refLab||F.ref)}</b> <button data-fref=\"x\" aria-label=\"Quitar el filtro de origen\">×</button>`;\n try{parent.postMessage({src:'emb',type:'crumb',parts:[{tab:'Tablero',lst:'Lista',rep:'Reporte ejecutivo'}[view],F.ref&&view!=='rep'?F.refLab:'']},'*');}catch(e){}\n document.querySelectorAll('#tabs button').forEach(b=>{b.classList.toggle('on',b.dataset.v===view);b.setAttribute('aria-selected',String(b.dataset.v===view));});\n $('vTab').hidden=view!=='tab';$('vLst').hidden=view!=='lst';$('vRep').hidden=view!=='rep';$('filters').hidden=view==='rep';$('kpis').hidden=view==='rep';\n if(view==='tab')board(L);else if(view==='lst')table(L);else report();}\n\n/* ---------- detalle ---------- */\nlet CURA=null,FOTO=null;\nconst opt=(arr,v)=>arr.map(x=>Array.isArray(x)?`<option value=\"${x[0]}\"${x[0]===v?' selected':''}>${esc(x[1])}</option>`:`<option${x===v?' selected':''}>${esc(x)}</option>`).join('');\nfunction baseTxt(a){const b=a.base;if(!b)return '';\n if(a.src?.k==='oee')return `Al crearla, el nodo «${esc(b.nodeName||'')}» tenía OEE ${pc(b.o)} (disp. ${pc(b.a)} · rend. ${pc(b.r)} · cal. ${pc(b.q)}) y scrap Plex de ${b.scd!=null?money(b.scd):'—'} por día, del ${fdate(b.from)} al ${fdate(b.to)}.`;\n if(a.src?.k==='ana')return `Al crearla, el análisis de «${esc(b.yz||'')}» daba ${fmt(b.pz)} piezas${b.dem?` de ${fmt(b.dem)} de demanda`:''}, ${fmt(b.lost)} min perdidos por turno${b.cm>0?` (${money(b.lost*b.cm)})`:''}${b.oee!=null?` y OEE teórico ${pc(b.oee)}`:''}. Cuello: ${esc(b.neck||'—')}.${a.aft?` Resultado registrado: ${fmt(a.aft.pz)} piezas y ${fmt(a.aft.lost)} min perdidos.`:' Para medir el después, vuelve a correr el análisis con el cambio hecho y usa «Registrar resultado de una acción».'}`;\n if(a.src?.k==='vsm')return `Caja «${esc(b.box||'')}»${b.flag?` con foco rojo: ${esc(b.flag)}`:''}${b.ct?` · C/T ${esc(b.ct)} s`:''}.`;\n return '';}\nfunction goNav(a){const r=a.src?.ref||'',k=a.src?.k;\n if(k==='vsm'&&r){const[c,st,id]=r.split('|');return [c==='vp'?{to:'vp',box:id}:{to:'vx',stream:st,box:id},'Ir a la caja del VSM'];}\n if(k==='oee'&&r)return [{to:'oee',node:r},'Ir al Centro OEE'];\n if(k==='ana'&&r){const i=r.indexOf('|');return [{to:'plant',plant:r.slice(0,i),ops:true,yz:r.slice(i+1)},'Ir al análisis en el gemelo'];}\n if(a.pl&&a.pl!=='red')return [{to:'plant',plant:a.pl},'Abrir la planta'];return null;}\nfunction openDlg(a){CURA=JSON.parse(JSON.stringify(a));FOTO=null;const d=$('dlg'),i=ind(CURA),ah=ahorro(CURA),dis=RO?' disabled':'';\n d.innerHTML=`<form method=\"dialog\" id=\"fm\" novalidate><div class=\"dh\"><input id=\"dT\" aria-label=\"Título de la acción\" placeholder=\"¿Qué se va a hacer?\" value=\"${esc(CURA.t||'')}\"${dis}><button class=\"b\" value=\"x\" aria-label=\"Cerrar\">✕</button></div>\n <div class=\"db\">\n  <div class=\"form\">\n   <label>Planta<select id=\"dPl\"${dis}>${opt(Object.entries(PL),CURA.pl)}</select></label>\n   <label>Área, línea o caja<input id=\"dAr\" list=\"dlArea\" value=\"${esc(CURA.area||'')}\"${dis}></label>\n   <label>Pérdida que ataca<select id=\"dPe\"${dis}><option value=\"\">Elige…</option>${opt(PERD,CURA.perd)}</select></label>\n   <label>Tipo<select id=\"dTi\"${dis}>${opt(TIPO,CURA.tipo||'Kaizen')}</select></label>\n   <label>Responsable<input id=\"dRe\" list=\"dlResp\" value=\"${esc(CURA.resp||'')}\"${dis}></label>\n   <label>Fecha compromiso<input id=\"dFc\" type=\"date\" value=\"${esc(CURA.fc||'')}\"${dis}></label>\n   <label>Estado<select id=\"dEs\"${dis}>${opt(EST.map(e=>[e[0],e[1]]),CURA._es||CURA.est||'abierta')}</select></label>\n  </div>\n  <label class=\"lab\">Problema, causa raíz y contramedida<textarea id=\"dDe\" placeholder=\"Qué pasa, por qué pasa y qué se va a hacer\"${dis}>${esc(CURA.desc||'')}</textarea></label>\n  ${CURA.src&&CURA.src.k!=='man'?`<div class=\"sec\"><h4>Origen · ${esc(SRC[CURA.src.k]||'')}</h4><div class=\"small\">${esc(CURA.src.lab||'')}</div><div class=\"small muted\">${baseTxt(CURA)}</div></div>`:''}\n  <div class=\"sec\"><h4>Antes y después</h4>\n   <div class=\"form\">\n    <label>Indicador<input id=\"dIn\" placeholder=\"OEE, scrap, minutos perdidos, C/T…\" value=\"${esc(i.n||'')}\"${dis}></label>\n    <label>Unidad<input id=\"dIu\" placeholder=\"%, pz, min, s, $\" value=\"${esc(i.u||'')}\"${dis}></label>\n    <label>Es mejor si<select id=\"dIm\"${dis}>${opt([['down','baja'],['up','sube']],i.m)}</select></label>\n    <label>Antes<input id=\"dIa\" type=\"number\" step=\"any\" value=\"${i.hasA?esc(i.a):''}\"${dis}></label>\n    <label>Después<input id=\"dId\" type=\"number\" step=\"any\" value=\"${i.has?esc(i.d):''}\" placeholder=\"${CURA.src?.k==='oee'?'lo mide el Centro OEE':CURA.src?.k==='ana'?'lo trae el análisis':''}\"${dis}></label>\n   </div>\n   <div class=\"gain\" id=\"dGain\"></div>\n   ${i.autoD?`<div class=\"small muted\">Después ${esc(i.autoD)}.</div>`:''}\n   <div class=\"form\">\n    <label>Ahorro MXN por mes<input id=\"dAh\" type=\"number\" step=\"any\" value=\"${esc(CURA.ah?.mxn??'')}\" placeholder=\"${ah&&ah.src!=='capturado'?fmt(ah.v,0)+' (calculado)':'captúralo si aplica'}\"${dis}></label>\n    ${CURA.src?.k==='ana'?`<label>Turnos al mes<input id=\"dTm\" type=\"number\" min=\"1\" step=\"1\" value=\"${esc(CURA.tm||44)}\"${dis}></label>`:''}\n   </div>\n   <div class=\"small muted\">${ah&&ah.src!=='capturado'?esc(ah.src)+'. Si capturas un ahorro, ese manda.':'El ahorro cuenta en los totales cuando la acción está cerrada.'}</div>\n  </div>\n  <div class=\"sec\"><h4>Fotos</h4><div class=\"ph\">${['a','d'].map(k=>`<figure>${CURA.fot?.[k]?`<img src=\"${CURA.fot[k]}\" alt=\"Foto ${k==='a'?'antes':'después'}\">`:`<div class=\"noimg\">Sin foto ${k==='a'?'de antes':'de después'}</div>`}<figcaption class=\"row\"><span class=\"small\">${k==='a'?'Antes':'Después'}</span>${RO?'':`<span><button type=\"button\" class=\"b\" data-foto=\"${k}\">${CURA.fot?.[k]?'Cambiar':'Tomar o subir'}</button>${CURA.fot?.[k]?` <button type=\"button\" class=\"b\" data-fotox=\"${k}\" aria-label=\"Quitar foto\">✕</button>`:''}</span>`}</figcaption></figure>`).join('')}</div></div>\n  <div class=\"sec\"><h4>Bitácora</h4><ul class=\"log\">${(CURA.log||[]).slice().reverse().map(l=>`<li><b>${esc(l.by||'')}</b> · <span class=\"muted\">${new Date(l.at).toLocaleString('es-MX',{dateStyle:'short',timeStyle:'short'})}</span><br>${esc(l.txt)}</li>`).join('')||'<li class=\"muted\">Sin comentarios.</li>'}</ul>\n   ${RO?'':`<div class=\"row\" style=\"flex-wrap:nowrap\"><input id=\"dLog\" placeholder=\"Avance, problema o acuerdo\"><button type=\"button\" class=\"b\" id=\"dLogB\">Agregar</button></div>`}</div>\n </div>\n <div class=\"df\">${INHUB&&goNav(CURA)?`<button type=\"button\" class=\"b\" id=\"dGo\">${esc(goNav(CURA)[1])}</button>`:''}${RO?'<span class=\"muted small\">Solo lectura</span>':`${A.some(x=>x.id===CURA.id)?'<button type=\"button\" class=\"b del\" id=\"dDel\">Eliminar</button>':''}<span class=\"sp\"></span><button type=\"button\" class=\"b\" value=\"x\" id=\"dCan\">Cancelar</button><button type=\"button\" class=\"b prim\" id=\"dSave\">Guardar</button>`}</div></form>`;\n d.showModal();gain();setTimeout(()=>{if(!CURA.t)$('dT')?.focus();},30);}\nfunction gain(){const g=$('dGain');if(!g)return;const a=$('dIa').value,d=$('dId').value,m=$('dIm').value,u=$('dIu').value;if(a===''||d===''){g.innerHTML='<span class=\"muted small\">Captura el antes y el después para ver la mejora.</span>';return;}\n const x=m==='down'?(+a-+d):(+d-+a),p=+a?x/Math.abs(+a):null;g.innerHTML=`<b style=\"color:${x>0?'var(--ok)':x<0?'var(--crit)':'var(--fg)'}\">${x>=0?'Mejoró':'Empeoró'} ${nf(Math.abs(x))} ${esc(u)}${p!=null?` (${fmt(Math.abs(p)*100,0)}%)`:''}</b>`;}\nasync function compress(file){const img=await new Promise((res,rej)=>{const u=URL.createObjectURL(file),i=new Image();i.onload=()=>{URL.revokeObjectURL(u);res(i);};i.onerror=rej;i.src=u;});\n const s=Math.min(1,720/Math.max(img.width,img.height)),c=document.createElement('canvas');c.width=Math.round(img.width*s);c.height=Math.round(img.height*s);c.getContext('2d').drawImage(img,0,0,c.width,c.height);return c.toDataURL('image/jpeg',.58);}\nfunction readForm(){const g=id=>$(id)?.value??'',num=v=>v===''?null:+v,a=CURA;\n a.t=g('dT').trim();a.pl=g('dPl');a.area=g('dAr').trim();a.perd=g('dPe');a.tipo=g('dTi');a.resp=g('dRe').trim();a.fc=g('dFc');a.desc=g('dDe').trim();\n const i=ind(a);a.ind={n:g('dIn').trim(),u:g('dIu').trim(),m:g('dIm'),a:i.autoA&&+g('dIa')===+i.a?null:num(g('dIa')),d:i.autoD&&+g('dId')===+i.d?null:num(g('dId'))};\n a.ah={mxn:g('dAh')===''?null:+g('dAh')};if($('dTm'))a.tm=+g('dTm')||44;a._es=g('dEs');return a;}\nasync function save(){const a=readForm(),old=A.find(x=>x.id===a.id),ne=$('dEs').value;if(!a.t){toast('Ponle un título a la acción.');$('dT').focus();return;}\n if(ne==='cerrada'&&(!old||old.est!=='cerrada')&&!ind(a).has&&!confirm('Vas a cerrar la acción sin el «después» medido. ¿Cerrarla así?'))return;\n a.log=a.log||[];if(!old){a.cr=a.cr||Date.now();a.by=a.by||ME;a.log.push({at:Date.now(),by:ME,txt:'Acción creada'});}\n if(old&&(old.est||'abierta')!==ne)a.log.push({at:Date.now(),by:ME,txt:`Estado: ${ESTN[old.est||'abierta']} → ${ESTN[ne]}`});\n delete a._es;a.est=ne;if(ne==='cerrada'&&!a.ce)a.ce=Date.now();if(ne!=='cerrada')delete a.ce;a.up=Date.now();\n const {id,...doc}=a;try{await dSet('acc/r1/a/'+id,doc);}catch(e){toast(e.code==='solo-lectura'?'Tu usuario es de solo lectura.':'No se pudo guardar: '+(e.message||e.code),8000);return;}\n const k=A.findIndex(x=>x.id===id);if(k<0)A.push(a);else A[k]=a;$('dlg').close();render();\n let used=0;try{for(let i=0;i<localStorage.length;i++){const kk=localStorage.key(i);used+=kk.length+(localStorage.getItem(kk)||'').length;}}catch(e){}\n toast(used>4.2e6?'Acción guardada. Ojo: el espacio de este navegador está casi lleno; usa menos fotos y «Publicar mis datos».':'Acción guardada.',used>4.2e6?9000:3500);}\n$('dlg').addEventListener('click',async e=>{const b=e.target.closest('button');if(!b)return;\n if(b.value==='x'){e.preventDefault();$('dlg').close();return;}\n if(b.id==='dSave'){e.preventDefault();return save();}\n if(b.id==='dGo'){e.preventDefault();const g=goNav(CURA);$('dlg').close();if(g)navTo(g[0]);return;}\n if(b.id==='dDel'){if(!confirm(`¿Eliminar «${CURA.t}»? Si solo ya no se va a hacer, mejor ponla como Cancelada para que quede el registro.`))return;try{await dDel('acc/r1/a/'+CURA.id);}catch(er){toast('No se pudo eliminar.');return;}A=A.filter(x=>x.id!==CURA.id);$('dlg').close();render();toast('Acción eliminada.');return;}\n if(b.id==='dLogB'){const v=$('dLog').value.trim();if(!v)return;readForm();(CURA.log=CURA.log||[]).push({at:Date.now(),by:ME,txt:v});openDlg(CURA);toast('Comentario agregado; se guarda al dar «Guardar».');return;}\n if(b.dataset.foto){FOTO=b.dataset.foto;readForm();$('fFoto').click();return;}\n if(b.dataset.fotox){readForm();if(CURA.fot)delete CURA.fot[b.dataset.fotox];openDlg(CURA);return;}});\n$('dlg').addEventListener('input',e=>{if(['dIa','dId','dIm','dIu'].includes(e.target.id))gain();});\n$('fFoto').onchange=async e=>{const f=e.target.files[0];e.target.value='';if(!f||!FOTO||!CURA)return;try{const u=await compress(f);(CURA.fot=CURA.fot||{})[FOTO]=u;openDlg(CURA);}catch(er){toast('No se pudo leer la foto.');}};\n\n/* ---------- eventos ---------- */\n$('tabs').onclick=e=>{const b=e.target.closest('button');if(b){view=b.dataset.v;render();}};\n$('fPl').onchange=e=>{F.pl=e.target.value;render();};$('fPe').onchange=e=>{F.pe=e.target.value;render();};$('fRe').onchange=e=>{F.re=e.target.value;render();};$('fV').onchange=e=>{F.v=e.target.checked;render();};\n$('fQ').oninput=e=>{F.q=e.target.value;clearTimeout($('fQ').t);$('fQ').t=setTimeout(render,200);};\ndocument.addEventListener('click',e=>{if(e.target.closest('[data-fref]')){F.ref='';render();return;}\n const pb=e.target.closest('[data-plant]');if(pb){navTo({to:'plant',plant:pb.dataset.plant});return;}\n const c=e.target.closest('[data-id]');if(c&&!e.target.closest('dialog')){const a=A.find(x=>x.id===c.dataset.id);if(a)openDlg(a);return;}\n const r=e.target.closest('[data-r]');if(r){REP=r.dataset.r;render();return;}\n if(e.target.id==='bPrint'){print();return;}if(e.target.id==='bCsv'){csv(list());}});\ndocument.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.matches('tr[data-id]'))e.target.click();});\n$('bNew').onclick=()=>openDlg({id:uid(),t:'',pl:F.refPl||F.pl||'p4',area:F.ref?F.refArea||'':'',est:'abierta',tipo:'Kaizen',src:F.ref?{k:F.refK||'man',ref:F.ref,lab:F.refLab||''}:{k:'man'},resp:'',fc:''});if(RO)$('bNew').hidden=true;\nlet theme='dark';try{theme=localStorage.getItem('rd_theme')||localStorage.getItem('rd_oee_theme')||'dark';}catch(e){}\nconst setTheme=t=>{theme=t;document.documentElement.dataset.theme=t;$('bTheme').textContent=t==='dark'?'☀ Fondo blanco':'☾ Fondo oscuro';try{localStorage.setItem('rd_theme',t);}catch(e){}try{parent.postMessage({src:'emb',type:'theme',v:t},'*');}catch(e){}};\n$('bTheme').onclick=()=>setTheme(theme==='dark'?'light':'dark');setTheme(theme);\nawait loadAll();render();\ntry{const n=parent.__rdNav;if(n&&n.to==='acc'){parent.__rdNav=null;if(n.id){const a=A.find(x=>x.id===n.id);if(a)openDlg(a);}else if(n.ref){F.ref=n.ref;F.refLab=n.lab||n.ref;F.refK=n.k||'man';F.refPl=n.pl||'';F.refArea=n.area||'';view='tab';render();}}}catch(e){}\nif(db){try{db.collection('acc/r1/a').onSnapshot(s=>{A=s.docs.map(d=>({id:d.id,...d.data()}));if(!$('dlg').open)render();},()=>{});db.collection('acc/r1/m').onSnapshot(s=>{M={};s.docs.forEach(d=>{M[d.id]={id:d.id,...d.data()};});if(!$('dlg').open)render();},()=>{});}catch(e){}}\ntry{const q=new URLSearchParams(location.hash.slice(1));if(q.get('v'))view=q.get('v');render();}catch(e){}\nwindow.__acc={state:()=>({n:A.length,view,M:Object.keys(M).length,OS:!!OS,AN:Object.keys(AN)}),open:id=>openDlg(A.find(x=>x.id===id)),reload:async()=>{await loadAll();render();},ind,ahorro};\n})();\n</script></body></html>\n"