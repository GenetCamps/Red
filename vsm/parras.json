}}\n else{NOTES.unshift(n);saveLocal();$('drTxt').value='';renderNotes();toast('Nota guardada en este dispositivo');}};\nconst FCATS=['Todas','Desorden / 5S','Mezcla de material','WIP / inventario','Falta de estandarización','Calidad / retrabajo','Tablero','Equipo','Otro'];\nfunction fillFotoProc(){$('fProc').innerHTML='<option value=\"\">General</option>'+PROCS.map(p=>`<option value=\"${p.id}\">${esc(p.n.join(' · '))}</option>`).join('');}\nasync function renderFotos(){const all=FOTOS.filter(f=>vs==='parras'||(f.vs||'parras')===vs);$('fCount').textContent=all.length?all.length:'';$('fotosVs').textContent=S.name;\n const present=FCATS.filter(c=>c==='Todas'||all.some(f=>f.cat===c));if(!present.includes(fFilter))fFilter='Todas';\n const procName=fProcFilter&&BY[fProcFilter]?BY[fProcFilter].n.join(' '):null;\n $('fChips').innerHTML=present.map(c=>`<button data-c=\"${esc(c)}\" aria-pressed=\"${c===fFilter&&!fProcFilter}\">${esc(c)} · ${c==='Todas'?all.length:all.filter(f=>f.cat===c).length}</button>`).join('')+(procName?`<button data-c=\"__p\" aria-pressed=\"true\">Caja: ${esc(procName)} ×</button>`:'');\n let rows=all.filter(f=>fFilter==='Todas'||f.cat===fFilter);if(fProcFilter)rows=rows.filter(f=>f.p===fProcFilter);\n rows.sort((a,b)=>(b.at||0)-(a.at||0));await resolveNames([...new Set(rows.map(f=>f.by))]);\n const g=$('gal');g.innerHTML='';\n if(!rows.length){g.innerHTML='<p class=\"empty\" style=\"grid-column:1/-1\">Sin fotos en esta vista.</p>';return;}\n rows.forEach(f=>{const fig=document.createElement('figure');const b=document.createElement('button');b.className='ph';b.setAttribute('aria-label','Ver foto: '+(f.cap||''));\n  const im=document.createElement('img');im.loading='lazy';im.alt=f.cap||'Foto de piso';im.src=fsrc(f);im.onerror=()=>{b.textContent='Foto no disponible';b.style.cssText+=';display:grid;place-items:center;color:var(--dim);font-size:12px';};\n  b.appendChild(im);b.onclick=()=>{$('lbImg').src=fsrc(f);$('lbImg').alt=f.cap||'';$('lbCap').textContent=f.cap||'';$('lb').hidden=false;$('lbX').focus();};\n  const fc=document.createElement('figcaption');const ch=document.createElement('div');ch.className='meta';\n  const c1=document.createElement('span');c1.className='chip';c1.textContent=f.cat||'Otro';ch.appendChild(c1);\n  if(f.p&&BY[f.p]){const c2=document.createElement('span');c2.textContent=BY[f.p].n[0];ch.appendChild(c2);}\n  const c3=document.createElement('span');c3.textContent=(f.fecha||(f.at?new Date(f.at).toLocaleDateString('es-MX',{day:'2-digit',month:'short'}):''))+' · '+whoLabel(f.by);ch.appendChild(c3);\n  const t=document.createElement('div');t.textContent=f.cap||'';fc.appendChild(ch);fc.appendChild(t);fotoTools(fc,f);fig.appendChild(b);fig.appendChild(fc);g.appendChild(fig);});}\n$('fChips').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.c==='__p'){fProcFilter=null;}else{fFilter=b.dataset.c;fProcFilter=null;}renderFotos();});\n$('lbX').onclick=()=>{$('lb').hidden=true;};$('lb').onclick=e=>{if(e.target.id==='lb')$('lb').hidden=true;};\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape'){if(!$('lb').hidden)$('lb').hidden=true;else if(drId)closeDrawer();}});\n\n/* ===================== edición por el usuario: notas y fotos ===================== */\nlet RO=false;try{RO=!!(parent&&parent.RD_RO);}catch(e){}\nconst FL={};let _idb=null;\nfunction idbOpen(){return _idb||(_idb=new Promise((res,rej)=>{const r=indexedDB.open('rd_vsm_fotos',1);r.onupgradeneeded=()=>r.result.createObjectStore('f');r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error);}));}\nfunction idbRun(mode,fn){return idbOpen().then(d=>new Promise((res,rej)=>{const t=d.transaction('f',mode),q=fn(t.objectStore('f'));t.oncomplete=()=>res(q&&q.result);t.onerror=()=>rej(t.error);}));}\nfunction fsrc(f){if(!f.local)return 'vsm/fotos/'+f.asset+'.jpg';if(FL[f.local])return FL[f.local];\n if(FL[f.local]!==null){FL[f.local]=null;idbRun('readonly',s=>s.get(f.local)).then(b=>{if(b){FL[f.local]=URL.createObjectURL(b);renderFotos();}}).catch(()=>{});}return '';}\nfunction edBtn(txt,cls,fn){const b=document.createElement('button');b.type='button';b.textContent=txt;if(cls)b.className=cls;b.onclick=fn;return b;}\nfunction noteTools(li,pp,n){if(RO||!live||!n.id)return;const row=document.createElement('div');row.className='edrow';\n row.appendChild(edBtn('Corregir','',()=>{const ta=document.createElement('textarea');ta.rows=3;ta.value=n.t||'';ta.setAttribute('aria-label','Texto de la nota');pp.replaceWith(ta);row.innerHTML='';\n  row.appendChild(edBtn('Guardar','',async()=>{const t=ta.value.trim();if(!t){toast('La nota no puede quedar vacía.');return;}try{await db.collection('notas').doc(n.id).update({t:t.slice(0,2000),ed:Date.now()});toast('Nota corregida');}catch(e){toast('No se pudo guardar la nota.');}}));\n  row.appendChild(edBtn('Cancelar','',()=>renderNotes()));ta.focus();}));\n row.appendChild(edBtn('Eliminar','del',async()=>{if(!confirm('¿Eliminar esta nota? No se puede deshacer.'))return;try{await db.collection('notas').doc(n.id).update({del:Date.now()});toast('Nota eliminada');}catch(e){toast('No se pudo eliminar la nota.');}}));\n li.appendChild(row);}\nfunction fotoTools(fc,f){if(RO||!live||!f.id)return;const row=document.createElement('div');row.className='edrow';\n row.appendChild(edBtn('Editar','',()=>{row.hidden=true;const fm=document.createElement('div');fm.className='edrow edform';\n  const ta=document.createElement('textarea');ta.rows=3;ta.maxLength=400;ta.value=f.cap||'';ta.setAttribute('aria-label','Qué se ve en la foto');\n  const sc=document.createElement('select');sc.setAttribute('aria-label','Categoría');sc.innerHTML=FCATS.slice(1).map(c=>`<option${c===(f.cat||'Otro')?' selected':''}>${esc(c)}</option>`).join('');\n  const sp=document.createElement('select');sp.setAttribute('aria-label','Caja del mapa');sp.innerHTML='<option value=\"\">General</option>'+PROCS.map(p=>`<option value=\"${p.id}\"${p.id===f.p?' selected':''}>${esc(p.n.join(' · '))}</option>`).join('');\n  const bar=document.createElement('div');bar.className='edrow';\n  bar.appendChild(edBtn('Guardar','',async()=>{try{await db.collection('fotos').doc(f.id).update({cap:ta.value.trim().slice(0,400),cat:sc.value,p:sp.value||null});toast('Foto actualizada');}catch(e){toast('No se pudo guardar la foto.');}}));\n  bar.appendChild(edBtn('Cancelar','',()=>renderFotos()));fm.appendChild(ta);fm.appendChild(sc);fm.appendChild(sp);fm.appendChild(bar);fc.appendChild(fm);ta.focus();}));\n row.appendChild(edBtn('Eliminar','del',async()=>{if(!confirm('¿Eliminar esta foto del VSM? No se puede deshacer.'))return;try{await db.collection('fotos').doc(f.id).update({del:Date.now()});if(f.local)idbRun('readwrite',s=>s.delete(f.local)).catch(()=>{});toast('Foto eliminada');}catch(e){toast('No se pudo eliminar la foto.');}}));\n fc.appendChild(row);}\nfunction shrink(file){return new Promise(res=>{if(!/^image\\/(jpeg|png|webp)$/.test(file.type)){res(file);return;}const u=URL.createObjectURL(file),im=new Image();\n im.onload=()=>{const k=Math.min(1,1920/Math.max(im.width,im.height));if(k>=1&&file.size<2.5e6){URL.revokeObjectURL(u);res(file);return;}const c=document.createElement('canvas');c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext('2d').drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);c.toBlob(b=>res(b||file),'image/jpeg',.85);};\n im.onerror=()=>{URL.revokeObjectURL(u);res(file);};im.src=u;});}\n$('bFoto').onclick=async()=>{const files=[...$('fFile').files];if(!files.length){toast('Elige una foto primero');return;}if(!live||RO){toast('Tu usuario no puede subir fotos.');return;}\n const btn=$('bFoto');btn.disabled=true;let ok=0;\n for(const f of files){$('fNote').textContent=`Subiendo ${ok+1} de ${files.length}…`;\n  try{const b=await shrink(f);const t=b.type&&/^image\\//.test(b.type)?b.type:'image/jpeg';let rec;if(assets){const r=await assets.upload(b,{type:t});rec={asset:r.id};}else{const k='l'+Date.now().toString(36)+Math.random().toString(36).slice(2,6);await idbRun('readwrite',s=>s.put(b,k));rec={local:k};}\n   await db.collection('fotos').add({vs,...rec,cat:$('fCat').value,p:$('fProc').value||null,cap:$('fCap').value.trim().slice(0,400),by:me||'',at:Date.now()});ok++;}\n  catch(e){const c=e&&e.code;toast(c==='too_large'?'La foto es muy pesada.':c==='unsupported_type'?'Formato no soportado: usa JPG o PNG.':c==='quota_or_state'?'Se llenó el espacio de fotos.':'No se pudo subir una foto.');}}\n btn.disabled=false;$('fNote').textContent=ok?`${ok} foto(s) subida(s).`:'';$('fFile').value='';$('fCap').value='';};\nfunction setTab(t){tab=t;if(t==='ct'&&S)renderCT();document.querySelectorAll('.tabs button').forEach(b=>b.setAttribute('aria-selected',String(b.dataset.tab===t)));\n document.querySelectorAll('[data-panel]').forEach(p=>{p.hidden=p.dataset.panel!==t;});}\ndocument.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>setTab(b.dataset.tab)));\n[['lyInfo','info','#gInfo'],['lyMov','mov','#gMov'],['lyKb','kb','#gKb'],['lyQ','q','#gQ'],['lyT','t','#gT']].forEach(([id,k,s])=>{$(id).addEventListener('change',e=>{LY[k]=e.target.checked;const g=svg.querySelector(s);if(g){if(LY[k])g.removeAttribute('display');else g.setAttribute('display','none');}});});\nconst bPlay=$('bPlay');function syncPlay(){bPlay.textContent=playing?'❚❚ Pausar':'▶ Reanudar';bPlay.setAttribute('aria-pressed',String(playing));$('app').classList.toggle('paused',!playing);}\nbPlay.onclick=()=>{playing=!playing;syncPlay();};\nfunction setZoom(z){zoom=Math.max(1,Math.min(2,z));svg.style.width=(zoom*100)+'%';svg.style.minWidth=(1320*zoom)+'px';}\n$('zIn').onclick=()=>setZoom(zoom+.25);$('zOut').onclick=()=>setZoom(zoom-.25);$('zFit').onclick=()=>setZoom(1);\nfunction setLive(on){live=on;const p=$('liveP');p.className='pill '+(on?'live':'loc');p.innerHTML=on?'<i></i>Guardado en este navegador':'<i></i>Solo este dispositivo';}\n\n\n/* ===================== fondo blanco u oscuro (igual que la consola de P4) ===================== */\nconst THEMES={dark:Object.assign({},C,{boxTop:'#122030',boxOn:'#15283a'}),light:{boxTop:'#eef3f8',boxOn:'#d9eafb',bg:'#f3f6fa',panel:'#ffffff',panel2:'#f7f9fc',raise:'#e8eef5',line:'#d3dce6',line2:'#aebccb',fg:'#16202c',muted:'#4a5a6b',dim:'#7b8a99',mat:'#0b6fc2',info:'#6a4fd6',inv:'#b06a00',crit:'#d22c4d',ok:'#0d8a55',draft:'#8a6718',kb:'#2f7de0',tesla:'#d6452f'}};\nconst BG2={dark:'#0a1017',light:'#e9eef4'};\nlet theme='dark';try{theme=localStorage.getItem('vsm-parras-theme')||'dark';}catch(e){}\nfunction applyTheme(t,rer){theme=THEMES[t]?t:'dark';Object.assign(C,THEMES[theme]);const st=document.documentElement.style;\n ['bg','panel','panel2','raise','line','line2','fg','muted','dim','mat','info','inv','crit','ok','draft','tesla'].forEach(k=>st.setProperty('--'+k,C[k]));\n st.setProperty('--bg2',BG2[theme]);st.setProperty('color-scheme',theme);document.documentElement.dataset.theme=theme;\n const b=$('bTheme');if(b){b.textContent=theme==='dark'?'☀ Fondo blanco':'☾ Fondo oscuro';b.setAttribute('aria-pressed',String(theme==='light'));}\n try{localStorage.setItem('vsm-parras-theme',theme);}catch(e){}\n try{parent.postMessage({src:'emb',type:'theme',v:theme},'*');}catch(e){}\n if(rer)setStream(vs);}\n$('bTheme').onclick=()=>applyTheme(theme==='dark'?'light':'dark',true);\napplyTheme(theme,false);\n\n/* ===================== edición por el usuario: cajas (texto y foco rojo) ===================== */\nconst ORIGP=JSON.parse(JSON.stringify(ALLP));let PED={};\nfunction applyPed(){Object.keys(ALLP).forEach(id=>{const o=ORIGP[id],p=ALLP[id],e=PED[id];p.n=o.n.slice();['pl','res','flag'].forEach(k=>{if(o[k]===undefined)delete p[k];else p[k]=o[k];});delete p.edited;\n  if(!e)return;if(e.n1!==undefined)p.n[0]=e.n1;if(e.n2!==undefined)p.n[1]=e.n2;['pl','res','flag'].forEach(k=>{if(e[k]!==undefined)p[k]=e[k];});p.edited=true;});}\nfunction pedRefresh(){applyPed();const keep=drId;setStream(vs);if(keep&&BY[keep])openDrawer(keep);}\nasync function p