"<!doctype html><html><head><meta charset=utf8><meta name=viewport content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>\n<title>VSM Parras</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap\">\n<style>\n/* Layout: consola de operaciones — selector de value stream (Rivian / Tesla) + pestañas; la vista principal es KPIs + mapa + captura; notas, revisión y guía en pestañas aparte */\n:root{\n  color-scheme: dark;\n  --bg:#070b10; --bg2:#0a1017; --panel:#0e161f; --panel2:#0b121a; --raise:#132030;\n  --line:#1c2a38; --line2:#2a3d50; --fg:#e6eef5; --muted:#8a9cae; --dim:#5a6d80;\n  --mat:#48c2ff; --info:#a48bff; --inv:#ffb321; --crit:#ff5a76; --ok:#3ddc97; --draft:#d9b26a; --tesla:#ff6b5a;\n  --display:\"Barlow Condensed\",\"Arial Narrow\",system-ui,sans-serif;\n  --body:\"IBM Plex Sans\",system-ui,-apple-system,\"Segoe UI\",sans-serif;\n  --mono:\"JetBrains Mono\",ui-monospace,Menlo,Consolas,monospace;\n}\n*{box-sizing:border-box}\nbody{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:14px;line-height:1.45}\n.wrap{max-width:1680px;margin:0 auto;padding-inline:16px;padding-block:14px 48px;display:flex;flex-direction:column;gap:14px}\n.top{display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center;justify-content:space-between}\n.dmlogo{height:62px;width:auto;flex:none;padding-right:16px;border-right:1px solid var(--line2)}\n@media (max-width:640px){.dmlogo{height:44px;padding-right:12px}}\n.brand{display:flex;align-items:center;gap:14px;min-width:0}\n.mark{width:40px;height:40px;border-radius:9px;border:1px solid var(--line2);display:grid;place-items:center;background:linear-gradient(160deg,#10202e,#0a121a);flex:none}\n.eyebrow{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}\n.eyebrow b{color:var(--mat);font-weight:500}\nh1{font-family:var(--display);font-weight:700;font-size:clamp(28px,3.6vw,40px);line-height:1;margin:2px 0 0;letter-spacing:.01em;text-wrap:balance}\n.controls{display:flex;gap:8px;flex-wrap:wrap;align-items:center}\n.pill{font-family:var(--mono);font-size:10.5px;letter-spacing:.05em;padding:5px 10px;border-radius:999px;border:1px solid var(--line2);color:var(--muted);white-space:nowrap;display:inline-flex;gap:6px;align-items:center}\n.pill i{width:7px;height:7px;border-radius:50%;background:var(--dim);display:inline-block}\n.pill.live{color:var(--ok);border-color:color-mix(in srgb,var(--ok) 50%,transparent)} .pill.live i{background:var(--ok);box-shadow:0 0 8px var(--ok)}\n.pill.loc{color:var(--inv);border-color:color-mix(in srgb,var(--inv) 50%,transparent)} .pill.loc i{background:var(--inv)}\n.btn{all:unset;cursor:pointer;font-family:var(--mono);font-size:11.5px;letter-spacing:.04em;padding:8px 12px;border:1px solid var(--line2);border-radius:8px;color:var(--fg);background:var(--panel2);display:inline-flex;gap:6px;align-items:center;white-space:nowrap}\n.btn:hover{border-color:var(--mat)}\n.btn.primary{background:var(--mat);color:#03121c;border-color:var(--mat);font-weight:600}\n.btn:focus-visible,.seg button:focus-visible,.tabs button:focus-visible,.vs button:focus-visible{outline:2px solid var(--mat);outline-offset:2px}\n.btn[disabled]{opacity:.5;cursor:default}\n.nav{display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}\n.vs{display:inline-flex;gap:6px;padding-bottom:10px;flex-wrap:wrap}\n.vs button{all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:9px;border:1px solid var(--line2);background:var(--panel2);font-family:var(--display);font-size:17px;font-weight:600;letter-spacing:.03em;color:var(--muted)}\n.vs button span{font-family:var(--mono);font-size:10px;font-weight:400;letter-spacing:.06em;color:var(--dim)}\n.vs button[aria-pressed=\"true\"]{color:var(--fg);border-color:var(--c);box-shadow:inset 0 0 0 1px var(--c);background:color-mix(in srgb,var(--c) 10%,var(--panel2))}\n.tabs{display:inline-flex;gap:2px;flex-wrap:wrap}\n.tabs button{all:unset;cursor:pointer;font-family:var(--mono);font-size:11.5px;letter-spacing:.05em;padding:10px 14px;color:var(--muted);border-bottom:2px solid transparent}\n.tabs button[aria-selected=\"true\"]{color:var(--fg);border-bottom-color:var(--mat)}\n.tabs button .ct{font-size:10px;color:var(--dim);margin-left:4px}\n.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden}\n.kpi{background:var(--panel);padding:12px 14px 11px;min-width:0;position:relative}\n.kpi .l{font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.kpi .v{font-family:var(--display);font-weight:600;font-size:30px;line-height:1.08;margin-top:5px;font-variant-numeric:tabular-nums;white-space:nowrap}\n.kpi .v small{font-size:14px;color:var(--muted);font-weight:500;margin-left:3px}\n.kpi .v.na{color:var(--dim)}\n.kpi .d{font-family:var(--mono);font-size:10.5px;color:var(--dim);margin-top:3px;min-height:15px}\n.kpi.alert::before{content:\"\";position:absolute;inset:0 auto 0 0;width:3px;background:var(--crit)}\n.kpi.alert .v{color:var(--crit)}\n.meter{height:4px;border-radius:2px;background:var(--panel2);margin-top:6px;overflow:hidden}\n.meter span{display:block;height:100%;background:linear-gradient(90deg,var(--inv),var(--ok));transition:width .6s ease}\n.mapshell{position:relative;background:radial-gradient(1400px 500px at 50% -10%,#0f2131 0%,var(--bg2) 62%);border:1px solid var(--line);border-radius:14px;overflow:hidden}\n.maptools{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--panel2) 80%,transparent)}\n.grp{display:flex;flex-wrap:wrap;gap:6px;align-items:center}\n.grp .lab{font-family:var(--mono);font-size:10.5px;color:var(--dim);letter-spacing:.08em;text-transform:uppercase;margin-right:2px}\n.tg{display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11px;color:var(--muted);padding:5px 9px;border:1px solid var(--line2);border-radius:999px;cursor:pointer;user-select:none}\n.tg input{appearance:none;width:8px;height:8px;border-radius:50%;margin:0;background:var(--dim);cursor:pointer}\n.tg input:checked{background:var(--c,var(--mat));box-shadow:0 0 8px var(--c,var(--mat))}\n.tg:has(input:checked){color:var(--fg)}\n.tg:focus-within{outline:2px solid var(--mat);outline-offset:2px}\n.seg{display:inline-flex;border:1px solid var(--line2);border-radius:8px;padding:2px;background:var(--panel2)}\n.seg button{all:unset;cursor:pointer;font-family:var(--mono);font-size:11px;padding:5px 10px;border-radius:6px;color:var(--muted)}\n.seg button[aria-pressed=\"true\"]{background:var(--raise);color:var(--fg);box-shadow:inset 0 0 0 1px var(--mat)}\n.zoom{display:inline-flex;border:1px solid var(--line2);border-radius:8px;overflow:hidden}\n.zoom button{all:unset;cursor:pointer;font-family:var(--mono);font-size:12px;padding:5px 10px;color:var(--fg)}\n.zoom button+button{border-left:1px solid var(--line2)}\n.zoom button:focus-visible{outline:2px solid var(--mat)}\n.mapscroll{overflow:auto}\n#map{display:block;width:100%;min-width:1320px;height:auto}\n#map text{font-family:var(--mono);fill:var(--fg)}\n#map .pn{font-family:var(--display);font-weight:600;font-size:17px;letter-spacing:.02em}\n#map .pn2{font-family:var(--display);font-weight:500;font-size:13.5px;fill:var(--muted)}\n#map .lbl{font-size:10.5px;fill:var(--muted)}\n#map .val{font-size:11.5px;text-anchor:end;font-weight:500}\n#map .op{font-size:9.5px;letter-spacing:.12em;fill:var(--dim)}\n#map .proc{cursor:pointer;outline:none}\n#map .proc:hover .frame,#map .proc:focus-visible .frame{stroke:var(--mat)}\n#map .flow{stroke-dasharray:7 6;animation:dash 1.1s linear infinite}\n#map .pulse{animation:pulse 1.6s ease-in-out infinite}\n@keyframes dash{to{stroke-dashoffset:-13}}\n@keyframes pulse{0%,100%{stroke-opacity:1}50%{stroke-opacity:.3}}\n.paused #map .flow,.paused #map .pulse{animation-play-state:paused}\n@media (prefers-reduced-motion:reduce){#map .flow,#map .pulse{animation:none}}\n.legend{display:flex;flex-wrap:wrap;gap:8px 18px;padding:9px 14px;border-top:1px solid var(--line);font-family:var(--mono);font-size:10.5px;color:var(--muted)}\n.legend i{display:inline-block;width:20px;height:8px;border-radius:2px;margin-right:6px;vertical-align:middle}\n.tip{position:fixed;z-index:20;pointer-events:none;background:#0b131bf2;border:1px solid var(--line2);border-radius:8px;padding:8px 10px;font-family:var(--mono);font-size:11px;line-height:1.55;color:var(--fg);white-space:pre-line;max-width:320px;box-shadow:0 10px 30px #0008}\n.grid2{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:14px}\n@media (max-width:980px){.grid2{grid-template-columns:minmax(0,1fr)}}\n[hidden]{display:none!important}\n.drawer{position:fixed;top:0;right:0;height:100%;width:min(460px,100%);background:var(--panel);border-left:1px solid var(--line2);box-shadow:-24px 0 48px rgba(0,0,0,.5);transform:translateX(105%);transition:transform .25s ease;z-index:60;display:flex;flex-direction:column}\n.drawer.open{transform:none}\n.drawer .dh{padding:18px 20px 14px;border-bottom:1px solid var(--line);display:flex;gap:12px;align-items:flex-start}\n.drawer .dh .t{flex:1;min-width:0}\n.drawer .dh .k{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;color:var(--muted);text-transform:uppercase}\n.drawer .dh h3{margin:4px 0 0;font-size:20px;line-height:1.2}\n.drawer .dh h3 small{display:block;font-size:13px;color:var(--muted);font-weight:500;margin-top:2px}\n.drawer .x{background:none;border:1px solid var(--line2);color:var(--fg);border-radius:8px;width:34px;height:34px;font-size:18px;cursor:pointer;flex:none}\n.drawer .db{padding:16px 20px 24px;overflow:auto;flex:1;display:flex;flex-direction:column;gap:14px}\n.drawer .res{font-size:13.5px;line-height:1.55;color:var(--fg);background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:12px 14px}\n.drawer .flg{font-size:13px;line-height:1.5;color:var(--inv);border-left:3px solid var(--inv);padding:4px 0 4px 10px}\n.drawer .sec{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;color:var(--muted);text-transform:uppercase;display:flex;justify-content:space-between;align-items:center}\n.drawer .sec button{font:inherit;letter-spacing:.06em;background:none;border:none;color:var(--mat);cursor:pointer;text-transform:none}\n.drawer textarea{width:100%;box-sizing:border-box}\n.scrim{position:fixed;inset:0;background:rgba(3,6,10,.45);z-index:59}\n.gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}\n.gal figure{margin:0;background:var(--panel2);border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column}\n.gal button.ph{all:unset;cursor:zoom-in;display:block;aspect-ratio:4/3;background:#0b1118}\n.gal img{width:100%;height:100%;object-fit:cover;display:block}\n.gal figcaption{padding:10px 12px 12px;display:flex;flex-direction:column;gap:6px;font-size:13px;line-height:1.45}\n.gal .meta{font-family:var(--mono);font-size:10.5px;color:var(--muted);display:flex;gap:8px;flex-wrap:wrap}\n.chip{display:inline-block;font-family:var(--mono);font-size:10.5px;padding:2px 8px;border-radius:999px;border:1px solid var(--line2);color:var(--fg)}\n.chips{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 14px}\n.chips button{font-family:var(--mono);font-size:11px;padding:5px 11px;border-radius:999px;border:1px solid var(--line2);background:none;color:var(--muted);cursor:pointer}\n.chips button[aria-pressed=\"true\"]{color:var(--bg);background:var(--mat);border-color:var(--mat)}\n.lb{position:fixed;inset:0;background:rgba(3,6,10,.92);z-index:70;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;gap:12px}\n.lb img{max-width:100%;max-height:82vh;border-radius:8px}\n.lb p{color:var(--fg);max-width:900px;text-align:center;font-size:14px;line-height:1.5;margin:0}\n.upf{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-bottom:16px}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px 18px;min-width:0}\n.card h2{font-family:var(--display);font-weight:600;font-size:22px;letter-spacing:.02em;margin:0 0 4px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n.card h3{font-family:var(--display);font-size:16px;font-weight:600;margin:18px 0 8px;color:var(--muted);letter-spacing:.04em}\n.card .kick{font-family:var(--mono);font-size:10.5px;color:var(--muted);margin:0 0 14px}\n.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}\n.form label{font-family:var(--mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);display:flex;flex-direction:column;gap:4px;min-width:0}\n.form input,.form select,#procSel,#noteTxt{width:100%;background:var(--panel2);border:1px solid var(--line2);border-radius:7px;color:var(--fg);font-family:var(--mono);font-size:13px;padding:8px 9px}\n.form input:focus,.form select:focus,#procSel:focus,#noteTxt:focus{outline:none;border-color:var(--mat)}\n.form input::placeholder{color:var(--draft);opacity:.75}\n#procSel{font-family:var(--display);font-size:18px;font-weight:600;padding:8px 10px;margin-bottom:12px}\ndetails.more{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}\ndetails.more summary{cursor:pointer;font-family:var(--mono);font-size:11px;color:var(--muted);margin-bottom:10px}\n.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:12px}\n.note{font-family:var(--mono);font-size:10.5px;color:var(--dim)}\n.flag{border:1px dashed color-mix(in srgb,var(--inv) 60%,transparent);background:color-mix(in srgb,var(--inv) 7%,transparent);border-radius:8px;padding:9px 12px;font-size:13px;margin:0 0 12px}\n.flag b{color:var(--inv);font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;margin-right:6px}\n.check{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}\n.check li{display:grid;grid-template-columns:18px 1fr;gap:8px;font-size:13px}\n.check li::before{content:\"\";width:12px;height:12px;border:1.5px solid var(--line2);border-radius:3px;margin-top:3px}\nul.ins{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:11px}\nul.ins li{display:grid;grid-template-columns:96px 1fr;gap:10px;align-items:start}\nul.ins .tag{font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;padding:3px 6px;border-radius:5px;border:1px solid var(--line2);color:var(--muted);text-align:center}\nul.ins .tag.r{color:var(--crit);border-color:color-mix(in srgb,var(--crit) 50%,transparent)}\nul.ins .tag.a{color:var(--inv);border-color:color-mix(in srgb,var(--inv) 50%,transparent)}\nul.ins .tag.b{color:var(--mat);border-color:color-mix(in srgb,var(--mat) 50%,transparent)}\nul.ins .tag.v{color:var(--info);border-color:color-mix(in srgb,var(--info) 50%,transparent)}\nul.ins .tag.h{color:var(--ok);border-color:color-mix(in srgb,var(--ok) 50%,transparent)}\n.notes{list-style:none;margin:12px 0 0;padding:0;display:flex;flex-direction:column;gap:8px}\n.notes li{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:8px 10px}\n.notes .m{font-family:var(--mono);font-size:10px;color:var(--muted);display:flex;gap:8px;flex-wrap:wrap}\n.notes .m b{color:var(--mat);font-weight:500}\n.notes p{margin:3px 0 0;font-size:13px;white-space:pre-wrap;overflow-wrap:anywhere}\n.empty{font-family:var(--mono);font-size:11px;color:var(--dim);padding:10px 0}\n.gl{width:100%;border-collapse:collapse;font-size:13px}\n.gl td,.gl th{padding:8px 6px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}\n.gl th{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:500}\n.gl td:first-child{font-family:var(--mono);color:var(--mat);white-space:nowrap}\n.need{font-family:var(--mono);font-size:10px;padding:2px 7px;border-radius:5px;border:1px solid;white-space:nowrap}\n.need.y{color:var(--ok)}.need.m{color:var(--inv)}.need.n{color:var(--dim)}\n.plan{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}\n.plan li{display:grid;grid-template-columns:62px 1fr;gap:10px}\n.plan b{font-family:var(--display);font-size:17px;color:var(--mat)}\n.cbar{height:6px;border-radius:3px;background:var(--panel2);min-width:90px;overflow:hidden;margin-top:4px}\n.cbar span{display:block;height:100%}\n#tabTbl td{font-variant-numeric:tabular-nums}\n#tabTbl td.num{font-family:var(--mono);text-align:right;white-space:nowrap}\n.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--raise);border:1px solid var(--line2);border-radius:10px;padding:10px 16px;font-family:var(--mono);font-size:12px;z-index:30;box-shadow:0 10px 30px #000a}\n#jsonOut{width:100%;min-height:110px;margin-top:10px;background:var(--panel2);color:var(--fg);border:1px solid var(--line2);border-radius:8px;font-family:var(--mono);font-size:11px;padding:10px}\nfooter{font-family:var(--mono);font-size:10.5px;color:var(--dim);display:flex;flex-wrap:wrap;gap:6px 18px;border-top:1px solid var(--line);padding-top:12px}\n[data-panel^=\"vp\"]{--ok:#34d399;--ok2:#1f6b50;--amb:#fbbf24;--org:#fb923c;--red:#f87171;--hi:#22d3ee;--nodata:#2a3646;--accent:#38bdf8;--c1:#a78bfa;--c2:#f472b6;--c3:#fbbf24;--c4:#22d3ee;--c5:#fb923c;--c6:#f87171;--c7:#60a5fa;--c8:#8a99a8}\n.vp-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px}\n.vp-ki{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:12px 14px}\n.vp-ki .vp-l{font:600 10.5px/1.2 var(--mono,ui-monospace,monospace);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}\n.vp-ki .vp-v{font-size:28px;font-weight:700;margin:6px 0 2px;letter-spacing:-.02em}\n.vp-ki .vp-d{font-size:12px;color:var(--muted);line-height:1.35}\n.vp-ki.vp-bad .vp-v{color:var(--red)}.vp-ki.vp-warn .vp-v{color:var(--amb)}.vp-ki.vp-good .vp-v{color:var(--ok)}\n.vp-hmscroll{overflow-x:auto;background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:10px 10px 8px}\n.vp-hm{display:grid;grid-template-columns:128px repeat(var(--n),22px) 72px;gap:3px;min-width:max-content;align-items:center}\n.vp-hm .vp-rl{font-size:12.5px;font-weight:600;position:sticky;left:0;background:var(--panel2);padding-right:6px;z-index:1;line-height:1.15}\n.vp-hm .vp-rl small{display:block;font-weight:400;color:var(--muted);font-size:10px;max-width:124px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.vp-hm .vp-dh{font:10px/1 ui-monospace,Menlo,monospace;color:var(--muted);text-align:center}\n.vp-hm .vp-dh.vp-wk{border-left:2px solid var(--line)}\n.vp-hm button.vp-c{all:unset;cursor:pointer;width:22px;height:22px;border-radius:5px;display:block}\n.vp-hm button.vp-c:focus-visible{outline:2px solid var(--accent)}\n.vp-hm .vp-e{width:22px;height:22px}\n.vp-hm .vp-sum{font:600 11.5px/1.15 ui-monospace,Menlo,monospace;text-align:right;white-space:nowrap}\n.vp-hm .vp-sum small{display:block;color:var(--muted);font-weight:400;font-size:10px}\n.vp-hm button.vp-b-hi,.vp-leg .vp-b-hi{background:var(--hi)}.vp-hm button.vp-b-ok,.vp-leg .vp-b-ok{background:var(--ok)}.vp-hm button.vp-b-g2,.vp-leg .vp-b-g2{background:var(--ok2)}.vp-hm button.vp-b-amb,.vp-leg .vp-b-amb{background:var(--amb)}.vp-hm button.vp-b-org,.vp-leg .vp-b-org{background:var(--org)}.vp-hm button.vp-b-red,.vp-leg .vp-b-red{background:var(--red)}\n.vp-hm button.vp-b-nd,.vp-leg .vp-b-nd{background:repeating-linear-gradient(45deg,var(--nodata),var(--nodata) 3px,transparent 3px,transparent 6px);box-shadow:inset 0 0 0 1px var(--nodata)}\n.vp-leg{display:flex;flex-wrap:wrap;gap:12px;font-size:11.5px;color:var(--muted);margin:10px 0 0}\n.vp-leg i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:5px;vertical-align:-2px}\n.vp-det{background:var(--panel2);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:12px;padding:12px 14px;margin-top:10px;font-size:13.5px;min-height:56px}\n.vp-det .vp-t{font-size:14.5px;font-weight:700}\n.vp-det .vp-m{display:flex;flex-wrap:wrap;gap:14px;margin:4px 0 6px;font:12px/1.2 ui-monospace,Menlo,monospace;color:var(--muted)}\n.vp-det .vp-it{border-top:1px solid var(--line);padding:6px 0;margin-top:6px}\n.vp-chip{display:inline-block;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;color:#fff;background:var(--c8)}\n.vp-ms{overflow-x:auto;background:var(--panel2);border:1px solid var(--line);border-radius:12px}\ntable.vp-mat{border-collapse:collapse;min-width:720px;width:100%;font-size:12.5px}\ntable.vp-mat th{font-weight:600;color:var(--muted);font-size:11px;padding:8px 6px;text-align:center;vertical-align:bottom;line-height:1.2}\ntable.vp-mat th.vp-f,table.vp-mat td.vp-f{text-align:left;padding-left:12px;position:sticky;left:0;background:var(--panel2);z-index:1}\ntable.vp-mat td{padding:3px;text-align:center}\ntable.vp-mat td button{all:unset;cursor:pointer;display:block;width:100%;padding:7px 2px;border-radius:6px;font:600 11.5px/1 ui-monospace,Menlo,monospace;color:var(--fg)}\ntable.vp-mat td button:focus-visible{outline:2px solid var(--accent)}\ntable.vp-mat td .vp-fx{display:block;padding:7px 2px;border-radius:6px;font:600 11.5px/1 ui-monospace,Menlo,monospace}\ntable.vp-mat tr.vp-tot td{border-top:1px solid var(--line);font:600 11.5px ui-monospace,Menlo,monospace;padding-top:8px}\n.vp-sv{overflow-x:auto}\n.vp-two{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:14px}\ntable.vp-rt{border-collapse:collapse;width:100%;font-size:12.5px}\ntable.vp-rt th{color:var(--muted);font-size:11px;font-weight:600;text-align:left;padding:4px 6px;border-bottom:1px solid var(--line)}\ntable.vp-rt td{padding:6px;border-bottom:1px solid var(--line);vertical-align:top}\n.vp-bar{height:8px;border-radius:4px;background:var(--panel2);overflow:hidden;margin-top:3px}.vp-bar i{display:block;height:100%}\n.vp-fgrow{display:grid;grid-template-columns:96px 1fr 58px;gap:8px;align-items:center;font-size:12.5px;margin:4px 0}\n.vp-fgrow .vp-n{font-weight:600}.vp-fgrow .vp-v{text-align:right;font:600 11.5px ui-monospace,Menlo,monospace}\n.vp-in{border-left:4px solid var(--amb);background:var(--panel2);border-radius:0 12px 12px 0;padding:10px 14px;margin:10px 0;border:1px solid var(--line);border-left:4px solid var(--amb)}\n.vp-in b{display:block;margin-bottom:2px}\n.vp-note{font-size:12px;color:var(--muted);margin-top:10px}\n.vp-sub{font-size:12.5px;color:var(--muted)}\n.vp-pl{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:8px}\n.vp-pi{display:flex;gap:10px;background:var(--panel2);border:1px solid var(--line);border-left:4px solid var(--sev);border-radius:10px;padding:9px 12px}\n.vp-pi .vp-pn{flex:none;width:24px;height:24px;border-radius:50%;color:#fff;font-weight:800;font-size:13px;display:flex;align-items:center;justify-content:center}\n.vp-pi .vp-pd{font-size:12.5px;color:var(--muted);line-height:1.4;margin-top:1px}\n.vp-pi .vp-st{font:600 10px/1 ui-monospace,monospace;letter-spacing:.06em;color:var(--sev);margin-bottom:3px}\n\n.vp-alert{background:linear-gradient(135deg,#7f1111,#c62828);border:2px solid #ff6b6b;border-radius:14px;padding:18px 22px;color:#fff}\n.vp-alert .vp-ah{font:800 12px/1 ui-monospace,Menlo,monospace;letter-spacing:.14em;opacity:.9}\n.vp-alert .vp-at{font-size:30px;line-height:1.1;font-weight:800;margin:8px 0 8px;letter-spacing:-.01em}\n.vp-alert .vp-ab{font-size:14.5px;line-height:1.45}\n.vp-alert .vp-an{font-size:12px;opacity:.85;margin-top:8px}\n.vp-alert ul{margin:8px 0 0;padding-left:20px;font-size:14px}\ntable.vp-mat td .vp-wc{display:block;padding:7px 2px;border-radius:6px;font:700 11.5px/1 ui-monospace,Menlo,monospace;color:#fff}\n@media (max-width:560px){.vp-alert .vp-at{font-size:23px}}\n</style>\n\n<div class=\"wrap\" id=\"app\">\n  <div class=\"top\">\n    <div class=\"brand\">\n      <img class=\"dmlogo\" src=\"data:image/png;base64,\" alt=\"DAIMAY\">\n      <div style=\"min-width:0\">\n        <div class=\"eyebrow\" id=\"eyebrow\"><b>DAIMAY · PARRAS</b></div>\n        <h1 id=\"h1\">VSM · Estado actual</h1>\n      </div>\n    </div>\n    <div class=\"controls\">\n      <span class=\"pill\" style=\"color:var(--fg)\">Autor: Genet Campos · Mejora Continua</span>\n      <span class=\"pill\" id=\"liveP\"><i></i>Conectando…</span>\n      <button class=\"btn\" id=\"bTheme\" aria-pressed=\"false\" title=\"Cambiar el fondo del VSM\"></button>\n      <button class=\"btn\" id=\"bPlay\" aria-pressed=\"true\">❚❚ Pausar</button>\n    </div>\n  </div>\n\n  <div class=\"nav\">\n    <div class=\"vs\" role=\"group\" aria-label=\"Value stream\">\n      <button data-vs=\"parras\" aria-pressed=\"true\" style=\"--c:var(--mat)\">Todas <span>resalta todo</span></button>\n      <button data-vs=\"gm\" aria-pressed=\"false\" style=\"--c:#2dd4bf\">GM T1XX <span>resalta L1–L4 · L10</span></button>\n      <button data-vs=\"rivian\" aria-pressed=\"false\" style=\"--c:#60a5fa\">Rivian <span>resalta L9</span></button>\n      <button data-vs=\"u725\" aria-pressed=\"false\" style=\"--c:#c084fc\">U725 <span>resalta L8</span></button>\n      <button data-vs=\"d2ux\" aria-pressed=\"false\" style=\"--c:#fb923c\">D2UX · 31XX · C1YX <span>resalta L5–L8</span></button>\n    </div>\n    <div class=\"tabs\" role=\"tablist\" aria-label=\"Secciones\">\n      <button role=\"tab\" data-tab=\"mapa\" aria-selected=\"true\">Mapa</button>\n      <button role=\"tab\" data-tab=\"vp1\" aria-selected=\"false\">Resumen</button>\n      <button role=\"tab\" data-tab=\"vp2\" aria-selected=\"false\">Cumplimiento</button>\n      <button role=\"tab\" data-tab=\"vp3\" aria-selected=\"false\">Embarques y plan</button>\n      <button role=\"tab\" data-tab=\"notas\" aria-selected=\"false\">Notas de gemba<span class=\"ct\" id=\"nCount\"></span></button>\n      <button role=\"tab\" data-tab=\"tab\" aria-selected=\"false\">Tableros<span class=\"ct\" id=\"tCount\"></span></button>\n      <button role=\"tab\" data-tab=\"ct\" aria-selected=\"false\">Tiempos</button>\n      <button role=\"tab\" data-tab=\"fotos\" aria-selected=\"false\">Fotos<span class=\"ct\" id=\"fCount\"></span></button>\n      <button role=\"tab\" data-tab=\"rev\" aria-selected=\"false\">Hallazgos</button>\n      <button role=\"tab\" data-tab=\"guia\" aria-selected=\"false\">Guía</button>\n    </div>\n  </div>\n\n  <div data-panel=\"mapa\" style=\"display:flex;flex-direction:column;gap:14px\">\n  <section class=\"kpis\" aria-label=\"Indicadores\">\n    <div class=\"kpi\"><div class=\"l\">Avance · vista general</div><div class=\"v\"><span id=\"kAv\">0</span><small>%</small></div><div class=\"meter\"><span id=\"kAvM\" style=\"width:0\"></span></div><div class=\"d\" id=\"dAv\"></div></div>\n    <div class=\"kpi\"><div class=\"l\">Demanda</div><div class=\"v\" id=\"kDem\">—</div><div class=\"d\" id=\"dDem\"></div></div>\n    <div class=\"kpi\"><div class=\"l\">Takt</div><div class=\"v\" id=\"kTakt\">—</div><div class=\"d\" id=\"dTakt\"></div></div>\n    <div class=\"kpi\"><div class=\"l\">Lead time · ruta</div><div class=\"v\" id=\"kLT\">—</div><div class=\"d\" id=\"dLT\"></div></div>\n    <div class=\"kpi\"><div class=\"l\">C/T acumulado · ruta</div><div class=\"v\" id=\"kVA\">—</div><div class=\"d\" id=\"dVA\"></div></div>\n    <div class=\"kpi alert\" id=\"kpiDQ\"><div class=\"l\">Defecto inspección final</div><div class=\"v\" id=\"kDQ\">—</div><div class=\"d\" id=\"dDQ\"></div></div>\n    <div class=\"kpi\"><div class=\"l\">Estructura validada</div><div class=\"v\" id=\"kVal\">—</div><div class=\"d\" id=\"dVal\"></div></div>\n  </section>\n\n  <section class=\"mapshell\">\n    <style>\n#lyBar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;padding:8px 14px;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--inv) 9%,var(--panel2))}\n#lyBar[hidden]{display:none!important}\n#lyBar .lab{font-family:var(--mono);font-size:10.5px;color:var(--muted);letter-spacing:.08em;text-transform:uppercase;margin-right:2px}\n#lyBar button,#lyBar select{font-family:var(--mono);font-size:11px;padding:6px 10px;border:1px solid var(--line2);border-radius:7px;background:var(--panel2);color:var(--fg);cursor:pointer;min-height:30px}\n#lyBar button[aria-pressed=\"true\"]{background:var(--inv);border-color:var(--inv);color:#1a1200;font-weight:600}\n#lyBar button:focus-visible,#lyBar select:focus-visible,#bLay:focus-visible{outline:2px solid var(--mat);outline-offset:2px}\n#lyBar .hint{font-family:var(--mono);font-size:10.5px;color:var(--muted);margin-left:auto}\n.lay-on #map .proc{cursor:grab}.lay-on #map .proc:active{cursor:grabbing}.lay-on #map{cursor:crosshair}\n.lay-on #map [data-e]{cursor:pointer;pointer-events:stroke}\n.lay-pick #map .proc .frame{stroke:var(--inv)!important;stroke-dasharray:6 4}\n</style>\n<div class=\"maptools\">\n      <div class=\"grp\" role=\"group\" aria-label=\"Ruta resaltada\"><span class=\"lab\">Ruta</span><div class=\"seg\" id=\"routeSeg\"></div></div>\n      <div class=\"grp\" role=\"group\" aria-label=\"Capas\">\n        <label class=\"tg\" style=\"--c:var(--info)\"><input type=\"checkbox\" id=\"lyInfo\" checked>Información</label>\n        <label class=\"tg\" style=\"--c:var(--mat)\"><input type=\"checkbox\" id=\"lyMov\" checked>Traslado</label>\n        <label class=\"tg\" style=\"--c:#5aa0ff\"><input type=\"checkbox\" id=\"lyKb\" checked>Kanban</label>\n        <label class=\"tg\" style=\"--c:var(--crit)\"><input type=\"checkbox\" id=\"lyQ\" checked>Calidad</label>\n        <label class=\"tg\" style=\"--c:var(--inv)\"><input type=\"checkbox\" id=\"lyT\" checked>Línea de tiempo</label>\n        <label class=\"tg\" style=\"--c:var(--ok)\" title=\"Pinta cada caja con el OEE del Centro OEE\"><input type=\"checkbox\" id=\"lyOEE\">OEE</label>\n        <div class=\"zoom\" role=\"group\" aria-label=\"Zonas\"><button id=\"zAllOpen\">Abrir todo</button><button id=\"zAllClose\">Cerrar todo</button></div>\n        <div class=\"zoom\" role=\"group\" aria-label=\"Zoom\"><button id=\"zOut\" aria-label=\"Alejar\">−</button><button id=\"zFit\">Ajustar</button><button id=\"zIn\" aria-label=\"Acercar\">+</button></div><div class=\"zoom\" role=\"group\" aria-label=\"Edición\"><button id=\"bLay\" aria-pressed=\"false\" title=\"Mover, agregar y borrar cajas y flechas del mapa\">✎ Editar mapa</button></div>\n      </div>\n    </div>\n    <div id=\"lyBar\" hidden role=\"toolbar\" aria-label=\"Edición del mapa\">\n      <span class=\"lab\">Editar mapa</span>\n      <button data-lt=\"move\" aria-pressed=\"true\" title=\"Arrastra una caja para moverla\">Mover</button>\n      <button data-lt=\"mat\" aria-pressed=\"false\" title=\"Clic en la caja de origen y luego en la de destino\">Flecha de material</button>\n      <button data-lt=\"under\" aria-pressed=\"false\" title=\"Flecha de retrabajo o reversa por abajo del mapa\">Flecha de retrabajo</button>\n      <button data-lt=\"del\" aria-pressed=\"false\" title=\"Clic en una caja o en una flecha para quitarla\">Borrar</button>\n      <select id=\"lyKind\" aria-label=\"Tipo de caja nueva\"></select><button data-lt=\"add\" aria-pressed=\"false\" title=\"Elige el tipo y haz clic en el mapa donde va la caja\">Agregar caja</button>\n      <button data-la=\"undo\" title=\"Deshacer el último cambio\">Deshacer</button><button data-la=\"reset\" title=\"Regresar este flujo a su mapa original\">Restaurar mapa</button><button data-la=\"done\">Terminar</button>\n      <span class=\"hint\" id=\"lyHint\"></span>\n    </div>\n    <div class=\"mapscroll\"><svg id=\"map\" viewBox=\"0 0 2240 1250\" role=\"img\" aria-label=\"Mapa de flujo de valor\"></svg></div>\n    <div class=\"legend\">\n      <span><i style=\"background:repeating-linear-gradient(115deg,#48c2ff 0 4px,transparent 4px 8px)\"></i>Material · línea gruesa = ruta seleccionada</span>\n      <span><svg width=\"22\" height=\"12\" viewBox=\"0 0 26 16\" style=\"vertical-align:middle;margin-right:6px\"><path d=\"M2 2 L6 11 H22\" fill=\"none\" stroke=\"#48c2ff\" stroke-width=\"1.6\"/><rect x=\"8\" y=\"5\" width=\"13\" height=\"5\" rx=\"1\" fill=\"#48c2ff\"/><circle cx=\"8\" cy=\"13\" r=\"2\" fill=\"#48c2ff\"/><circle cx=\"20\" cy=\"13\" r=\"2\" fill=\"#48c2ff\"/></svg>Traslado · patín, carro, montacargas…</span>\n      <span><i style=\"background:repeating-linear-gradient(90deg,#a48bff 0 6px,transparent 6px 12px)\"></i>Información</span>\n      <span><i style=\"background:#ffb321;width:10px;height:10px;clip-path:polygon(50% 0,100% 100%,0 100%)\"></i>Inventario</span>\n      <span><i style=\"background:#ff5a76;height:3px\"></i>Retrabajo / reversa</span><span><i style=\"background:#2dd4bf;height:3px\"></i>Planta 1 → P4</span><span><i style=\"background:#fb923c;height:3px\"></i>Loop P7 · foam armrest</span><span style=\"color:#e6eef5\">Blanco = gemba</span><span style=\"color:#d9b26a\">Dorado = draft</span><span>— = falta</span>\n      <span>✓ ≠ ? = estructura confirmada, diferente o pendiente</span><span>! = supuesto por confirmar</span>\n    </div>\n  </section>\n\n  <section class=\"grid2\">\n    <div class=\"card\" id=\"capCard\">\n      <h2>Captura en gemba</h2>\n      <p class=\"kick\">La lista va en orden de recorrido: de embarque hacia atrás. Lo que guardes aparece en el mapa para todo el equipo.</p>\n      <select id=\"procSel\" aria-label=\"Proceso a capturar\"></select>\n      <div id=\"procFlag\"></div>\n      <div class=\"form\">\n        <label for=\"f-val\">¿Existe así en piso?<select id=\"f-val\"><option value=\"\">Pendiente</option><option>Confirmado</option><option>Diferente</option></select></label>\n        <label for=\"f-ct\">C/T s<input id=\"f-ct\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"any\"></label>\n        <label for=\"f-src\">Fuente del C/T<select id=\"f-src\"><option value=\"\">—</option><option>Estándar</option><option>Cronometrado</option><option>Estimado</option></select></label>\n        <label for=\"f-ops\">Operadores<input id=\"f-ops\" type=\"number\" inputmode=\"numeric\" min=\"0\" step=\"1\"></label>\n        <label for=\"f-wip\">WIP después · pz<input id=\"f-wip\" type=\"number\" inputmode=\"numeric\" min=\"0\" step=\"1\"></label>\n        <label for=\"f-mov\">Traslado al siguiente<select id=\"f-mov\"><option value=\"\">—</option><option>Manual</option><option>Patín</option><option>Carro</option><option>Rack</option><option>Montacargas</option><option>Tugger</option><option>Banda</option></select></label>\n      </div>\n      <details class=\"more\"><summary>Datos adicionales (opcional en vista general)</summary>\n      <div class=\"form\">\n        <label for=\"f-freq\">Embarques o viajes/día<input id=\"f-freq\" type=\"text\" placeholder=\"ej. 12–16\"></label>\n        <label for=\"f-lote\">Lote · pz por viaje<input id=\"f-lote\" type=\"text\" placeholder=\"ej. 260–280\"></label>\n        <label for=\"f-co\">C/O min<input id=\"f-co\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"any\"></label>\n        <label for=\"f-up\">Uptime %<input id=\"f-up\" type=\"number\" inputmode=\"decimal\" min=\"0\" max=\"100\" step=\"any\"></label>\n        <label for=\"f-def\">Defecto %<input id=\"f-def\" type=\"number\" inputmode=\"decimal\" min=\"0\" max=\"100\" step=\"any\"></label>\n        <label for=\"f-kb\">¿Kanban/FIFO opera?<select id=\"f-kb\"><option value=\"\">—</option><option>Sí</option><option>Parcial</option><option>No</option><option>No aplica</option></select></label>\n      </div></details>\n      <div class=\"row\"><button class=\"btn primary\" id=\"bSave\">Guardar proceso</button><span class=\"note\" id=\"capMeta\"></span></div>\n    </div>\n    <div class=\"card\">\n      <h2>Qué medir aquí</h2>\n      <p class=\"kick\" id=\"chkKick\"></p>\n      <ul class=\"check\" id=\"checkList\"></ul>\n      <h3>Parámetros del flujo · <span id=\"parName\"></span></h3>\n      <div class=\"form\">\n        <label for=\"p-dem\">Piezas/día<input id=\"p-dem\" type=\"number\" inputmode=\"numeric\" min=\"0\" step=\"1\"></label>\n        <label for=\"p-tur\">Turnos<input id=\"p-tur\" type=\"number\" inputmode=\"numeric\" min=\"0\" step=\"1\"></label>\n        <label for=\"p-hrs\">Horas netas/turno<input id=\"p-hrs\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"any\"></label>\n        <label for=\"p-mp\">MP en días<input id=\"p-mp\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"any\"></label>\n      </div>\n      <div class=\"row\"><button class=\"btn\" id=\"bSaveP\">Guardar parámetros</button><span class=\"note\">El takt y los días de inventario salen de aquí.</span></div>\n    </div>\n  </section>\n  </div>\n\n  <div data-panel=\"vp1\" hidden style=\"display:flex;flex-direction:column;gap:14px\">\n    <div class=\"vp-alert\" id=\"vp-alert\"></div>\n    <div class=\"card\"><h2>Takt vs ciclo · estudios de tiempos del 21‑oct</h2><p class=\"kick\">Ciclo = tiempo promedio de 10 lecturas ÷ operadores de la operación. Cuello = la operación más lenta. Takt con la demanda actual de cada hoja (38,700 s netos por día).</p><div class=\"vp-ms\"><table class=\"vp-mat\" id=\"vp-tkt\"></table></div><p class=\"vp-note\" id=\"vp-tktn\"></p></div>\n    <div class=\"card\"><h2>Qué falta para llenar el VSM</h2><p class=\"kick\" id=\"vp-faltak\"></p><div class=\"vp-ms\"><table class=\"vp-mat\" id=\"vp-falta\"></table></div></div>\n    <div class=\"card\"><h2>Resumen · Parras</h2><p class=\"kick\">Producción 31‑ago → 20‑oct (25 días) · plan semana 43 · embarques WK25–WK42</p><div class=\"vp-kpis\" id=\"vp-kpis\"></div></div>\n    <div class=\"card\"><h2>Problemas del flujo</h2><p class=\"kick\">Lo que se ve en el mapa, con los datos que lo respaldan</p><div class=\"vp-pl\" id=\"vp-plist\"></div></div>\n    <div class=\"card\"><h2>Lo que el promedio no deja ver</h2><div id=\"vp-ins\"></div><p class=\"vp-note\" id=\"vp-notes\"></p></div>\n  </div>\n  <div data-panel=\"vp2\" hidden style=\"display:flex;flex-direction:column;gap:14px\">\n    <div class=\"card\"><h2>Cumplimiento por semana</h2><p class=\"kick\">Real / proyección por equipo, semana que inicia en la fecha indicada. El archivo de comentarios empieza el 31‑ago, no hay semanas anteriores.</p><div class=\"vp-ms\"><table class=\"vp-mat\" id=\"vp-wkc\"></table></div></div>\n    <div class=\"card\"><h2>Cumplimiento por línea y día</h2><p class=\"kick\">Cada cuadro es un día. Toca uno para ver plan, real, causa reportada y acción.</p>\n      <div class=\"vp-hmscroll\"><div class=\"vp-hm\" id=\"vp-hm\"></div></div><div class=\"vp-leg\" id=\"vp-hmleg\"></div>\n      <div class=\"vp-det\" id=\"vp-detail\">Toca un cuadro del mapa de calor o una celda de la matriz para ver el detalle.</div></div>\n    <div class=\"card\"><h2>Causas × línea</h2><p class=\"kick\">Piezas faltantes contra proyección, sumadas solo en los días con déficit. Toca una celda para leer los comentarios.</p>\n      <div class=\"vp-ms\"><table class=\"vp-mat\" id=\"vp-mat\"></table></div></div>\n  </div>\n  <div data-panel=\"vp3\" hidden style=\"display:flex;flex-direction:column;gap:14px\">\n    <div class=\"card\"><h2>Qué cambió con el requerimiento actualizado</h2><p class=\"kick\">Comparado con la versión anterior del archivo. Las semanas WK25–WK38 no cambiaron.</p><div class=\"vp-ms\"><table class=\"vp-mat\" id=\"vp-chg\"></table></div></div>\n    <div class=\"card\"><h2>Embarques contra meta semanal</h2><p class=\"kick\">Barra clara = meta del programa semanal · barra de color = embarcado</p><div class=\"vp-sv\" id=\"vp-emb\"></div></div>\n    <div class=\"card\"><h2>Embarques día por día, por semana</h2><p class=\"kick\">Embarcado y % contra la meta de cada día. El viernes no trae meta en el archivo, solo lo embarcado.</p><div class=\"vp-ms\"><table class=\"vp-mat\" id=\"vp-embd\"></table></div></div>\n    <div class=\"card\"><h2>¿Qué familia corre cada línea?</h2><p class=\"kick\">Plan de la semana 43 (piezas). Líneas con 3 o 4 familias son las que cambian de material más seguido.</p><div class=\"vp-ms\"><table class=\"vp-mat\" id=\"vp-famx\"></table></div></div>\n    <div class=\"vp-two\">\n      <div class=\"card\"><h2>Ruteo y carga</h2><p class=\"kick\">NP → línea y plan vs capacidad (5 días)</p><table class=\"vp-rt\" id=\"vp-rt\"></table></div>\n      <div class=\"card\"><h2>Producto terminado</h2><p class=\"kick\">INV FG del plan</p><div id=\"vp-fg\"></div></div>\n    </div>\n  </div>\n  <div data-panel=\"notas\" hidden>\n    <div class=\"card\">\n      <h2>Notas de gemba · <span id=\"notesVs\"></span></h2>\n      <p class=\"kick\">Hallazgos, fotos pendientes, dudas. Se ligan al proceso elegido en la captura.</p>\n      <textarea id=\"noteTxt\" rows=\"3\" placeholder=\"Ej. 3 racks esperando spray desde el viernes\" aria-label=\"Nueva nota\"></textarea>\n      <div class=\"row\"><button class=\"btn\" id=\"bNote\">Agregar nota a <span id=\"noteP\"></span></button></div>\n      <ul class=\"notes\" id=\"notes\"></ul>\n    </div>\n  </div>\n\n  <div data-panel=\"tab\" hidden>\n    <div class=\"card\">\n      <h2>Tableros hora por hora · <span id=\"tabVs\"></span></h2>\n      <p class=\"kick\">Meta acumulada vs real al corte de cada tablero, tomado de fotos de piso. Ordenado de peor a mejor cumplimiento.</p>\n      <div class=\"kpis\" id=\"tabSum\" style=\"margin-bottom:14px\"></div>\n      <div style=\"overflow-x:auto\"><table class=\"gl\" id=\"tabTbl\"></table></div>\n    </div>\n  </div>\n\n  <div data-panel=\"fotos\" hidden>\n    <div class=\"card\">\n      <h2>Evidencia fotográfica · <span id=\"fotosVs\"></span></h2>\n      <p class=\"kick\">Desorden, mezcla de material, WIP, falta de estandarización y tableros, tal como se vieron en piso. Cada foto puede ligarse a una caja del mapa.</p>\n      <div id=\"fotoUp\" hidden>\n        <div class=\"form\">\n          <label for=\"fFile\">Foto(s)<input id=\"fFile\" type=\"file\" accept=\"image/*\" multiple></label>\n          <label for=\"fCat\">Categoría<select id=\"fCat\"><option>Desorden / 5S</option><option>Mezcla de material</option><option>WIP / inventario</option><option>Falta de estandarización</option><option>Calidad / retrabajo</option><option>Tablero</option><option>Equipo</option><option>Otro</option></select></label>\n          <label for=\"fProc\">Caja del mapa<select id=\"fProc\"></select></label>\n          <label for=\"fCap\">Qué se ve<input id=\"fCap\" type=\"text\" maxlength=\"400\" placeholder=\"Ej. spacer spreado amontonado antes de upper, 11:30\"></label>\n        </div>\n        <div class=\"row\"><button class=\"btn primary\" id=\"bFoto\">Subir foto</button><span class=\"note\" id=\"fNote\"></span></div>\n      </div>\n      <p class=\"note\" id=\"fNoUp\" hidden>Solo quien puede editar la página sube fotos. Aquí se ven todas.</p>\n      <div class=\"chips\" id=\"fChips\" style=\"margin-top:16px\"></div>\n      <div class=\"gal\" id=\"gal\"></div>\n    </div>\n  </div>\n\n  <div data-panel=\"ct\" hidden style=\"display:flex;flex-direction:column;gap:14px\">\n    <div class=\"card\">\n      <h2>Estudio de tiempos · <span id=\"ctVs\"></span></h2>\n      <p class=\"kick\" id=\"ctKick\"></p>\n      <div id=\"ctWarn\"></div>\n      <h3>Cajas del VSM: C/T en el mapa vs estudio</h3><p class=\"kick\">Las cajas que no tenían C/T ya tomaron el valor del estudio. Donde había estándar se dejó y se marca ≠ si difiere más de 15%.</p>\n      <div style=\"overflow-x:auto\"><table class=\"gl\" id=\"ctTbl\"></table></div>\n    </div>\n    <div id=\"ctCharts\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,560px),1fr));gap:14px\"></div>\n  </div>\n  <div data-panel=\"rev\" hidden style=\"display:flex;flex-direction:column;gap:14px\">\n    <div class=\"card\" id=\"xCard\">\n      <h2>Conexiones entre plantas · <span id=\"xVs\"></span></h2>\n      <p class=\"kick\">Qué entra y sale de P4 hacia P1 y P7. En el mapa: línea turquesa = Planta 1, línea naranja = loop de foam en Planta 7.</p>\n      <div style=\"overflow-x:auto\"><table class=\"gl\" id=\"xTbl\"></table></div>\n    </div>\n    <div class=\"card\" id=\"rwCard\">\n      <h2>Zonas de retrabajo · <span id=\"rwVs\"></span></h2>\n      <p class=\"kick\">Dónde regresa el material y cuánto, según el recorrido. En el mapa: recuadros rojos ↺ debajo de cada caja (capa Calidad).</p>\n      <div style=\"overflow-x:auto\"><table class=\"gl\" id=\"rwTbl\"></table></div>\n    </div>\n    <div class=\"card\">\n      <h2>Hallazgos e hipótesis · <span id=\"revVs\"></span></h2>\n      <p class=\"kick\" id=\"revKick\"></p>\n      <ul class=\"ins\" id=\"review\"></ul>\n    </div>\n  </div>\n\n  <div data-panel=\"guia\" hidden style=\"display:flex;flex-direction:column;gap:14px\">\n  <section class=\"grid2\">\n    <div class=\"card\">\n      <h2>Qué significa cada dato</h2>\n      <p class=\"kick\">Para una vista general basta con lo marcado como necesario</p>\n      <div style=\"overflow-x:auto\"><table class=\"gl\"><thead><tr><th>Dato</th><th>Qué es</th><th>¿Se necesita?</th></tr></thead><tbody>\n      <tr><td>Takt</td><td>Cada cuántos segundos pide el cliente una pieza. Sale de demanda y horas, no se mide.</td><td><span class=\"need y\">Sí</span></td></tr>\n      <tr><td>C/T</td><td>Segundos entre una pieza y la siguiente al salir del proceso. Para la vista general sirve el estándar de ingeniería.</td><td><span class=\"need y\">Sí</span></td></tr>\n      <tr><td>Ops</td><td>Personas trabajando en ese proceso.</td><td><span class=\"need y\">Sí</span></td></tr>\n      <tr><td>WIP</td><td>Piezas esperando después del proceso, contadas una vez. Con esto sale el lead time.</td><td><span class=\"need y\">Sí</span></td></tr>\n      <tr><td>Defecto</td><td>% de piezas que no salen bien a la primera.</td><td><span class=\"need m\">Solo donde es grande</span></td></tr>\n      <tr><td>C/O</td><td>Minutos parados al cambiar de número de parte: de la última pieza buena a la primera buena.</td><td><span class=\"need m\">Solo en lotes</span></td></tr>\n      <tr><td>Uptime</td><td>% del tiempo que el equipo está disponible para producir.</td><td><span class=\"need n\">No por ahora</span></td></tr>\n      </tbody></table></div>\n    </div>\n    <div class=\"card\">\n      <h2>Plan para cerrarlo en una semana</h2>\n      <p class=\"kick\">Vista general: otras plantas como cajas negras, detalle solo en P4</p>\n      <ul class=\"plan\">\n        <li><b>Día 1</b><span>Recorrido en Parras de embarque hacia atrás, línea por línea (L1–L10). Marca cada caja como Confirmado o Diferente.</span></li>\n        <li><b>Día 2</b><span>Conteo de WIP en todos los triángulos en una sola vuelta, con hora. C/T y operadores de las hojas de balanceo.</span></li>\n        <li><b>Día 3</b><span>P1 y P7 por llamada o visita corta: inventario de piezas del cliente, frecuencia del shuttle y tránsito.</span></li>\n        <li><b>Día 4</b><span>Planeación: demanda diaria por cliente y días de MP. Calidad: defecto de inspección final.</span></li>\n        <li><b>Día 5</b><span>Revisión con el equipo. Marcar los 3–5 kaizen del estado futuro de cada cliente.</span></li>\n      </ul>\n    </div>\n  </section>\n  <div class=\"card\">\n    <h2>Exportar</h2>\n    <p class=\"kick\">Todo lo capturado de Parras (procesos, parámetros y notas) en JSON</p>\n    <div class=\"row\" style=\"margin-top:0\"><button class=\"btn\" id=\"bCopy\">Copiar JSON</button><span class=\"note\" id=\"cpNote\"></span></div>\n    <textarea id=\"jsonOut\" hidden readonly aria-label=\"JSON exportado\"></textarea>\n  </div>\n  </div>\n\n  <footer>\n    <span style=\"color:var(--muted)\">Autor: Genet Campos · Mejora Continua DAIMAY</span>\n    <span>Takt = turnos × horas netas × 3600 ÷ piezas/día</span>\n    <span>En procesos con varias líneas, cada línea se compara contra takt × líneas</span>\n    <span>Lead time de ruta = MP + Σ días de inventario</span>\n  </footer>\n</div>\n<div class=\"tip\" id=\"tip\" hidden></div>\n<div class=\"scrim\" id=\"scrim\" hidden></div>\n<style>\n.edbox{border:1px solid var(--line2);border-radius:10px;padding:0 12px;margin-top:4px;background:var(--panel2)}\n.edbox summary{cursor:pointer;padding:10px 0;font-weight:600;color:var(--fg)}\n.edbox[open]{padding-bottom:12px}\n.edbox label{display:block;font-size:11.5px;color:var(--muted);margin:8px 0 3px}\n.edbox input,.edbox select,.edbox textarea,.edrow textarea,.edrow select,.edrow input{width:100%;box-sizing:border-box;background:var(--bg);color:var(--fg);border:1px solid var(--line2);border-radius:7px;padding:7px 8px;font:inherit;font-size:13px}\n.edbox textarea,.edrow textarea{resize:vertical}\n.edbox .row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}\n.edbox .hint{font-size:11.5px;color:var(--dim);margin:8px 0 0}\n.edtag{display:inline-block;font-size:10px;font-weight:700;letter-spacing:.04em;color:var(--inv);border:1px solid var(--inv);border-radius:99px;padding:0 6px;margin-left:6px;vertical-align:2px}\n.edrow{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}\n.edrow button{all:unset;cursor:pointer;font-family:var(--mono);font-size:10.5px;padding:4px 9px;border:1px solid var(--line2);border-radius:6px;color:var(--muted);min-height:20px}\n.edrow button:hover{color:var(--fg);border-color:var(--mat)} .edrow button.del:hover{border-color:var(--crit);color:var(--crit)}\n.edrow button:focus-visible{outline:2px solid var(--mat);outline-offset:2px}\n.edform{display:grid;gap:6px;margin-top:6px}\n</style>\n<aside class=\"drawer\" id=\"drawer\" aria-hidden=\"true\" aria-labelledby=\"drT\" role=\"dialog\">\n  <div class=\"dh\"><div class=\"t\"><div class=\"k\" id=\"drK\"></div><h3 id=\"drT\"></h3></div><button class=\"x\" id=\"drX\" aria-label=\"Cerrar\">×</button></div>\n  <div class=\"db\">\n    <div class=\"res\" id=\"drRes\"></div>\n    <div class=\"flg\" id=\"drFlag\" hidden></div>\n    <div class=\"sec\"><span id=\"drNC\">Notas de gemba</span><button id=\"drFotos\" hidden></button></div>\n    <ul class=\"notes\" id=\"drNotes\" style=\"margin:0\"></ul>\n    <div class=\"sec\"><span>Agregar nota a esta caja</span></div>\n    <textarea id=\"drTxt\" rows=\"3\" placeholder=\"Qué viste, cuándo, cuánto\" aria-label=\"Nueva nota para esta caja\"></textarea>\n    <div class=\"row\"><button class=\"btn primary\" id=\"drAdd\">Guardar nota</button></div>\n    <details class=\"edbox\" id=\"drEdP\"><summary>Editar esta caja <span class=\"edtag\" id=\"epTag\" hidden>EDITADA</span></summary>\n      <label for=\"epN1\">Nombre</label><input id=\"epN1\" maxlength=\"40\">\n      <label for=\"epN2\">Detalle (segunda línea)</label><input id=\"epN2\" maxlength=\"40\">\n      <label for=\"epPl\">Planta</label><input id=\"epPl\" maxlength=\"30\">\n      <label for=\"epRes\">Descripción</label><textarea id=\"epRes\" rows=\"7\"></textarea>\n      <label for=\"epFlag\">Foco rojo / alerta (deja vacío para quitarlo)</label><textarea id=\"epFlag\" rows=\"2\" maxlength=\"300\"></textarea>\n      <div class=\"row\"><button class=\"btn primary\" id=\"epSave\">Guardar cambios</button><button class=\"btn\" id=\"epReset\">Restaurar original</button></div>\n      <p class=\"hint\">C/T, operadores, WIP y traslado se capturan en «Captura en gemba», abajo del mapa.</p>\n    </details>\n  </div>\n</aside>\n<style>\nhtml[data-theme=\"light\"] body{background:var(--bg)}\nhtml[data-theme=\"light\"] .drawer,html[data-theme=\"light\"] .lb{box-shadow:0 20px 60px rgba(15,23,42,.18)}\nhtml[data-theme=\"light\"] .btn.primary,html[data-theme=\"light\"] .chips button[aria-pressed=\"true\"]{color:#fff}\nhtml[data-theme=\"light\"] .mapshell{background:radial-gradient(1400px 500px at 50% -10%,#ffffff 0%,var(--bg2) 62%)}\nhtml[data-theme=\"light\"] .mark{background:linear-gradient(160deg,#ffffff,#e8eef5)}\nhtml[data-theme=\"light\"] .tip{background:#fffffff2}\nhtml[data-theme=\"light\"] .dmlogo{background:#16202c;border-radius:8px;padding:6px 10px}\nhtml[data-theme=\"light\"] [data-panel^=\"vp\"]{--nodata:#c9d3de;--ok2:#7fc7a8}\n</style>\n<div class=\"lb\" id=\"lb\" hidden role=\"dialog\" aria-label=\"Foto\"><img id=\"lbImg\" alt=\"\"><p id=\"lbCap\"></p><button class=\"btn\" id=\"lbX\">Cerrar</button></div>\n<div class=\"toast\" id=\"toast\" hidden role=\"status\"></div>\n\n<script>\n(function(){\nconst C={bg:'#070b10',panel:'#0e161f',panel2:'#0b121a',raise:'#132030',line:'#1c2a38',line2:'#2a3d50',fg:'#e6eef5',muted:'#8a9cae',dim:'#5a6d80',mat:'#48c2ff',info:'#a48bff',inv:'#ffb321',crit:'#ff5a76',ok:'#3ddc97',draft:'#d9b26a',kb:'#5aa0ff',tesla:'#ff6b5a'};\nconst NS='http://www.w3.org/2000/svg';\nconst COLX_T=[20,200,430,660,930,1170,1400,1630,1860],COLX_R=[20,200,430,660,930,1170,1400,1630,1860,2090,2320],BW=160,BH=150;let ROWY=[330,520,710,900],COLX=COLX_T,W=2240,DX=0,YU=1150,YD=1196,H=1250;\nconst reduce=!!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches);\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst fmt=(n,d=0)=>N