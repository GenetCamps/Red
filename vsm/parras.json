orm();if(fromMap&&innerWidth<980)$('capCard').scrollIntoView({behavior:reduce?'auto':'smooth',block:'start'});}\n$('procSel').addEventListener('change',e=>select(e.target.value,false));\nfunction fillForm(){const p=BY[sel],c=CAP[sel]||{};\n FIELDS.forEach(f=>{const el=$('f-'+f);el.value=c[f]??'';if(el.tagName==='INPUT'&&NUMF[f]){const d=p.d[f]!==undefined?p.d[f]:(f==='def'&&p.d.defLo!==undefined?p.d.defLo+'–'+p.d.defHi:null);el.placeholder=d!==null?'draft: '+d:'';}});\n $('procFlag').innerHTML=p.flag&&c.val!=='Confirmado'?`<p class=\"flag\"><b>Confirmar</b>${esc(p.flag)}</p>`:'';\n $('chkKick').textContent=`${WN[sel]} · ${p.n.join(' ')}`;\n $('checkList').innerHTML=(CHECK[p.k]||[]).concat(p.after!=='none'?['WIP después de este proceso, contado con hora']:[]).map(x=>`<li>${esc(x)}</li>`).join('');\n $('noteP').textContent=`${S.name} · ${p.n[0]} ${p.n[1]}`;\n renderMeta();}\nfunction whoLabel(id){if(!id)return 'alguien';if(String(id).startsWith('txt:'))return String(id).slice(4);return names[id]||(id===me?'tú':'Alguien');}\nasync function resolveNames(ids){ids=ids.filter(i=>i&&!String(i).startsWith('txt:')&&!names[i]);if(!ids.length||!user||!user.profiles)return;try{const ps=await user.profiles(ids);ids.forEach(i=>{names[i]=(ps&&ps[i]&&ps[i].name)||'Alguien';});}catch(e){}}\nasync function renderMeta(){const c=CAP[sel];if(!c||!c.at){$('capMeta').textContent='Sin captura todavía';return;}\n await resolveNames([c.by]);$('capMeta').textContent=`Última captura: ${whoLabel(c.by)} · ${new Date(c.at).toLocaleString('es-MX',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'})}`;}\nfunction fillParams(){$('p-dem').value=PAR.dem??'';$('p-tur').value=PAR.tur??'';$('p-hrs').value=PAR.hrs??'';$('p-mp').value=PAR.mp??'';$('parName').textContent=S.name;}\n$('bSave').onclick=async()=>{const body={};FIELDS.forEach(f=>{const v=$('f-'+f).value.trim();if(v!=='')body[f]=NUMF[f]?parseFloat(v):v;});\n if(body.def!==undefined&&(body.def<0||body.def>100)){toast('El defecto va de 0 a