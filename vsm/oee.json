"<!doctype html><html lang=\"es\"><head><meta charset=\"utf8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Centro OEE · Red DAIMAY</title>\n<style>\n/* Red DAIMAY · Centro OEE. Se abre dentro del hub (como las consolas VSM) y guarda en su base (prefijo oee/r1/).\n   OEE = Disponibilidad × Rendimiento × Calidad, de la planta a la máquina:\n   - Producción y rechazos: importados del Excel diario de DQMC (hoja «日报表DailyInput»), por línea y fecha de producción.\n   - Scrap en piezas y en pesos: importado de Plex («Concentrado Scrap»), por centro de trabajo, día y razón.\n   - Tiempo planeado, paros, microparos, retrabajo y ciclo ideal: se capturan a mano por día y por nodo.\n   Los nodos (planta → línea → proceso → máquina) se ligan a centros de trabajo de Plex y a líneas de DQMC; los padres suman a sus hijos. */\n:root{color-scheme:dark;--bg:#070b10;--panel:#0e161f;--panel2:#0b121a;--raise:#132030;--line:#1c2a38;--line2:#2a3d50;--fg:#e6eef5;--muted:#8a9cae;--dim:#5a6d80;--mat:#48c2ff;--ok:#3ddc97;--warn:#ffb321;--crit:#ff5a76;--info:#a48bff}\nhtml[data-theme=\"light\"]{color-scheme:light;--bg:#f3f6fa;--panel:#ffffff;--panel2:#f7f9fc;--raise:#e8eef5;--line:#d3dce6;--line2:#aebccb;--fg:#16202c;--muted:#4a5a6b;--dim:#7b8a99;--mat:#0b6fc2;--ok:#0d8a55;--warn:#b06a00;--crit:#d22c4d;--info:#6a4fd6}\n*{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.45 system-ui,-apple-system,\"Segoe UI\",sans-serif}\nbutton,select,input,textarea{font:inherit;color:var(--fg)} [hidden]{display:none!important}\n.wrap{max-width:1500px;margin:0 auto;padding:12px 16px 40px;display:flex;flex-direction:column;gap:12px}\n.top{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center}\n.top h1{font-size:22px;margin:0 8px 0 0;font-weight:700;letter-spacing:.01em}\n.b{background:var(--panel2);border:1px solid var(--line2);border-radius:8px;padding:6px 11px;cursor:pointer;min-height:32px}\n.b:hover{border-color:var(--mat)} .b.on,.b.prim{background:var(--mat);border-color:var(--mat);color:#fff;font-weight:600}\n.b:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--mat);outline-offset:2px}\nselect,input{background:var(--panel2);border:1px solid var(--line2);border-radius:8px;padding:6px 8px;min-width:0}\n.sp{flex:1}.muted{color:var(--muted)}.small{font-size:12px}\n.seg{display:inline-flex;border:1px solid var(--line2);border-radius:9px;padding:2px;background:var(--panel2)}\n.seg button{border:0;background:none;padding:5px 10px;border-radius:7px;cursor:pointer;color:var(--muted)} .seg button.on{background:var(--raise);color:var(--fg);box-shadow:inset 0 0 0 1px var(--mat)}\n.crumbs{display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:13px}\n.crumbs button{background:none;border:0;color:var(--mat);cursor:pointer;padding:2px 0} .crumbs b{font-weight:600}\n.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden}\n.kpi{background:var(--panel);padding:10px 12px;min-width:0}\n.kpi span{display:block;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}\n.kpi b{display:block;font-size:26px;font-weight:700;font-variant-numeric:tabular-nums;margin-top:3px}\n.kpi small{display:block;font-size:11.5px;color:var(--dim);min-height:15px}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px;min-width:0}\n.card h3{margin:0 0 6px;font-size:15px}\n.node{cursor:pointer;text-align:left;width:100%} .node:hover{border-color:var(--mat)}\n.node .o{font-size:28px;font-weight:700;font-variant-numeric:tabular-nums}\n.bar{height:7px;border-radius:4px;background:var(--panel2);overflow:hidden;margin:2px 0 6px} .bar i{display:block;height:100%}\n.row{display:flex;justify-content:space-between;gap:8px;font-size:12.5px}\n.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:12px}\nsvg{display:block;width:100%;height:auto}\ntable{width:100%;border-collapse:collapse;font-size:12.5px;font-variant-numeric:tabular-nums} th,td{padding:5px 6px;border-bottom:1px solid var(--line);text-align:left} th{color:var(--muted);font-weight:600} td.n{text-align:right}\n.pane{background:var(--panel);border:1px solid var(--warn);border-radius:12px;padding:12px 14px}\n.pane h2{font-size:16px;margin:0 0 8px}\n.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px 12px} .form label{display:grid;gap:3px;font-size:12px;color:var(--muted)}\n.tree{display:grid;gap:4px;max-height:60vh;overflow:auto} .tn{display:grid;grid-template-columns:1fr auto;gap:6px;align-items:center;padding:5px 8px;border:1px solid var(--line);border-radius:8px;background:var(--panel2)}\n.tn.on{border-color:var(--mat)} .tag{font-size:10.5px;padding:1px 6px;border-radius:99px;border:1px solid var(--line2);color:var(--muted)}\n.chips{display:flex;flex-wrap:wrap;gap:4px} .chip{font-size:11.5px;padding:2px 8px;border-radius:99px;border:1px solid var(--line2);cursor:pointer;background:var(--panel2)} .chip.on{background:var(--mat);border-color:var(--mat);color:#fff}\n#toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);background:var(--raise);border:1px solid var(--line2);border-radius:10px;padding:9px 14px;font-size:13px;z-index:50;max-width:calc(100vw - 30px)}\n.miss{color:var(--dim)}\n</style></head><body>\n<div class=\"wrap\">\n  <div class=\"top\">\n    <h1>Centro OEE</h1>\n    <select id=\"plant\" aria-label=\"Planta\"></select>\n    <span class=\"muted small\" id=\"srcInfo\"></span>\n    <span class=\"sp\"></span>\n    <button class=\"b\" id=\"bImpD\" title=\"Excel diario de DQMC (hoja 日报表DailyInput): producción y rechazos\">Importar DQMC</button>\n    <button class=\"b\" id=\"bImpS\" title=\"Concentrado de scrap de Plex (xlsx o csv)\">Importar scrap Plex</button>\n    <input type=\"file\" id=\"fImp\" accept=\".xlsx,.csv\" hidden>\n    <button class=\"b\" id=\"bCap\">Captura del día</button>\n    <button class=\"b\" id=\"bTree\">Estructura</button>\n    <button class=\"b\" id=\"bVsm\" title=\"Pinta las cajas ligadas de las consolas VSM con el OEE del periodo\">Mandar al VSM</button>\n    <button class=\"b\" id=\"bTheme\"></button>\n  </div>\n  <div class=\"top\">\n    <span class=\"muted small\">Periodo</span>\n    <div class=\"seg\" id=\"per\"><button data-p=\"d1\">Último día</button><button data-p=\"d7\">7 días</button><button data-p=\"d30\">30 días</button><button data-p=\"m\">Mes</button><button data-p=\"all\">Todo</button></div>\n    <input type=\"date\" id=\"dFrom\" aria-label=\"Desde\"><input type=\"date\" id=\"dTo\" aria-label=\"Hasta\">\n    <span class=\"sp\"></span>\n    <span class=\"muted small\">Ver por nivel</span>\n    <div class=\"seg\" id=\"lvl\"><button data-l=\"planta\">Planta</button><button data-l=\"linea\">Línea</button><button data-l=\"proceso\">Proceso</button><button data-l=\"maquina\">Máquina</button></div>\n  </div>\n  <div class=\"crumbs\" id=\"crumbs\"></div>\n  <section class=\"kpis\" id=\"kpis\" aria-label=\"Indicadores del nodo\"></section>\n  <div id=\"panes\"></div>\n  <section><h3 style=\"margin:4px 0 8px;font-size:14px\" id=\"gridTitle\"></h3><div class=\"grid\" id=\"grid\"></div></section>\n  <section class=\"two\">\n    <div class=\"card\"><h3>Tendencia diaria</h3><div id=\"trend\"></div></div>\n    <div class=\"card\"><h3>Pérdidas del periodo</h3><div id=\"loss\"></div></div>\n  </section>\n  <section class=\"two\">\n    <div class=\"card\"><h3>Scrap Plex por razón · pesos</h3><div id=\"parS\"></div></div>\n    <div class=\"card\"><h3>Defectos DQMC</h3><div id=\"parD\"></div></div>\n  </section>\n</div>\n<div id=\"toast\" hidden role=\"status\"></div>\n<script>\n(async()=>{\nconst $=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst fmt=(n,d=0)=>Number(n).toLocaleString('es-MX',{minimumFractionDigits:d,maximumFractionDigits:d}),pc=v=>v==null||!isFinite(v)?'—':fmt(v*100,1)+'%';\nfunction toast(m,ms){const t=$('toast');t.textContent=m;t.hidden=false;clearTimeout(toast.t);toast.t=setTimeout(()=>t.hidden=true,ms||3500);}\nlet RO=false;try{RO=!!(parent&&parent.RD_RO);}catch(e){}\n/* ---------- base: la del hub (prefijo oee/r1/) o, abierta suelta, este navegador ---------- */\nlet db=null;try{if(window.claude&&window.claude.use)db=await window.claude.use('db');}catch(e){db=null;}\nconst LS='rd_oee_local_v1';let LOC={};try{LOC=JSON.parse(localStorage.getItem(LS)||'{}');}catch(e){}\nasync function dGet(p){if(db){const s=await db.doc(p).get();return s.exists?s.data():null;}return LOC[p]??null;}\nasync function dSet(p,v){if(RO)throw {code:'solo-lectura'};if(db)return db.doc(p).set(v);LOC[p]=v;localStorage.setItem(LS,JSON.stringify(LOC));}\nasync function dList(c){if(db){const q=await db.collection(c).get();return q.docs.map(d=>({id:d.id,...d.data()}));}return Object.keys(LOC).filter(k=>k.startsWith(c+'/')&&!k.slice(c.length+1).includes('/')).map(k=>({id:k.slice(c.length+1),...LOC[k]}));}\n\n/* ---------- lector .xlsx (solo las hojas que se piden) ---------- */\nasync function unzip(buf){const dv=new DataView(buf),u8=new Uint8Array(buf),td=new TextDecoder();let e=buf.byteLength-22;while(e>=0&&dv.getUint32(e,true)!==0x06054b50)e--;if(e<0)throw new Error('El archivo no es un Excel .xlsx');\n const n=dv.getUint16(e+10,true);let p=dv.getUint32(e+16,true);const F={};for(let i=0;i<n;i++){if(dv.getUint32(p,true)!==0x02014b50)break;const m=dv.getUint16(p+10,true),cs=dv.getUint32(p+20,true),nl=dv.getUint16(p+28,true),el=dv.getUint16(p+30,true),cl=dv.getUint16(p+32,true),off=dv.getUint32(p+42,true);\n  const name=td.decode(u8.subarray(p+46,p+46+nl));p+=46+nl+el+cl;const st=off+30+dv.getUint16(off+26,true)+dv.getUint16(off+28,true);F[name]={m,d:u8.subarray(st,st+cs)};}\n return async name=>{const f=F[name]||F[name.replace(/^\\//,'')];if(!f)return null;if(f.m===0)return td.decode(f.d);return await new Response(new Blob([f.d]).stream().pipeThrough(new DecompressionStream('deflate-raw'))).text();};}\nconst X=t=>new DOMParser().parseFromString(t,'application/xml'),T=(n,t)=>[...n.getElementsByTagNameNS('*',t)];\nasync function readSheet(buf,pick){const get=await unzip(buf),wb=X(await get('xl/workbook.xml')),rels=X(await get('xl/_rels/workbook.xml.rels')),tg={};T(rels,'Relationship').forEach(r=>tg[r.getAttribute('Id')]=r.getAttribute('Target'));\n const sheets=T(wb,'sheet').map(s=>({name:s.getAttribute('name'),rid:s.getAttribute('r:id')||s.getAttributeNS('http://schemas.openxmlformats.org/officeDocument/2006/relationships','id')}));\n const sh=sheets.find(s=>pick(s.name))||(pick.fallback?sheets[0]:null);if(!sh)throw new Error('No encontré la hoja esperada. Hojas: '+sheets.map(s=>s.name).join(', '));\n const sst=await get('xl/sharedStrings.xml'),SS=sst?T(X(sst),'si').map(si=>T(si,'t').filter(t=>t.parentNode.localName!=='rPh').map(t=>t.textContent).join('')):[];\n let t=tg[sh.rid]||'';t=t.startsWith('/')?t.slice(1):'xl/'+t;const doc=X(await get(t)),rows=[];\n for(const row of T(doc,'row')){const r=+row.getAttribute('r')-1,a=[];for(const c of T(row,'c')){const ref=c.getAttribute('r')||'',m=ref.match(/^([A-Z]+)/);if(!m)continue;let col=0;for(const ch of m[1])col=col*26+ch.charCodeAt(0)-64;\n   const ty=c.getAttribute('t'),v=T(c,'v')[0]?.textContent;let val=ty==='s'?SS[+v]:ty==='inlineStr'?T(c,'t').map(x=>x.textContent).join(''):ty==='str'||ty==='e'?v:v===undefined?'':+v;if(val!==''&&val!==undefined)a[col-1]=val;}rows[r]=a;}\n return {name:sh.name,rows};}\nconst xd=v=>{if(typeof v==='number'){const d=new Date(Date.UTC(1899,11,30)+Math.round(v*864e5));return d.toISOString().slice(0,10);}const s=String(v||'').trim();let m=s.match(/^(\\d{4})-(\\d{1,2})-(\\d{1,2})/);if(m)return `${m[1]}-${m[2].padStart(2,'0')}-${m[3].padStart(2,'0')}`;m=s.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})/);return m?`${m[3]}-${m[1].padStart(2,'0')}-${m[2].padStart(2,'0')}`:null;};\nconst norm=s=>String(s??'').trim().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'');\n\n/* ---------- importadores ---------- */\nasync function importPlex(file){let rows;if(/\\.csv$/i.test(file.name)){const t=(await file.text()).replace(/^﻿/,''),sep=(t.split(/\\r?\\n/)[0].match(/;/g)||[]).length>(t.split(/\\r?\\n/)[0].match(/,/g)||[]).length?';':',';rows=t.split(/\\r?\\n/).filter(Boolean).map(l=>{const o=[];let c='',q=false;for(let i=0;i<l.length;i++){const ch=l[i];if(q){if(ch==='\"'){if(l[i+1]==='\"'){c+='\"';i++;}else q=false;}else c+=ch;}else if(ch==='\"')q=true;else if(ch===sep){o.push(c);c='';}else c+=ch;}o.push(c);return o;});}\n else rows=(await readSheet(await file.arrayBuffer(),n=>true)).rows;\n const h=rows.findIndex(r=>r&&r.some(c=>norm(c)==='workcenter')&&r.some(c=>norm(c)==='quantity'));if(h<0)throw new Error('No encontré las columnas Workcenter y Quantity de Plex.');\n const H=rows[h].map(norm),ci=n=>H.indexOf(n),cD=ci('report date'),cW=ci('workcenter'),cG=ci('workcenter group'),cQ=ci('quantity'),cR=ci('scrap reason'),cC=ci('extended cost'),cO=ci('operation');\n const M={};let n=0;\n for(let i=h+1;i<rows.length;i++){const r=rows[i];if(!r)continue;const d=xd(r[cD]);if(!d)continue;const w=String(r[cW]||'(sin centro)').trim(),q=+r[cQ]||0,c=+r[cC]||0,op=String(r[cO]||''),mat=/^receive\\s*\\((?!ea)/i.test(op);n++;\n  const mo=d.slice(0,7),dd=d.slice(8);const m=M[mo]||(M[mo]={m:mo,wc:{}});const W=m.wc[w]||(m.wc[w]={g:String(r[cG]||''),q:{},c:{},r:{}});\n  if(!mat)W.q[dd]=+((W.q[dd]||0)+q).toFixed(3);W.c[dd]=+((W.c[dd]||0)+c).toFixed(2);const rs=String(r[cR]||'Sin razón').trim();const R=W.r[rs]||(W.r[rs]=[0,0]);if(!mat)R[0]=+(R[0]+q).toFixed(3);R[1]=+(R[1]+c).toFixed(2);}\n for(const mo in M)await dSet(`oee/r1/imp/scrap-${mo}`,Object.assign(M[mo],{src:file.name,at:Date.now(),plant:PLANT}));\n return `Plex: ${fmt(n)} registros en ${Object.keys(M).length} meses (${Object.keys(M).sort()[0]} a ${Object.keys(M).sort().pop()}).`;}\nasync function importDqmc(file){const {rows,name}=await readSheet(await file.arrayBuffer(),n=>/dailyinput|日报表/i.test(n));\n const h=rows.findIndex(r=>r&&r.some(c=>/total inspected/i.test(String(c))));if(h<0)throw new Error(`La hoja «${name}» no trae la columna Total Inspected.`);\n const H=rows[h].map(c=>String(c??'')),f=re=>H.findIndex(c=>re.test(c)),cI=f(/total inspected/i),cY=f(/fab\\.?\\s*a(ñ|n)o/i),cM=f(/fab\\.?\\s*mes/i),cDd=f(/fab\\.?\\s*d(í|i)a/i),cL=f(/cover type/i),cP=f(/proyecto/i),cC=f(/cliente/i),cNG=H.findIndex(c=>/不良合计/.test(c)),dStart=cDd+1,dEnd=cNG>0?cNG:H.length;\n const M={};let n=0;\n for(let i=h+1;i<rows.length;i++){const r=rows[i];if(!r)continue;const ins=+r[cI]||0;if(!ins)continue;const y=+r[cY],mo=+r[cM],dd=+r[cDd];if(!y||!mo||!dd)continue;n++;\n  const d=`${y}-${String(mo).padStart(2,'0')}-${String(dd).padStart(2,'0')}`,mk=d.slice(0,7),dk=d.slice(8),ln=String(r[cL]||r[cP]||'(sin línea)').trim().replace(/\\s+/g,' ');\n  const m=M[mk]||(M[mk]={m:mk,ln:{}}),L=m.ln[ln]||(m.ln[ln]={proj:String(r[cP]||'').trim(),cli:String(r[cC]||'').trim(),i:{},ng:{},df:{}});\n  let ng=cNG>0?+r[cNG]||0:0,sum=0;for(let c=dStart;c<dEnd;c++){const v=+r[c]||0;if(v>0&&H[c]){sum+=v;const k=H[c].split('/').pop().trim()||H[c];L.df[k]=(L.df[k]||0)+v;}}if(!ng)ng=sum;\n  L.i[dk]=(L.i[dk]||0)+ins;L.ng[dk]=(L.ng[dk]||0)+ng;}\n for(const mk in M)await dSet(`oee/r1/imp/dqmc-${mk}`,Object.assign(M[mk],{src:file.name,at:Date.now(),plant:PLANT}));\n return `DQMC: ${fmt(n)} renglones de inspección, ${Object.values(M).reduce((a,m)=>a+Object.keys(m.ln).length,0)} líneas.`;}\n\n/* ---------- datos en memoria ---------- */\nlet PLANT='p4',TREE=null,SCRAP=[],DQMC=[],CAP={},from=null,to=null,LEVEL='linea',CUR=null;\nasync function load(){const t=await dGet('oee/r1/cfg/tree');TREE=t&&Array.isArray(t.nodes)?t:{nodes:[],qual:'dqmc'};const imp=await dList('oee/r1/imp');SCRAP=imp.filter(x=>x.id.startsWith('scrap-'));DQMC=imp.filter(x=>x.id.startsWith('dqmc-'));\n CAP={};(await dList('oee/r1/cap')).forEach(c=>{CAP[c.id]=c;});}\nconst allWC=()=>{const s={};SCRAP.forEach(m=>Object.entries(m.wc).forEach(([k,v])=>{s[k]=v.g;}));return s;};\nconst allLN=()=>{const s={};DQMC.forEach(m=>Object.entries(m.ln).forEach(([k,v])=>{s[k]=v.proj;}));return s;};\nconst uid=()=>'n'+Date.now().toString(36)+Math.random().toString(36).slice(2,5);\nconst kids=id=>TREE.nodes.filter(n=>n.parent===id),node=id=>TREE.nodes.find(n=>n.id===id),root=()=>TREE.nodes.find(n=>!n.parent);\nconst tok=s=>new Set(norm(s).replace(/\\bfrt\\b/g,'fr').replace(/\\b(dr|assy|line|assembly|r2)\\b/g,' ').split(/[^a-z0-9]+/).filter(x=>x.length>1));\nfunction sim(a,b){const A=tok(a),B=tok(b);if(!A.size||!B.size)return 0;for(const [x,y] of [['lh','rh'],['fr','rr'],['upper','lower']]){if((A.has(x)&&B.has(y)&&!B.has(x))||(A.has(y)&&B.has(x)&&!B.has(y)))return 0;}let k=0;A.forEach(x=>{if(B.has(x))k++;});return k/Math.max(A.size,B.size);}\nasync function autoTree(){const W=allWC(),L=allLN();\n /* arma o completa la estructura: lo que ya está ligado no se toca; lo nuevo entra bajo su grupo de Plex o en «Sin centro Plex» */\n const nodes=TREE.nodes.length?TREE.nodes:[];let r=nodes.find(n=>!n.parent);if(!r){r={id:uid(),n:'Planta 4',lvl:'planta',parent:null,wc:[],dq:[]};nodes.push(r);}\n const usedW=new Set(nodes.flatMap(n=>n.wc||[])),usedL=new Set(nodes.flatMap(n=>n.dq||[]));\n const group=gr=>{let G=nodes.find(n=>n.parent===r.id&&n.n===(gr||'Sin grupo'));if(!G){G={id:uid(),n:gr||'Sin grupo',lvl:'linea',parent:r.id,wc:[],dq:[]};nodes.push(G);}return G;};\n const orphan=()=>{let G=nodes.find(n=>n.n==='Sin centro Plex'&&n.parent===r.id);if(!G){G={id:uid(),n:'Sin centro Plex',lvl:'linea',parent:r.id,wc:[],dq:[]};nodes.push(G);}return G;};\n Object.entries(W).forEach(([w,gr])=>{if(usedW.has(w))return;const G=group(gr);\n  const oid=nodes.find(x=>x.n==='Sin centro Plex')?.id;let solo=null,sb=.6;nodes.forEach(n=>{if(n.parent!==oid||(n.wc||[]).length)return;const v=Math.max(0,...(n.dq||[]).map(l=>sim(l,w)));if(v>=sb){sb=v;solo=n;}});\n  if(solo){solo.wc=[w];solo.parent=G.id;if(/^[A-Z0-9 ]+$/.test(solo.n))solo.n=w;solo.lvl=/^imm-|prensa/i.test(w)?'maquina':'proceso';}\n  else nodes.push({id:uid(),n:w,lvl:/^imm-|prensa/i.test(w)?'maquina':'proceso',parent:G.id,wc:[w],dq:[]});usedW.add(w);});\n Object.keys(L).forEach(l=>{if(usedL.has(l))return;let best=null,bs=0;nodes.forEach(n=>{if((n.wc||[]).length!==1)return;const v=sim(l,n.wc[0]);if(v>bs){bs=v;best=n;}});\n  if(best&&bs>=.6)(best.dq=best.dq||[]).push(l);else nodes.push({id:uid(),n:l,lvl:'proceso',parent:orphan().id,wc:[],dq:[l]});usedL.add(l);});\n const o=nodes.find(n=>n.n==='Sin centro Plex');\n if(o)nodes.filter(n=>n.parent===o.id&&!(n.wc||[]).length).forEach(n=>{let best=null,bs=.6;nodes.forEach(m=>{if((m.wc||[]).length!==1)return;const v=Math.max(0,...(n.dq||[]).map(l=>sim(l,m.wc[0])));if(v>=bs){bs=v;best=m;}});\n  if(best){best.dq=[...new Set([...(best.dq||[]),...(n.dq||[])])];nodes.forEach(k=>{if(k.parent===n.id)k.parent=best.id;});nodes.splice(nodes.indexOf(n),1);}});\n if(o&&!nodes.some(n=>n.parent===o.id))nodes.splice(nodes.indexOf(o),1);\n TREE={nodes,qual:TREE.qual||'dqmc'};await dSet('oee/r1/cfg/tree',TREE);}\n\n/* ---------- cálculo ---------- */\nconst days=()=>{const o=[];let d=new Date(from+'T00:00:00Z');const e=new Date(to+'T00:00:00Z');while(d<=e&&o.length<800){o.push(d.toISOString().slice(0,10));d=new Date(d.getTime()+864e5);}return o;};\nfunction leafDay(n,day){const mk=day.slice(0,7),dk=day.slice(8),o={ins:0,ng:0,sq:0,sc:0};\n DQMC.forEach(m=>{if(m.m!==mk)return;(n.dq||[]).forEach(l=>{const L=m.ln[l];if(L){o.ins+=L.i[dk]||0;o.ng+=L.ng[dk]||0;}});});\n SCRAP.forEach(m=>{if(m.m!==mk)return;(n.wc||[]).forEach(w=>{const W=m.wc[w];if(W){o.sq+=W.q[dk]||0;o.sc+=W.c[dk]||0;}});});\n const c=CAP[day+'__'+n.id]||{};o.cap=c;return o;}\nfunction calc(n,ds){/* suma propia + hijos; OEE con sumas: tiempo ideal de buenas ÷ tiempo planeado */\n const S={ins:0,ng:0,sq:0,sc:0,plan:0,paro:0,micro:0,rew:0,ideal:0,good:0,prod:0,dPlan:0,days:{},paros:{},cprod:0,cgood:0,cdays:0,tdays:0};\n const add=(nd)=>{ds.forEach(day=>{const x=leafDay(nd,day),c=x.cap,prod=+c.prod>0?+c.prod:x.ins,rej=TREE.qual==='plex'?x.sq:TREE.qual==='ambos'?x.ng+x.sq:x.ng,rew=+c.rew||0,good=Math.max(0,prod-rej-rew);\n   const plan=+c.plan>0?+c.plan:(prod>0&&+nd.plan>0?+nd.plan:0),paro=(c.paros||[]).reduce((a,p)=>a+(+p.m||0),0),micro=+c.micro||0,ideal=+c.ideal>0?+c.ideal:+nd.ideal||0;\n   S.ins+=x.ins;S.ng+=x.ng;S.sq+=x.sq;S.sc+=x.sc;S.prod+=prod;S.good+=good;S.rew+=rew;S.plan+=plan;S.paro+=paro;S.micro+=micro;if(plan>0)S.dPlan++;if(ideal&&plan>0)S.ideal+=ideal*prod/60;if(prod>0)S.tdays++;if(plan>0&&ideal>0){S.cprod+=prod;S.cgood+=good;S.cdays++;}\n   (c.paros||[]).forEach(p=>{S.paros[p.c||'Sin causa']=(S.paros[p.c||'Sin causa']||0)+(+p.m||0);});\n   const D=S.days[day]||(S.days[day]={prod:0,good:0,plan:0,run:0,ideal:0,sc:0,ng:0});D.prod+=prod;D.good+=good;D.plan+=plan;D.run+=Math.max(0,plan-paro);D.ideal+=ideal&&plan>0?ideal*prod/60:0;D.sc+=x.sc;D.ng+=rej;});\n  kids(nd.id).forEach(add);};\n add(n);const run=Math.max(0,S.plan-S.paro);S.A=S.plan>0?run/S.plan:null;S.R=run>0&&S.ideal>0?Math.min(1.5,S.ideal/run):null;S.Q=S.prod>0?S.good/S.prod:null;S.Qc=S.cprod>0?S.cgood/S.cprod:null;S.OEE=S.A!=null&&S.R!=null&&S.Qc!=null?S.A*S.R*S.Qc:null;S.run=run;return S;}\nconst col=v=>v==null?'var(--dim)':v>=.85?'var(--ok)':v>=.65?'var(--warn)':'var(--crit)';\n\n/* ---------- vista ---------- */\nfunction setPeriod(p){const all=[...new Set([...SCRAP.flatMap(m=>Object.values(m.wc).flatMap(w=>Object.keys(w.c).map(d=>m.m+'-'+d))),...DQMC.flatMap(m=>Object.values(m.ln).flatMap(l=>Object.keys(l.i).map(d=>m.m+'-'+d)))])].sort();\n const last=all.length?all[all.length-1]:new Date().toISOString().slice(0,10),first=all.length?all[0]:last,back=n=>new Date(new Date(last+'T00:00:00Z').getTime()-(n-1)*864e5).toISOString().slice(0,10);\n to=last;from=p==='d1'?