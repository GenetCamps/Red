],\n  ['Producción',fmt(S.prod)+' pz',`${fmt(S.good)} buenas`],['NG DQMC',fmt(S.ng)+' pz',S.ins?pc(S.ng/S.ins)+' de lo inspeccionado':''],['Scrap Plex','$'+fmt(S.sc),fmt(S.sq)+' pz']].map(([l,v,s,c])=>`<div class=\"kpi\"><span>${l}</span><b style=\"${c?'color:'+c:''}\">${v}</b><small>${esc(s)}</small></div>`).join('');\n const L=levelNodes().map(n=>({n,S:calc(n,ds)})).filter(o=>o.S.prod||o.S.sc||o.S.plan||!o.n.wc?.length&&!o.n.dq?.length).sort((a,b)=>(a.S.OEE??a.S.Q??2)-(b.S.OEE??b.S.Q??2));\n $('gridTitle').textContent=`${L.length} nodos de nivel ${LEVEL} dentro de ${r.n} · ordenados del peor al mejor`;\n $('grid').innerHTML=L.map(({n,S})=>`<button class=\"card node\" data-go=\"${n.id}\"><div class=\"row\"><b>${esc(n.n)}</b><span class=\"tag\">${esc(n.lvl)}</span></div><div class=\"o\" style=\"color:${col(S.OEE??S.Q)}\">${S.OEE!=null?pc(S.OEE):S.Q!=null?'Cal. '+pc(S.Q):'—'}</div>\n  ${[['Disponibilidad',S.A],['Rendimiento',S.R],['Calidad',S.Q]].map(([k,v])=>`<div class=\"row\"><span class=\"muted\">${k}</span><span>${pc(v)}</span></div><div class=\"bar\"><i style=\"width:${v==null?0:Math.min(100,v*100)}%;background:${col(v)}\"></i></div>`).join('')}\n  <div class=\"row small\"><span>${fmt(S.prod)} pz · NG ${fmt(S.ng)}</span><span>scrap $${fmt(S.sc)}</span></div></button>`).join('')||'<div class=\"card muted\">Sin nodos de este nivel aquí. Cambia el nivel o arma la estructura.</div>';\n trend(S);loss(S);paretos(r,ds);}\nfunction trend(S){const ds=Object.keys(S.days).sort();if(!ds.length){$('trend').innerHTML='<p class=\"muted small\">Sin datos en el periodo.</p>';return;}\n const W=640,H=200,px=40,py=16,pw=W-px-10,ph=H-py-28,X=i=>px+(ds.length<2?pw/2:i/(ds.length-1)*pw),Y=v=>py+ph-(Math.max(0,Math.min(1,v)))*ph;\n const ser=(f,c,dash)=>{const pts=ds.map((d,i)=>{const v=f(S.days[d]);return v==null?null:[X(i),Y(v)];});let p='',on=false;pts.forEach(q=>{if(!q){on=false;return;}p+=(on?'L':'M')+q[0].toFixed(1)+' '+q[1].toFixed(1);on=true;});return `<path d=\"${p}\" fill=\