\" style=\"margin:8px 0 4px\"><b>Paros por causa</b></p>`+paros.map(([k,v])=>`<div class=\"row small\"><span>${esc(k)}</span><span>${fmt(v)} min</span></div>`).join(''):'');}\nfunction paretos(r,ds){const sr={},df={},set=new Set(ds);const each=n=>{(n.wc||[]).forEach(w=>SCRAP.forEach(m=>{const W=m.wc[w];if(!W)return;const any=Object.keys(W.c).some(d=>set.has(m.m+'-'+d));if(!any)return;const share=Object.entries(W.c).reduce((a,[d,c])=>a+(set.has(m.m+'-'+d)?c:0),0)/Math.max(1e-9,Object.values(W.c).reduce((a,b)=>a+b,0));Object.entries(W.r).forEach(([k,[q,c]])=>{sr[k]=(sr[k]||0)+c*share;});}));\n  (n.dq||[]).forEach(l=>DQMC.forEach(m=>{const L=m.ln[l];if(!L)return;const tot=Object.values(L.ng).reduce((a,b)=>a+b,0),inP=Object.entries(L.ng).reduce((a,[d,v])=>a+(set.has(m.m+'-'+d)?v:0),0),share=tot?inP/tot:0;Object.entries(L.df).forEach(([k,v])=>{df[k]=(df[k]||0)+v*share;});}));kids(n.id).forEach(each);};each(r);\n const bars=(o,f,unit)=>{const e=Object.entries(o).filter(x=>x[1]>.5).sort((a,b)=>b[1]-a[1]).slice(0,10);if(!e.length)return '<p class=\"small muted\">Sin datos en el periodo.</p>';const mx=e[0][1],tot=Object.values(o).reduce((a,b)=>a+b,0);let acc=0;\n  return e.map(([k,v])=>{acc+=v;return `<div class=\"row small\"><span title=\"${esc(k)}\">${esc(k.length>46?k.slice(0,45)+'…':k)}</span><span>${f(v)} · ${fmt(acc/tot*100,0)}% acum.</span></div><div class=\"bar\"><i style=\"width:${v/mx*100}%;background:var(--warn)\"></i></div>`;}).join('');};\n $('parS').innerHTML=bars(sr,v=>'$'+fmt(v));$('parD').innerHTML=bars(df,v=>fmt(v)+' pz');}\n\n/* ---------- captura del día ---------- */\nfunction capPane(){const r=CUR?node(CUR):root(),ds=to||new Date().toISOString().slice(0,10),opts=TREE.nodes.map(n=>`<option value=\"${n.id}\"${r&&n.id===r.id?' selected':''}>${'· '.repeat(depth(n))}${esc(n.n)}</option>`).join('');\n $('panes').innerHTML=`<div class=\"pane\"><h2>Captura del día</h2><div class=\"form\"><label>Fecha<input type=\"date\" id=\"cD\" value=\"${ds}\"></label><label>Nodo<select id=\"cN\">${opts}</select></label></div><div id=\"cBody\"></div>\n  <div class=\"top\" style=\"margin-top:10px\"><button class=\"b prim\" id=\"cSave\"${RO?' disabled':''}>Guardar captura</button><button class=\"b\" id=\"cX\">Cerrar</button><span class=\"small muted\">Producción e inspección vienen de DQMC; aquí solo lo que no viene en ningún Excel.</span></div></div>`;\n const fill=()=>{const c=CAP[$('cD').value+'__'+$('cN').value]||{},n=node($('cN').value)||{},P=(c.paros||[]).concat([{c:'',m:''}]);\n  $('cBody').innerHTML=`<div class=\"form\" style=\"margin-top:8px\"><label>Tiempo planeado (min)<input id=\"cP\" type=\"number\" min=\"0\" value=\"${c.plan??''}\" placeholder=\"${n.plan?'base '+n.plan:'ej. 645'}\"></label><label>Microparos (min)<input id=\"cM\" type=\"number\" min=\"0\" value=\"${c.micro??''}\"></label><label>Retrabajo (pz)<input id=\"cR\" type=\"number\" min=\"0\" value=\"${c.rew??''}\"></label><label>Producción (pz, si no viene de DQMC)<input id=\"cQ\" type=\"number\" min=\"0\" value=\"${c.prod??''}\"></label><label>Ciclo ideal (s/pz)<input id=\"cI\" type=\"number\" min=\"0\" step=\"0.1\" value=\"${c.ideal??''}\" placeholder=\"${n.ideal?'base '+n.ideal:'del yamazumi o estándar'}\"></label></div>\n   <p class=\"small muted\" style=\"margin:10px 0 4px\">Paros del día (causa y minutos)</p><div id=\"cParos\">${P.map((p,i)=>`<div class=\"form\" style=\"grid-template-columns:2fr 1fr;margin-bottom:4px\"><input data-pc=\"${i}\" value=\"${esc(p.c)}\" placeholder=\"Falta de material, cambio de modelo, falla…\" aria-label=\"Causa del paro ${i+1}\"><input data-pm=\"${i}\" type=\"number\" min=\"0\" value=\"${p.m}\" placeholder=\"min\" aria-label=\"Minutos del paro ${i+1}\"></div>`).join('')}</div>`;};\n fill();$('cD').onchange=fill;$('cN').onchange=fill;$('cX').onclick=()=>{$('panes').innerHTML='';};\n $('cBody').addEventListener('input',e=>{if(e.target.dataset.pc!==undefined||e.target.dataset.pm!==undefined){const rows=$('cParos').children,last=rows[rows.length-1];if([...last.querySelectorAll('input')].some(i=>i.value)){last.insertAdjacentHTML('afterend',last.outerHTML.replace(/data-pc=\"\\d+\"/,`data-pc=\"${rows.length}\"`).replace(/data-pm=\"\\d+\"/,`data-pm=\"${rows.length}\"`).replace(/value=\"[^\"]*\"/g,'value=\"\"'));}}});\n $('cSave').onclick=async()=>{const num=id=>{const v=$(id).value.trim();return v===''?undefined:+v;},paros=[...$('cParos').children].map(r=>({c:r.querySelector('[data-pc]').value.trim(),m:+r.querySelector('[data-pm]').value||0})).filter(p=>p.m>0||p.c);\n  const c={plan:num('cP'),micro:num('cM'),rew:num('cR'),prod:num('cQ'),ideal:num('cI'),paros,at:Date.now()};Object.keys(c).forEach(k=>c[k]===undefined&&delete c[k]);const id=$('cD').value+'__'+$('cN').value;\n  try{await dSet('oee/r1/cap/'+id,c);CAP[id]=c;toast('Captura guardada');render();}catch(e){toast(e&&e.code==='solo-lectura'?'Tu usuario es de solo lectura.':'No se pudo guardar.');}};}\nconst depth=n=>{let d=0,x=n;while(x&&x.parent){d++;x=node(x.parent);}return d;};\n\n\n/* ---------- cajas del VSM (consolas de P4 y Parras) para ligar nodos ---------- */\nlet VBOX=null;\nfunction grab(src,name){const i=src.indexOf('const '+name+'=');if(i<0)return null;let j=i+name.length+7,d=0,q=null;const s=j;for(;j<src.length;j++){const c=src[j];if(q){if(c==='\\\\')j++;else if(c===q)q=null;continue;}if(c==='\"'||c===\"'\"||c==='`'){q=c;continue;}if(c==='{'||c==='[')d++;else if(c==='}'||c===']'){d--;if(!d){j++;break;}}}return src.slice(s,j);}\nasync function vsmBoxes(){if(VBOX)return VBOX;const out=[];\n try{const src=await(await fetch('vsm/consola.json')).json(),S=new Function('C','HEAD','return '+grab(src,'STREAMS'))(new Proxy({},{get:()=>''}),'');\n  Object.entries(S).forEach(([k,st])=>(st.procs||[]).forEach(p=>out.push({key:`vx|${k}|${p.id}`,g:`P4 · ${st.name} ${st.prod||''}`.trim(),n:(p.n||[]).join(' ')})));}catch(e){console.warn('cajas P4',e);}\n try{const src=await(await fetch('vsm/parras.json')).json(),A=JSON.parse(grab(src,'ALLP'));Object.entries(A).forEach(([id,p])=>{if(p.k==='jct')return;out.push({key:`vp|*|${id}`,g:'Parras',n:(p.n||[]).join(' ')});});}catch(e){console.warn('cajas Parras',e);}\n for(const [c,pre] of [['vx','vx/r2/'],['vp','vp/r1/']]){try{const L=await dGet(pre+'cfg/layout');if(L&&L.L)Object.entries(L.L).forEach(([k,v])=>(v.add||[]).forEach(a=>out.push({key:c==='vp'?`vp|*|${a.id}`:`vx|${k.split('|')[0]}|${a.id}`,g:(c==='vp'?'Parras':'P4 · '+k.split('|')[0])+' · agregadas',n:a.n1||a.id})));}catch(e){}}\n VBOX=out;return out;}\nasync function sendVsm(){const ds=days(),b={};let n=0;TREE.nodes.forEach(nd=>{if(!nd.vsm)return;const S=calc(nd,ds);b[nd.vsm]={o:S.OEE,a:S.A,r:S.R,q:S.Q,prod:S.prod,ng:S.ng,sc:Math.round(S.sc),sq:Math.round(S.sq),n:nd.n};n++;});\n if(!n){toast('Ningún nodo está ligado a una caja del VSM. Lígalos en Estructura.');return;}\n try{await dSet('oee/r1/vsm/summary',{from,to,at:Date.now(),b});toast(`${n} cajas del VSM actualizadas con el OEE del ${from} al ${to}. En la consola enciende la capa «OEE».`,8000);}catch(e){toast(e&&e.code==='solo-lectura'?'Tu usuario es de solo lectura.':'No se pudo mandar al VSM.');}}\n\n/* ---------- estructura ---------- */\nlet TSEL=null;\nfunction treePane(){const W=Object.keys(allWC()).sort(),Lq=Object.keys(allLN()).sort(),used=k=>new Set(TREE.nodes.flatMap(n=>n[k]||[])),uW=used('wc'),uL=used('dq');\n const order=[];const walk=(id,d)=>{TREE.nodes.filter(n=>(n.parent||null)===id).forEach(n=>{order.push([n,d]);walk(n.id,d+1);});};walk(null,0);const s=node(TSEL)||order[0]?.[0];TSEL=s?.id;\n $('panes').innerHTML=`<div class=\"pane\"><h2>Estructura · de la planta a la máquina</h2><div class=\"two\"><div><div class=\"tree\">${order.map(([n,d])=>`<div class=\"tn${n.id===TSEL?' on':''}\" data-t=\"${n.id}\" style=\"margin-left:${d*16}px;cursor:pointer\"><span>${esc(n.n)} <span class=\"tag\">${n.lvl}</span></span><span class=\"small muted\">${(n.wc||[]).length} Plex · ${(n.dq||[]).length} DQMC</span></div>`).join('')}</div>\n  <div class=\"top\" style=\"margin-top:8px\">${RO?'':'<button class=\"b\" id=\"tAdd\">Agregar hijo</button><button class=\"b\" id=\"tDel\">Eliminar nodo</button><button class=\"b\" id=\"tAuto\">Rearmar desde los datos</button>'}<button class=\"b\" id=\"tX\">Cerrar</button></div></div>\n  ${s?`<div><div class=\"form\"><label>Nombre<input id=\"tN\" value=\"${esc(s.n)}\"></label><label>Nivel<select id=\"tL\">${['planta','linea','proceso','maquina'].map(l=>`<option${l===s.lvl?' selected':''}>${l}</option>`).join('')}</select></label>\n   <label>Depende de<select id=\"tP\"><option value=\"\">(raíz)</option>${TREE.nodes.filter(n=>n.id!==s.id).map(n=>`<option value=\"${n.id}\"${n.id===s.parent?' selected':''}>${esc(n.n)}</option>`).join('')}</select></label>\n   <label>Tiempo planeado base (min/día)<input id=\"tPl\" type=\"number\" min=\"0\" value=\"${s.plan??''}\"></label><label>Ciclo ideal base (s/pz)<input id=\"tI\" type=\"number\" min=\"0\" step=\"0.1\" value=\"${s.ideal??''}\"></label>\n   <label>Caja del VSM<select id=\"tV\"><option value=\"\">Sin ligar</option>${s.vsm?`<option value=\"${esc(s.vsm)}\" selected>${esc(s.vsm)}</option>`:''}</select></label></div>\n   <p class=\"small muted\" style=\"margin:10px 0 4px\">Centros de trabajo de Plex que alimentan este nodo (scrap)</p><div class=\"chips\">${W.map(w=>`<span class=\"chip${(s.wc||[]).includes(w)?' on':''}\" data-w=\"${esc(w)}\" role=\"button\" tabindex=\"0\" style=\"${!(s.wc||[]).includes(w)&&uW.has(w)?'opacity:.55':''}\">${esc(w)}</span>`).join('')||'<span class=\"small muted\">Importa el scrap de Plex.</span>'}</div>\n   <p class=\"small muted\" style=\"margin:10px 0 4px\">Líneas de DQMC que alimentan este nodo (producción y rechazos)</p><div class=\"chips\">${Lq.map(l=>`<span class=\"chip${(s.dq||[]).includes(l)?' on':''}\" data-l=\"${esc(l)}\" role=\"button\" tabindex=\"0\" style=\"${!(s.dq||[]).includes(l)&&uL.has(l)?'opacity:.55':''}\">${esc(l)}</span>`).join('')||'<span class=\"small muted\">Importa el Excel de DQMC.</span>'}</div>\n   <p class=\"small muted\" style=\"margin:10px 0 4px\">Calidad del OEE con</p><div class=\"seg\" id=\"tQ\">${[['dqmc','NG de DQMC'],['plex','Scrap Plex'],['ambos','Ambos']].map(([k,t])=>`<button data-q=\"${k}\" class=\"${TREE.qual===k?'on':''}\">${t}</button>`).join('')}</div>\n   <p class=\"small muted\">Los atenuados ya están ligados a otro nodo. Un padre suma lo de sus hijos más lo suyo.</p></div>`:''}</div></div>`;\n const save=async()=>{try{await dSet('oee/r1/cfg/tree',TREE);}catch(e){toast('No se pudo guardar la estructura.');}render();treePane();};\n $('panes').onclick=async e=>{const t=e.target.closest('[data-t]'),w=e.target.closest('[data-w]'),l=e.target.closest('[data-l]'),q=e.target.closest('[data-q]');\n  if(t){TSEL=t.dataset.t;treePane();return;}if(RO)return;\n  if(w&&s){const a=s.wc=s.wc||[],i=a.indexOf(w.dataset.w);i<0?a.push(w.dataset.w):a.splice(i,1);return save();}\n  if(l&&s){const a=s.dq=s.dq||[],i=a.indexOf(l.dataset.l);i<0?a.push(l.dataset.l):a.splice(i,1);return save();}\n  if(q){TREE.qual=q.dataset.q;return save();}\n  const id=e.target.id;if(id==='tX'){$('panes').innerHTML='';return;}\n  if(id==='tAdd'){const n={id:uid(),n:'Nuevo',lvl:s?.lvl==='planta'?'linea':s?.lvl==='linea'?'proceso':'maquina',parent:s?s.id:null,wc:[],dq:[]};TREE.nodes.push(n);TSEL=n.id;return save();}\n  if(id==='tDel'&&s){if(!confirm(`¿Eliminar «${s.n}»? Sus hijos pasan a depender de su padre.`))return;TREE.nodes.forEach(n=>{if(n.parent===s.id)n.parent=s.parent;});TREE.nodes=TREE.nodes.filter(n=>n!==s);TSEL=null;if(CUR===s.id)CUR=null;return save();}\n  if(id==='tAuto'){if(!confirm('¿Rearmar la estructura desde los datos importados? Se pierde la estructura actual.'))return;TREE={nodes:[],qual:TREE.qual};await autoTree();TSEL=null;CUR=null;render();treePane();}};\n $('panes').onchange=e=>{if(!s||RO)return;const id=e.target.id,v=e.target.value;if(id==='tN')s.n=v.trim()||s.n;else if(id==='tL')s.lvl=v;else if(id==='tP'){let x=node(v);while(x){if(x.id===s.id){toast('Eso haría un ciclo.');return treePane();}x=x.parent?node(x.parent):null;}s.parent=v||null;}else if(id==='tPl')s.plan=v===''?null:+v;else if(id==='tI')s.ideal=v===''?null:+v;else if(id==='tV')s.vsm=v||null;else return;save();};\n vsmBoxes().then(L=>{const sel=$('tV');if(!sel||!s)return;const used=new Set(TREE.nodes.filter(n=>n.vsm&&n!==s).map(n=>n.vsm)),grp={};L.forEach(x=>{(grp[x.g]=grp[x.g]||[]).push(x);});\n  sel.innerHTML='<option value=\"\">Sin ligar</option>'+Object.entries(grp).map(([g,xs])=>`<optgroup label=\"${esc(g)}\">${xs.map(x=>`<option value=\"${esc(x.key)}\"${x.key===s.vsm?' selected':''}>${esc(x.n)}${used.has(x.key)?' (ya ligada)':''}</option>`).join('')}</optgroup>`).join('');});}\n\n/* ---------- eventos ---------- */\n$('per').onclick=e=>{const b=e.target.closest('button');if(b){setPeriod(b.dataset.p);render();}};\n$('dFrom').onchange=$('dTo').onchange=()=>{from=$('dFrom').value||from;to=$('dTo').value||to;if(from>to)[from,to]=[to,from];document.querySelectorAll('#per button').forEach(b=>b.classList.remove('on'));render();};\n$('lvl').onclick=e=>{const b=e.target.closest('button');if(b){LEVEL=b.dataset.l;render();}};\ndocument.addEventListener('click',e=>{const g=e.target.closest('[data-go]');if(g&&!e.target.closest('#panes')){CUR=g.dataset.go===root()?.id?null:g.dataset.go;const n=node(g.dataset.go),order=['planta','linea','proceso','maquina'];if(n){const i=order.indexOf(n.lvl);if(order.indexOf(LEVEL)<=i)LEVEL=order[Math.min(3,i+1)];}render();}});\nlet impKind=null;$('bImpD').onclick=()=>{impKind='dqmc';$('fImp').click();};$('bImpS').onclick=()=>{impKind='plex';$('fImp').click();};\n$('fImp').onchange=async e=>{const f=e.target.files[0];e.target.value='';if(!f)return;toast('Leyendo '+f.name+'…',60000);\n try{const msg=impKind==='dqmc'?await importDqmc(f):await importPlex(f);await load();await autoTree();setPeriod('all');render();toast(msg,7000);}catch(err){toast('No se pudo importar: '+(err.message||err),9000);}};\n$('bCap').onclick=()=>{if(!TREE.nodes.length){toast('Primero importa los datos para armar la estructura.');return;}capPane();};\n$('bTree').onclick=()=>{TSEL=CUR;treePane();};\n$('bVsm').onclick=()=>sendVsm();if(RO)$('bVsm').hidden=true;\nif(RO){['bImpD','bImpS'].forEach(i=>$(i).hidden=true);}\nlet theme='dark';try{theme=localStorage.getItem('rd_oee_theme')||'dark';}catch(e){}\nconst setTheme=t=>{theme=t;document.documentElement.dataset.theme=t;$('bTheme').textContent=t==='dark'?'☀ Fondo blanco':'☾ Fondo oscuro';try{localStorage.setItem('rd_oee_theme',t);}catch(e){}try{parent.postMessage({src:'emb',type:'theme',v:t},'*');}catch(e){}};\n$('bTheme').onclick=()=>setTheme(theme==='dark'?'light':'dark');setTheme(theme);\n$('plant').innerHTML='<option value=\"p4\">Planta 4</option>';$('plant').disabled=true;\nawait load();setPeriod('d30');render();\nwindow.__oee={calc:(id)=>calc(node(id)||root(),days()),state:()=>({nodes:TREE.nodes.length,scrap:SCRAP.map(m=>m.m),dqmc:DQMC.map(m=>m.m),from,to,LEVEL,CUR}),importPlex,importDqmc,load,render,autoTree,setPeriod,tree:()=>TREE};\n})();\n</script></body></html>\n"